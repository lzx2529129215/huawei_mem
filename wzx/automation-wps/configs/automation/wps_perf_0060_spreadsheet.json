{
  "description": "Perf_WPS_0060 Excel：过滤、排序、复制/插入列、公式填充、新建工作表、字体修改、滚动及首尾单元格跳转。过滤菜单快捷键可能随 WPS 语言变化，可通过 --var 覆盖。",
  "variables": {
    "WPS_EXCEL_FILE": "${PROJECT_ROOT}/samples/wps/spreadsheet_200m.xlsx",
    "WPS_IMAGE_FILE": "${PROJECT_ROOT}/samples/wps/image_1m.png",
    "EXCEL_NUMERIC_HEADER": "B1",
    "EXCEL_TEXT_HEADER": "C1",
    "EXCEL_FILTER_NUMBER_MENU_KEY": "f",
    "EXCEL_FILTER_GREATER_EQUAL_KEY": "g",
    "EXCEL_FILTER_TEXT_MENU_KEY": "f",
    "EXCEL_FILTER_CONTAINS_KEY": "c",
    "EXCEL_FILTER_NUMBER": "0",
    "EXCEL_FILTER_KEYWORD": "key",
    "EXCEL_COPIED_COLUMN": "J1",
    "EXCEL_FORMULA_HEADER": "K1",
    "EXCEL_FORMULA_FIRST_CELL": "K2",
    "EXCEL_FORMULA_RANGE": "K2:K1000",
    "EXCEL_SUM_FORMULA": "=A2+B2",
    "EXCEL_FONT_NAME": "HarmonyOS Sans SC",
    "EXCEL_FONT_NAME_X": "0.40",
    "EXCEL_FONT_NAME_Y": "0.12",
    "EXCEL_FONT_SIZE_X": "0.51",
    "EXCEL_FONT_SIZE_Y": "0.12",
    "WPS_EXCEL_LOAD_SECONDS": "20"
  },
  "actions": [
    {"type": "assert_file", "path": "${WPS_EXCEL_FILE}", "label": "WPS_REQUIRE_EXCEL_SAMPLE"},
    {"type": "assert_file", "path": "${WPS_IMAGE_FILE}", "label": "WPS_REQUIRE_IMAGE_SAMPLE"},
    {"type": "launch", "name": "et", "command": "et", "label": "WPS_EXCEL_LAUNCH"},
    {"type": "wait_window", "name": "wps", "class": "et|wps|wpsoffice", "timeout": 20},
    {"type": "window_state", "name": "wps", "class": "et|wps|wpsoffice", "state": "maximize"},
    {"type": "open_file", "name": "wps", "class": "et|wps|wpsoffice", "path": "${WPS_EXCEL_FILE}", "wait_after": "${WPS_EXCEL_LOAD_SECONDS}", "label": "WPS_EXCEL_OPEN"},

    {"type": "goto_cell", "reference": "${EXCEL_NUMERIC_HEADER}", "label": "WPS_EXCEL_NUMERIC_HEADER"},
    {"type": "key", "key": "ctrl+shift+l", "name": "wps", "label": "WPS_EXCEL_FILTER_ENABLE"},
    {"type": "key", "key": "alt+Down", "name": "wps", "label": "WPS_EXCEL_NUMERIC_FILTER_OPEN"},
    {"type": "key", "key": "${EXCEL_FILTER_NUMBER_MENU_KEY}", "name": "wps"},
    {"type": "key", "key": "${EXCEL_FILTER_GREATER_EQUAL_KEY}", "name": "wps"},
    {"type": "paste_text", "text": "${EXCEL_FILTER_NUMBER}", "name": "wps", "label": "WPS_EXCEL_NUMERIC_FILTER_VALUE"},
    {"type": "key", "key": "Return", "name": "wps", "label": "WPS_EXCEL_NUMERIC_FILTER_APPLY"},
    {"type": "wait", "seconds": 3},
    {"type": "key", "key": "ctrl+shift+l", "name": "wps", "label": "WPS_EXCEL_NUMERIC_FILTER_CANCEL"},

    {"type": "goto_cell", "reference": "${EXCEL_TEXT_HEADER}", "label": "WPS_EXCEL_TEXT_HEADER"},
    {"type": "key", "key": "ctrl+shift+l", "name": "wps"},
    {"type": "key", "key": "alt+Down", "name": "wps", "label": "WPS_EXCEL_TEXT_FILTER_OPEN"},
    {"type": "key", "key": "${EXCEL_FILTER_TEXT_MENU_KEY}", "name": "wps"},
    {"type": "key", "key": "${EXCEL_FILTER_CONTAINS_KEY}", "name": "wps"},
    {"type": "paste_text", "text": "${EXCEL_FILTER_KEYWORD}", "name": "wps", "label": "WPS_EXCEL_TEXT_FILTER_VALUE"},
    {"type": "key", "key": "Return", "name": "wps", "label": "WPS_EXCEL_TEXT_FILTER_APPLY"},
    {"type": "wait", "seconds": 3},
    {"type": "key", "key": "ctrl+shift+l", "name": "wps", "label": "WPS_EXCEL_TEXT_FILTER_CANCEL"},

    {"type": "goto_cell", "reference": "${EXCEL_NUMERIC_HEADER}", "label": "WPS_EXCEL_SORT_COLUMN"},
    {"type": "key", "key": "ctrl+space", "name": "wps"},
    {"type": "key", "key": "alt+a", "name": "wps"},
    {"type": "key", "key": "s", "name": "wps"},
    {"type": "key", "key": "a", "name": "wps", "label": "WPS_EXCEL_SORT_ASCENDING"},
    {"type": "wait", "seconds": 3},

    {"type": "goto_cell", "reference": "${EXCEL_COPIED_COLUMN}", "label": "WPS_EXCEL_COLUMN_10"},
    {"type": "key", "key": "ctrl+space", "name": "wps"},
    {"type": "key", "key": "ctrl+c", "name": "wps"},
    {"type": "key", "key": "ctrl+plus", "name": "wps", "label": "WPS_EXCEL_INSERT_COPIED_COLUMN"},

    {"type": "goto_cell", "reference": "${EXCEL_FORMULA_HEADER}", "label": "WPS_EXCEL_NEW_BLANK_COLUMN"},
    {"type": "key", "key": "ctrl+space", "name": "wps"},
    {"type": "key", "key": "ctrl+plus", "name": "wps"},
    {"type": "paste_text", "text": "两列之和", "name": "wps"},
    {"type": "goto_cell", "reference": "${EXCEL_FORMULA_FIRST_CELL}"},
    {"type": "paste_text", "text": "${EXCEL_SUM_FORMULA}", "name": "wps", "label": "WPS_EXCEL_SUM_FORMULA"},
    {"type": "goto_cell", "reference": "${EXCEL_FORMULA_RANGE}"},
    {"type": "key", "key": "ctrl+d", "name": "wps", "label": "WPS_EXCEL_FORMULA_FILL_DOWN"},
    {"type": "key", "key": "ctrl+s", "name": "wps", "label": "WPS_EXCEL_SAVE_1"},

    {"type": "key", "key": "shift+F11", "name": "wps", "label": "WPS_EXCEL_NEW_SHEET"},
    {"type": "key", "key": "ctrl+Page_Up", "name": "wps"},
    {"type": "key", "key": "ctrl+a", "repeat": 2, "name": "wps", "label": "WPS_EXCEL_SELECT_ORIGINAL_SHEET"},
    {"type": "key", "key": "ctrl+c", "name": "wps"},
    {"type": "key", "key": "ctrl+Page_Down", "name": "wps"},
    {"type": "key", "key": "ctrl+v", "name": "wps", "label": "WPS_EXCEL_COPY_TO_NEW_SHEET"},
    {"type": "key", "key": "ctrl+a", "repeat": 2, "name": "wps"},
    {"type": "click_window", "name": "wps", "class": "et|wps|wpsoffice", "x_ratio": "${EXCEL_FONT_NAME_X}", "y_ratio": "${EXCEL_FONT_NAME_Y}", "label": "WPS_EXCEL_FONT_NAME_BOX"},
    {"type": "key", "key": "ctrl+a", "name": "wps"},
    {"type": "paste_text", "text": "${EXCEL_FONT_NAME}", "name": "wps"},
    {"type": "key", "key": "Return", "name": "wps"},
    {"type": "click_window", "name": "wps", "class": "et|wps|wpsoffice", "x_ratio": "${EXCEL_FONT_SIZE_X}", "y_ratio": "${EXCEL_FONT_SIZE_Y}", "label": "WPS_EXCEL_FONT_SIZE_BOX"},
    {"type": "key", "key": "ctrl+a", "name": "wps"},
    {"type": "paste_text", "text": "14", "name": "wps"},
    {"type": "key", "key": "Return", "name": "wps", "label": "WPS_EXCEL_FONT_APPLY"},
    {"type": "key", "key": "ctrl+s", "name": "wps", "label": "WPS_EXCEL_SAVE_2"},

    {"type": "scroll", "name": "wps", "class": "et|wps|wpsoffice", "direction": "down", "amount": 3, "label": "WPS_EXCEL_SCROLL_DOWN"},
    {"type": "scroll", "name": "wps", "class": "et|wps|wpsoffice", "direction": "up", "amount": 3, "label": "WPS_EXCEL_SCROLL_UP"},
    {"type": "key", "key": "ctrl+End", "name": "wps", "label": "WPS_EXCEL_LAST_CELL"},
    {"type": "key", "key": "ctrl+Home", "name": "wps", "label": "WPS_EXCEL_FIRST_CELL"},
    {"type": "window_state", "name": "wps", "class": "et|wps|wpsoffice", "state": "maximize", "label": "WPS_MAXIMIZE"},
    {"type": "wait", "seconds": 10},
    {"type": "key", "key": "ctrl+w", "name": "wps", "label": "WPS_EXCEL_TAB_CLOSE"},
    {"type": "close", "name": "et", "class": "et|wps|wpsoffice", "process_names": ["wpsoffice", "wps", "wpp", "et", "wpspdf"], "path_contains": ["/opt/kingsoft/wps-office"], "force_after_seconds": 3, "label": "WPS_CLOSE"}
  ]
}
