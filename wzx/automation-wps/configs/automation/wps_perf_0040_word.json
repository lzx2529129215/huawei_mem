{
  "description": "Perf_WPS_0040 Word 文档：打开、复制粘贴、图片和网页内容粘贴、翻页、搜索、保存及另存为。",
  "variables": {
    "WPS_WORD_FILE": "${PROJECT_ROOT}/samples/wps/word_200m.docx",
    "WPS_IMAGE_FILE": "${PROJECT_ROOT}/samples/wps/image_1m.png",
    "WPS_WORD_SAVE_AS_OUTPUT": "${PROJECT_ROOT}/outputs/wps/word_saved_as.docx",
    "WPS_WORD_SEARCH_KEY": "测试",
    "WPS_WEB_URL": "https://developer.huawei.com/consumer/cn/doc/50129-01",
    "WPS_WORD_LOAD_SECONDS": "20",
    "WPS_NAVIGATION_X": "0.12",
    "WPS_NAVIGATION_Y": "0.55"
  },
  "actions": [
    {"type": "assert_file", "path": "${WPS_WORD_FILE}", "label": "WPS_REQUIRE_WORD_SAMPLE"},
    {"type": "assert_file", "path": "${WPS_IMAGE_FILE}", "label": "WPS_REQUIRE_IMAGE_SAMPLE"},
    {"type": "launch", "name": "wps", "command": "wps", "label": "WPS_LAUNCH"},
    {"type": "wait_window", "name": "wps", "class": "wps|wpsoffice", "timeout": 20},
    {"type": "window_state", "name": "wps", "class": "wps|wpsoffice", "state": "maximize"},
    {"type": "open_file", "name": "wps", "class": "wps|wpsoffice", "path": "${WPS_WORD_FILE}", "wait_after": "${WPS_WORD_LOAD_SECONDS}", "label": "WPS_WORD_OPEN"},

    {"type": "key", "key": "ctrl+Home", "name": "wps"},
    {"type": "key", "key": "ctrl+shift+Down", "name": "wps", "label": "WPS_WORD_SELECT_FIRST_PARAGRAPH"},
    {"type": "key", "key": "ctrl+c", "name": "wps", "label": "WPS_WORD_COPY_PARAGRAPH"},
    {"type": "key", "key": "ctrl+v", "name": "wps", "label": "WPS_WORD_PASTE_PARAGRAPH"},
    {"type": "clipboard_file", "path": "${WPS_IMAGE_FILE}", "label": "WPS_COPY_IMAGE"},
    {"type": "key", "key": "ctrl+v", "name": "wps", "label": "WPS_WORD_PASTE_IMAGE"},
    {"type": "key", "key": "ctrl+s", "name": "wps", "label": "WPS_WORD_SAVE_1"},
    {"type": "wait", "seconds": 3},

    {"type": "shell", "name": "firefox", "command": "mkdir -p \"$HOME/firefox_profiles/automation\" && env -u WAYLAND_DISPLAY MOZ_ENABLE_WAYLAND=0 GDK_BACKEND=x11 firefox --new-instance --no-remote -profile \"$HOME/firefox_profiles/automation\" --new-window \"${WPS_WEB_URL}\"", "label": "FIREFOX_OPEN_WPS_URL"},
    {"type": "wait_window", "name": "firefox", "class": "firefox|Firefox", "title": "Firefox", "timeout": 30, "label": "FIREFOX_WAIT_PAGE"},
    {"type": "focus", "name": "firefox", "class": "firefox|Firefox", "title": "Firefox"},
    {"type": "wait", "seconds": 8},
    {"type": "key", "key": "ctrl+a", "name": "firefox", "label": "FIREFOX_SELECT_ALL"},
    {"type": "key", "key": "ctrl+c", "name": "firefox", "label": "FIREFOX_COPY_PAGE"},
    {"type": "switch", "name": "wps", "class": "wps|wpsoffice", "label": "APP_SWITCH_WPS"},
    {"type": "key", "key": "ctrl+v", "name": "wps", "label": "WPS_WORD_PASTE_WEB_PAGE"},
    {"type": "key", "key": "ctrl+s", "name": "wps", "label": "WPS_WORD_SAVE_2"},

    {"type": "scroll", "name": "wps", "class": "wps|wpsoffice", "direction": "down", "amount": 3, "label": "WPS_WORD_SCROLL_DOWN"},
    {"type": "scroll", "name": "wps", "class": "wps|wpsoffice", "direction": "up", "amount": 3, "label": "WPS_WORD_SCROLL_UP"},
    {"type": "key", "key": "ctrl+f", "name": "wps", "label": "WPS_WORD_OPEN_NAVIGATION_SEARCH"},
    {"type": "paste_text", "text": "${WPS_WORD_SEARCH_KEY}", "name": "wps", "label": "WPS_WORD_SEARCH_TEXT"},
    {"type": "key", "key": "Return", "name": "wps", "label": "WPS_WORD_SEARCH_NEXT"},
    {"type": "wait", "seconds": 2},
    {"type": "save_as", "name": "wps", "class": "wps|wpsoffice", "path": "${WPS_WORD_SAVE_AS_OUTPUT}", "confirm_count": 2, "wait_after": 4, "label": "WPS_WORD_SAVE_AS"},
    {"type": "click_window", "name": "wps", "class": "wps|wpsoffice", "x_ratio": "${WPS_NAVIGATION_X}", "y_ratio": "${WPS_NAVIGATION_Y}", "label": "WPS_WORD_NAVIGATION_FOCUS"},
    {"type": "key", "key": "ctrl+End", "name": "wps", "label": "WPS_WORD_NAVIGATION_LAST_CHAPTER"},
    {"type": "wait", "seconds": 3},
    {"type": "key", "key": "ctrl+w", "name": "wps", "label": "WPS_WORD_TAB_CLOSE"},
    {"type": "window_state", "name": "wps", "class": "wps|wpsoffice", "state": "minimize", "label": "WPS_MINIMIZE"},
    {"type": "close", "name": "firefox", "class": "firefox|Firefox", "cmdline_contains": ["${HOME}/firefox_profiles/automation"], "force_after_seconds": 3, "optional": true, "label": "FIREFOX_CLOSE"},
    {"type": "close", "name": "wps", "class": "wps|wpsoffice", "process_names": ["wpsoffice", "wps", "wpp", "et", "wpspdf"], "path_contains": ["/opt/kingsoft/wps-office"], "force_after_seconds": 3, "label": "WPS_CLOSE"}
  ]
}
