+#endif /* _MM_MYSELF_KSWAPD_OBSERVER_H */
--- /dev/null
+++ b/mm/myself_kswapd/adapter/kswapd_observer.c
@@ -0,0 +1,239 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/atomic.h>
+#include <linux/overflow.h>
+#include <linux/timekeeping.h>
+#include <trace/events/myself_kswapd.h>
+
+#include "../include/kswapd_observer.h"
+
+// #lzx: myself-kswapd L0.1 observe-only code
+// #lzx--------------------------- 观察器实现 ---------------------------
+static atomic64_t myks_request_seq = ATOMIC64_INIT(0);
+
+bool myks_kswapd_events_enabled(void)
+{
+	return trace_myself_kswapd_request_begin_enabled() ||
+	       trace_myself_kswapd_priority_round_enabled() ||
+	       trace_myself_kswapd_request_end_enabled();
+}
+
+static u64 myks_kswapd_elapsed_ns(u64 begin_ns, u64 end_ns, u32 *validation_flags)
+{
+	if (end_ns < begin_ns) {
+		*validation_flags |= MYKS_VALIDATION_TIME_INVALID;
+		return 0;
+	}
+	return end_ns - begin_ns;
+}
+
+bool myks_kswapd_add_sat(unsigned long left, unsigned long right,
+			 unsigned long *result, u32 flag, u32 *validation_flags)
+{
+	if (check_add_overflow(left, right, result)) {
+		*result = ULONG_MAX;
+		*validation_flags |= flag;
+		return false;
+	}
+	return true;
+}
+
+void myks_kswapd_compute_reclaim_split(unsigned long before,
+					       unsigned long after,
+					       unsigned long soft_reclaimed,
+					       unsigned long *delta,
+					       unsigned long *main_reclaimed,
+					       u32 *validation_flags)
+{
+	if (after < before) {
+		*delta = 0;
+		*main_reclaimed = 0;
+		*validation_flags |= MYKS_VALIDATION_COUNTER_REGRESSION;
+		return;
+	}
+
+	*delta = after - before;
+	if (soft_reclaimed > *delta) {
+		*main_reclaimed = 0;
+		*validation_flags |= MYKS_VALIDATION_RECLAIM_SPLIT_INVALID;
+		return;
+	}
+	*main_reclaimed = *delta - soft_reclaimed;
+}
+
+bool myks_kswapd_events_enabled(void);
+
+void myks_kswapd_request_begin(struct myks_kswapd_request_ctx *ctx,
+				       const struct myks_kswapd_begin_snapshot *snapshot)
+{
+	if (!ctx || !snapshot || !myks_kswapd_events_enabled())
+		return;
+
+	*ctx = (struct myks_kswapd_request_ctx) { 0 };
+	ctx->enabled = true;
+	ctx->request_id = atomic64_inc_return(&myks_request_seq);
+	ctx->request_begin_ns = ktime_get_mono_fast_ns();
+	ctx->exit_reason = MYKS_EXIT_UNKNOWN;
+	trace_myself_kswapd_request_begin(ctx->request_id, snapshot->nid,
+			snapshot->requested_order, snapshot->highest_zoneidx,
+			snapshot->gfp_mask, snapshot->initial_boost_pages,
+			snapshot->boosted);
+}
+
+void myks_kswapd_round_begin(struct myks_kswapd_request_ctx *ctx)
+{
+	if (ctx && ctx->enabled)
+		ctx->round_begin_ns = ktime_get_mono_fast_ns();
+}
+
+void myks_kswapd_priority_round(struct myks_kswapd_request_ctx *ctx,
+					const struct myks_kswapd_round_snapshot *snapshot)
+{
+	unsigned long delta;
+	unsigned long main_reclaimed;
+	unsigned long total_scanned;
+	u32 validation_flags;
+	u64 now_ns;
+	u64 elapsed_ns;
+
+	if (!ctx || !snapshot || !ctx->enabled)
+		return;
+
+	validation_flags = 0;
+	myks_kswapd_compute_reclaim_split(ctx->reclaimed_last,
+			snapshot->reclaimed_total, snapshot->soft_reclaimed,
+			&delta, &main_reclaimed, &validation_flags);
+	if (!myks_kswapd_add_sat(snapshot->main_scanned, snapshot->soft_scanned,
+				&total_scanned, MYKS_VALIDATION_SCAN_OVERFLOW,
+				&validation_flags))
+		validation_flags |= MYKS_VALIDATION_SCAN_OVERFLOW;
+
+	now_ns = ktime_get_mono_fast_ns();
+	ctx->validation_flags |= validation_flags;
+	myks_kswapd_add_sat(ctx->total_reclaimed, delta,
+			&ctx->total_reclaimed, MYKS_VALIDATION_RECLAIM_OVERFLOW,
+			&ctx->validation_flags);
+	myks_kswapd_add_sat(ctx->total_main_reclaimed, main_reclaimed,
+			&ctx->total_main_reclaimed, MYKS_VALIDATION_RECLAIM_OVERFLOW,
+			&ctx->validation_flags);
+	myks_kswapd_add_sat(ctx->total_soft_reclaimed, snapshot->soft_reclaimed,
+			&ctx->total_soft_reclaimed, MYKS_VALIDATION_RECLAIM_OVERFLOW,
+			&ctx->validation_flags);
+	myks_kswapd_add_sat(ctx->total_main_scanned, snapshot->main_scanned,
+			&ctx->total_main_scanned, MYKS_VALIDATION_SCAN_OVERFLOW,
+			&ctx->validation_flags);
+	myks_kswapd_add_sat(ctx->total_soft_scanned, snapshot->soft_scanned,
+			&ctx->total_soft_scanned, MYKS_VALIDATION_SCAN_OVERFLOW,
+			&ctx->validation_flags);
+	myks_kswapd_add_sat(ctx->total_scanned,
+			total_scanned, &ctx->total_scanned, MYKS_VALIDATION_SCAN_OVERFLOW,
+			&ctx->validation_flags);
+	ctx->reclaimed_last = snapshot->reclaimed_total;
+	ctx->had_round = true;
+	ctx->round_count++;
+	elapsed_ns = myks_kswapd_elapsed_ns(ctx->round_begin_ns, now_ns,
+					   &ctx->validation_flags);
+	trace_myself_kswapd_priority_round(ctx->request_id, ctx->pass_seq,
+			ctx->round_seq++, snapshot->nid, snapshot->order,
+			snapshot->priority, snapshot->reclaim_idx,
+			snapshot->nr_to_reclaim, snapshot->main_scanned,
+			snapshot->soft_scanned, total_scanned, main_reclaimed,
+			snapshot->soft_reclaimed, delta, snapshot->balanced_before,
+			snapshot->boost_active, snapshot->raise_priority,
+			snapshot->priority_decremented, snapshot->may_swap,
+			snapshot->may_unmap, snapshot->may_writepage,
+			snapshot->may_deactivate, snapshot->stop_requested,
+			snapshot->was_frozen, snapshot->boost_no_progress,
+			elapsed_ns,
+			validation_flags | ctx->validation_flags);
+}
+
+void myks_kswapd_note_balanced(struct myks_kswapd_request_ctx *ctx)
+{
+	if (!ctx || !ctx->enabled)
+		return;
+	ctx->final_balanced = true;
+	if (!ctx->had_round)
+		ctx->exit_reason = MYKS_EXIT_ALREADY_BALANCED;
+	else
+		ctx->exit_reason = MYKS_EXIT_BALANCED;
+}
+
+void myks_kswapd_note_boost_restart(struct myks_kswapd_request_ctx *ctx)
+{
+	if (ctx && ctx->enabled) {
+		ctx->pass_seq++;
+		ctx->boost_restart_count++;
+	}
+}
+
+void myks_kswapd_note_cache_trim_restart(struct myks_kswapd_request_ctx *ctx)
+{
+	if (ctx && ctx->enabled) {
+		ctx->pass_seq++;
+		ctx->cache_trim_restart_count++;
+	}
+}
+
+void myks_kswapd_note_stop(struct myks_kswapd_request_ctx *ctx, bool frozen)
+{
+	if (!ctx || !ctx->enabled)
+		return;
+	ctx->stop_requested = !frozen;
+	ctx->was_frozen = frozen;
+	ctx->exit_reason = frozen ? MYKS_EXIT_FROZEN : MYKS_EXIT_KTHREAD_STOP;
+}
+
+void myks_kswapd_note_boost_no_progress(struct myks_kswapd_request_ctx *ctx)
+{
+	if (ctx && ctx->enabled)
+		ctx->exit_reason = MYKS_EXIT_BOOST_NO_PROGRESS;
+}
+
+void myks_kswapd_note_priority_exhausted(struct myks_kswapd_request_ctx *ctx)
+{
+	if (ctx && ctx->enabled && !ctx->had_round)
+		ctx->exit_reason = MYKS_EXIT_PRIORITY_EXHAUSTED;
+	else if (ctx && ctx->enabled && ctx->exit_reason == MYKS_EXIT_UNKNOWN)
+		ctx->exit_reason = MYKS_EXIT_PRIORITY_EXHAUSTED;
+}
+
+enum myks_kswapd_exit_reason
+myks_kswapd_exit_reason(const struct myks_kswapd_request_ctx *ctx)
+{
+	if (!ctx)
+		return MYKS_EXIT_UNKNOWN;
+	return ctx->exit_reason;
+}
+
+void myks_kswapd_request_end(struct myks_kswapd_request_ctx *ctx,
+				  const struct myks_kswapd_end_snapshot *snapshot)
+{
+	u64 now_ns;
+	u64 elapsed_ns;
+
+	if (!ctx || !snapshot || !ctx->enabled)
+		return;
+	if (ctx->ended) {
+		ctx->validation_flags |= MYKS_VALIDATION_DOUBLE_END;
+		return;
+	}
+	ctx->ended = true;
+	if (ctx->exit_reason == MYKS_EXIT_UNKNOWN)
+		ctx->validation_flags |= MYKS_VALIDATION_EXIT_UNKNOWN;
+	now_ns = ktime_get_mono_fast_ns();
+	elapsed_ns = myks_kswapd_elapsed_ns(ctx->request_begin_ns, now_ns,
+					    &ctx->validation_flags);
+	trace_myself_kswapd_request_end(ctx->request_id, snapshot->nid,
+			snapshot->requested_order, snapshot->final_order,
+			snapshot->final_priority, snapshot->final_balanced,
+			snapshot->boost_active, snapshot->stop_requested,
+			snapshot->was_frozen, snapshot->order_dropped, ctx->pass_seq + 1,
+			ctx->round_count, ctx->total_main_scanned,
+			ctx->total_soft_scanned, ctx->total_scanned,
+			ctx->total_main_reclaimed, ctx->total_soft_reclaimed,
+			ctx->total_reclaimed, ctx->boost_restart_count,
+			ctx->cache_trim_restart_count, snapshot->exit_reason, elapsed_ns,
+			ctx->validation_flags);
+}
