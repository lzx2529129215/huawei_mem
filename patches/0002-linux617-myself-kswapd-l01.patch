+# SPDX-License-Identifier: GPL-2.0
+
+config MYSELF_KSWAPD
+	bool "Myself kswapd observe-only adapter"
+	depends on MMU
+	depends on MEMCG
+	depends on TRACING
+	default n
+	help
+	  Collect read-only observations from the native kswapd balance loop.
+	  This option does not replace or alter native reclaim behavior.
+	  Tracepoints are emitted only when the corresponding event is enabled.
+	  No reclaim policy, allocation, or asynchronous work is added.
+
+config MYSELF_KSWAPD_KUNIT_TEST
+	bool "KUnit tests for myself kswapd observer"
+	depends on MYSELF_KSWAPD
+	depends on KUNIT
+	default n
+	help
+	  Build pure state and arithmetic tests for the observe-only adapter.
+	  The tests do not expose scan_control or alter native reclaim behavior.
