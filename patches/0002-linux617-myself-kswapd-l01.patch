+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _MM_MYSELF_KSWAPD_OBSERVER_H
+#define _MM_MYSELF_KSWAPD_OBSERVER_H
+
+#include <linux/bitops.h>
+#include <linux/gfp_types.h>
+#include <linux/types.h>
+
+// #lzx: myself-kswapd L0.1 observe-only code
+// #lzx--------------------------- 观察器公开的数据模型 ---------------------------
+enum myks_kswapd_exit_reason {
+	MYKS_EXIT_ALREADY_BALANCED,
+	MYKS_EXIT_BALANCED,
+	MYKS_EXIT_KTHREAD_STOP,
+	MYKS_EXIT_FROZEN,
+	MYKS_EXIT_BOOST_NO_PROGRESS,
+	MYKS_EXIT_PRIORITY_EXHAUSTED,
+	MYKS_EXIT_UNKNOWN,
+};
+
+enum myks_kswapd_validation_flag {
+	MYKS_VALIDATION_OK = 0,
+	MYKS_VALIDATION_COUNTER_REGRESSION = BIT(0),
+	MYKS_VALIDATION_RECLAIM_SPLIT_INVALID = BIT(1),
+	MYKS_VALIDATION_SCAN_OVERFLOW = BIT(2),
+	MYKS_VALIDATION_RECLAIM_OVERFLOW = BIT(3),
+	MYKS_VALIDATION_TIME_INVALID = BIT(4),
+	MYKS_VALIDATION_EXIT_UNKNOWN = BIT(5),
+	MYKS_VALIDATION_DOUBLE_END = BIT(6),
+};
+
+struct myks_kswapd_begin_snapshot {
+	int nid;
+	int requested_order;
+	int highest_zoneidx;
+	gfp_t gfp_mask;
+	unsigned long initial_boost_pages;
+	bool boosted;
+};
+
+struct myks_kswapd_round_snapshot {
+	int nid;
+	s8 order;
+	s8 priority;
+	s8 reclaim_idx;
+	unsigned long nr_to_reclaim;
+	unsigned long main_scanned;
+	unsigned long soft_scanned;
+	unsigned long reclaimed_total;
+	unsigned long soft_reclaimed;
+	bool balanced_before;
+	bool boost_active;
+	bool raise_priority;
+	bool priority_decremented;
+	bool may_swap;
+	bool may_unmap;
+	bool may_writepage;
+	u8 may_deactivate;
+	bool stop_requested;
+	bool was_frozen;
+	bool boost_no_progress;
+};
+
+struct myks_kswapd_end_snapshot {
+	int nid;
+	int requested_order;
+	int final_order;
+	int final_priority;
+	bool final_balanced;
+	bool boost_active;
+	bool stop_requested;
+	bool was_frozen;
+	bool order_dropped;
+	enum myks_kswapd_exit_reason exit_reason;
+};
+
+struct myks_kswapd_request_ctx {
+	u64 request_id;
+	u64 request_begin_ns;
+	u64 round_begin_ns;
+	unsigned long reclaimed_last;
+	bool enabled;
+	bool ended;
+	bool had_round;
+	unsigned int pass_seq;
+	unsigned int round_seq;
+	unsigned int round_count;
+	bool final_balanced;
+	bool stop_requested;
+	bool was_frozen;
+	u32 validation_flags;
+	unsigned long total_main_scanned;
+	unsigned long total_soft_scanned;
+	unsigned long total_scanned;
+	unsigned long total_main_reclaimed;
+	unsigned long total_soft_reclaimed;
+	unsigned long total_reclaimed;
+	unsigned int boost_restart_count;
+	unsigned int cache_trim_restart_count;
+	enum myks_kswapd_exit_reason exit_reason;
+};
+// #lzx--------------------------- 观察器公开的数据模型结束 ---------------------------
+
+// #lzx--------------------------- 观察器接口 ---------------------------
+bool myks_kswapd_events_enabled(void);
+void myks_kswapd_request_begin(struct myks_kswapd_request_ctx *ctx,
+				       const struct myks_kswapd_begin_snapshot *snapshot);
+void myks_kswapd_round_begin(struct myks_kswapd_request_ctx *ctx);
+void myks_kswapd_priority_round(struct myks_kswapd_request_ctx *ctx,
