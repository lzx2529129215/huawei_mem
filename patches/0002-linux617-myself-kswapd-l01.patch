+// SPDX-License-Identifier: GPL-2.0
+
+#include <kunit/test.h>
+
+#include "../include/kswapd_observer.h"
+
+// #lzx: myself-kswapd L0.1 observe-only code
+// #lzx--------------------------- 纯函数单元测试 ---------------------------
+static void myks_reclaim_split_test(struct kunit *test)
+{
+	unsigned long delta;
+	unsigned long main_reclaimed;
+	u32 flags;
+
+	flags = 0;
+	myks_kswapd_compute_reclaim_split(3, 10, 2, &delta, &main_reclaimed,
+					  &flags);
+	KUNIT_EXPECT_EQ(test, delta, 7UL);
+	KUNIT_EXPECT_EQ(test, main_reclaimed, 5UL);
+	KUNIT_EXPECT_EQ(test, flags, 0U);
+}
+
+static void myks_reclaim_split_edge_test(struct kunit *test)
+{
+	unsigned long delta;
+	unsigned long main_reclaimed;
+	u32 flags;
+
+	flags = 0;
+	myks_kswapd_compute_reclaim_split(10, 10, 0, &delta, &main_reclaimed,
+					  &flags);
+	KUNIT_EXPECT_EQ(test, delta, 0UL);
+	KUNIT_EXPECT_EQ(test, main_reclaimed, 0UL);
+	KUNIT_EXPECT_EQ(test, flags, 0U);
+
+	flags = 0;
+	myks_kswapd_compute_reclaim_split(10, 12, 3, &delta, &main_reclaimed,
+					  &flags);
+	KUNIT_EXPECT_EQ(test, delta, 2UL);
+	KUNIT_EXPECT_EQ(test, main_reclaimed, 0UL);
+	KUNIT_EXPECT_EQ(test, flags, (u32)MYKS_VALIDATION_RECLAIM_SPLIT_INVALID);
+
+	flags = 0;
+	myks_kswapd_compute_reclaim_split(12, 10, 0, &delta, &main_reclaimed,
+					  &flags);
+	KUNIT_EXPECT_EQ(test, delta, 0UL);
+	KUNIT_EXPECT_EQ(test, main_reclaimed, 0UL);
+	KUNIT_EXPECT_EQ(test, flags, (u32)MYKS_VALIDATION_COUNTER_REGRESSION);
+}
+
+static void myks_saturating_add_test(struct kunit *test)
+{
+	unsigned long result;
+	u32 flags;
+
+	flags = 0;
+	KUNIT_EXPECT_TRUE(test, myks_kswapd_add_sat(4, 5, &result,
+						   MYKS_VALIDATION_SCAN_OVERFLOW,
+						   &flags));
+	KUNIT_EXPECT_EQ(test, result, 9UL);
+	KUNIT_EXPECT_EQ(test, flags, 0U);
+
+	flags = 0;
+	KUNIT_EXPECT_FALSE(test, myks_kswapd_add_sat(ULONG_MAX, 1, &result,
+						    MYKS_VALIDATION_RECLAIM_OVERFLOW,
+						    &flags));
+	KUNIT_EXPECT_EQ(test, result, ULONG_MAX);
+	KUNIT_EXPECT_EQ(test, flags, (u32)MYKS_VALIDATION_RECLAIM_OVERFLOW);
+}
+
+static void myks_state_lifecycle_test(struct kunit *test)
+{
+	struct myks_kswapd_request_ctx ctx = { // #lzx
+		.enabled = true, // #lzx
+		.exit_reason = MYKS_EXIT_UNKNOWN, // #lzx
+	}; // #lzx
+	struct myks_kswapd_end_snapshot end = { // #lzx
+		.exit_reason = MYKS_EXIT_UNKNOWN, // #lzx
+	}; // #lzx
+
+	myks_kswapd_note_boost_restart(&ctx); // #lzx
+	myks_kswapd_note_cache_trim_restart(&ctx); // #lzx
+	KUNIT_EXPECT_EQ(test, ctx.pass_seq, 2U);
+	KUNIT_EXPECT_EQ(test, ctx.boost_restart_count, 1U);
+	KUNIT_EXPECT_EQ(test, ctx.cache_trim_restart_count, 1U);
+	myks_kswapd_request_end(&ctx, &end); // #lzx
+	KUNIT_EXPECT_TRUE(test, ctx.ended);
+	KUNIT_EXPECT_NE(test, ctx.validation_flags & MYKS_VALIDATION_EXIT_UNKNOWN, 0U);
+	myks_kswapd_request_end(&ctx, &end); // #lzx
+	KUNIT_EXPECT_NE(test, ctx.validation_flags & MYKS_VALIDATION_DOUBLE_END, 0U);
+}
+
+static struct kunit_case myks_observer_test_cases[] = {
+	KUNIT_CASE(myks_reclaim_split_test),
+	KUNIT_CASE(myks_reclaim_split_edge_test),
+	KUNIT_CASE(myks_saturating_add_test),
+	KUNIT_CASE(myks_state_lifecycle_test),
+	{}
+};
+
+static struct kunit_suite myks_observer_test_suite = {
+	.name = "myself-kswapd-observer",
+	.test_cases = myks_observer_test_cases,
+};
+
+kunit_test_suite(myks_observer_test_suite);
