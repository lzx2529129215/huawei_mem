+static void myks_page_config_parser_test(struct kunit *test)
+{
+	struct myks_page_config config;
+	struct myks_page_config parsed;
+	char valid[] = "target_mode=MEMCG target_memcg_id=42 target_nid=1 "
+		       "page_type_mask=0x3 max_entries=64 page_tracking_enabled=1";
+	char unknown[] = "unbounded_dump=1";
+	char missing_target[] = "page_tracking_enabled=1";
+	char reconfigure[] = "max_entries=32";
+
+	myks_page_config_default(&config);
+	KUNIT_EXPECT_FALSE(test, config.enabled);
+	KUNIT_EXPECT_EQ(test, config.target_nid, -1);
+	KUNIT_ASSERT_EQ(test,
+		myks_page_config_parse(&config, valid, &parsed), 0);
+	KUNIT_EXPECT_TRUE(test, parsed.enabled);
+	KUNIT_EXPECT_EQ(test, parsed.max_entries, 64U);
+
+	myks_page_config_default(&config);
+	KUNIT_EXPECT_EQ(test,
+		myks_page_config_parse(&config, unknown, &parsed), -EINVAL);
+	KUNIT_EXPECT_EQ(test,
+		myks_page_config_parse(&config, missing_target, &parsed), -EINVAL);
+	config = myks_test_config(64);
+	KUNIT_EXPECT_EQ(test,
+		myks_page_config_parse(&config, reconfigure, &parsed), -EBUSY);
+}
