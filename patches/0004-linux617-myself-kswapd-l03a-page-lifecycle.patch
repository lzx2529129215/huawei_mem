+static void myks_page_capacity_and_filter_test(struct kunit *test)
+{
+	struct myks_page_table table;
+	struct myks_page_event_batch batch;
+	struct myks_page_config config = myks_test_config(1);
+	struct myks_page_observation observation =
+		myks_test_observation(1, MYKS_PAGE_ADD_LRU);
+	struct myks_page_status status;
+
+	myks_page_table_init(&table);
+	KUNIT_ASSERT_EQ(test, myks_page_table_enable(&table, &config, false), 0);
+	KUNIT_ASSERT_TRUE(test,
+		myks_page_table_observe(&table, &observation, &batch));
+	observation.internal_key = 2;
+	KUNIT_EXPECT_FALSE(test,
+		myks_page_table_observe(&table, &observation, &batch));
+	myks_page_table_status(&table, &status);
+	KUNIT_EXPECT_EQ(test, status.capacity_drop, 1ULL);
+
+	observation.internal_key = 3;
+	observation.memcg_id = 99;
+	KUNIT_EXPECT_FALSE(test,
+		myks_page_table_observe(&table, &observation, &batch));
+	myks_page_table_status(&table, &status);
+	KUNIT_EXPECT_EQ(test, status.capacity_drop, 1ULL);
+	observation.memcg_id = 42;
+	observation.nid = 2;
+	KUNIT_EXPECT_FALSE(test,
+		myks_page_table_observe(&table, &observation, &batch));
+	observation.nid = 1;
+	observation.page_type = MYKS_PAGE_TYPE_UNKNOWN;
+	KUNIT_EXPECT_FALSE(test,
+		myks_page_table_observe(&table, &observation, &batch));
+	myks_page_table_disable(&table);
+}
