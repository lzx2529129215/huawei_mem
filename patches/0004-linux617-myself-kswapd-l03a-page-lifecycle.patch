new file mode 100644
index 000000000..ddacd264d
--- /dev/null
+++ b/Linux6.17/mm/myself_kswapd/include/page_lifecycle.h
@@ -0,0 +1,244 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _MM_MYSELF_KSWAPD_PAGE_LIFECYCLE_H
+#define _MM_MYSELF_KSWAPD_PAGE_LIFECYCLE_H
+
+#include <linux/errno.h>
+#include <linux/list.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+
+#include "lruvec_observer.h"
+
+struct folio;
+
+// #lzx: Linux L0.3A bounded physical page state contract
+#define MYKS_PAGE_MAX_ENTRIES		4096U
+#define MYKS_PAGE_DEFAULT_ENTRIES	1024U
+#define MYKS_PAGE_EVENT_BATCH_MAX	2U
+
+#define MYKS_PAGE_TYPE_MASK_ANON	BIT(0)
+#define MYKS_PAGE_TYPE_MASK_FILE	BIT(1)
+
+#define MYKS_PAGE_FLAG_LATE_DISCOVERY	BIT(0)
+#define MYKS_PAGE_FLAG_UNKNOWN_PREVIOUS	BIT(1)
+#define MYKS_PAGE_FLAG_DUPLICATE_TERMINAL BIT(2)
+#define MYKS_PAGE_FLAG_INVALID_TRANSITION BIT(3)
+#define MYKS_PAGE_FLAG_REUSE_DETECTED	BIT(4)
+#define MYKS_PAGE_FLAG_DOMAIN_CHANGED	BIT(5)
+
+enum myks_page_type {
+	MYKS_PAGE_ANON = 0,
+	MYKS_PAGE_FILE,
+	MYKS_PAGE_TYPE_UNKNOWN,
+};
+
+enum myks_page_lru_class {
+	MYKS_LRU_INACTIVE_ANON = 0,
+	MYKS_LRU_ACTIVE_ANON,
+	MYKS_LRU_INACTIVE_FILE,
+	MYKS_LRU_ACTIVE_FILE,
+	MYKS_LRU_CLASS_NONE,
+};
+
+enum myks_page_state {
+	MYKS_PAGE_UNKNOWN = 0,
+	MYKS_PAGE_ON_LRU_INACTIVE,
+	MYKS_PAGE_ON_LRU_ACTIVE,
+	MYKS_PAGE_ISOLATED,
+	MYKS_PAGE_RECLAIMED,
+	MYKS_PAGE_DEAD,
+};
+
+enum myks_page_action {
+	MYKS_PAGE_DISCOVER = 0,
+	MYKS_PAGE_ADD_LRU,
+	MYKS_PAGE_ACTIVATE,
+	MYKS_PAGE_DEACTIVATE,
+	MYKS_PAGE_ISOLATE,
+	MYKS_PAGE_PUTBACK,
+	MYKS_PAGE_RECLAIM,
+	MYKS_PAGE_FREE,
+	MYKS_PAGE_MIGRATE,
+	MYKS_PAGE_DOMAIN_CHANGE,
+};
+
+struct myks_page_token {
+	u64 page_id;
+	u32 lifecycle_gen;
+	u32 order;
+};
+
+struct myks_page_context {
+	u64 request_id;
+	u64 priority_seq;
+	u64 scan_seq;
+	enum myks_reclaim_source reclaim_source;
+	enum myks_lru_mode mode;
+};
+
+struct myks_shadow_page {
+	struct hlist_node hash_node;
+	struct list_head free_node;
+	u64 internal_key;
+	struct myks_page_token token;
+	u64 memcg_id;
+	s32 nid;
+	u8 page_type;
+	u8 lru_class;
+	u8 physical_state;
+	u8 flags;
+	u64 created_seq;
+	u64 transition_seq;
+	u64 last_request_id;
+	u64 last_priority_seq;
+	u64 last_scan_seq;
+};
+
+struct myks_page_tombstone {
+	u64 internal_key;
+	struct myks_page_token token;
+	u8 terminal_state;
+	u8 terminal_action;
+	bool valid;
+};
+
+struct myks_page_config {
+	bool enabled;
+	enum myks_lru_mode mode;
+	u64 target_memcg_id;
+	s32 target_nid;
+	u32 page_type_mask;
+	u32 max_entries;
+};
+
+struct myks_page_status {
+	bool enabled;
+	u32 tracked_entries;
+	u32 max_entries;
+	u64 events_total;
+	u64 alloc_fail;
+	u64 capacity_drop;
+	u64 late_discovery;
+	u64 invalid_transition;
+	u64 duplicate_terminal;
+	u64 reuse_detected;
+	u64 mglru_rejected;
+	s32 last_error;
+};
+
+struct myks_page_event_record {
+	u64 transition_seq;
+	enum myks_page_action action;
+	struct myks_page_token token;
+	u32 nr_pages;
+	enum myks_page_type page_type;
+	enum myks_page_state from_state;
+	enum myks_page_state to_state;
+	enum myks_page_lru_class lru_class;
+	enum myks_lru_mode mode;
+	u64 memcg_id;
+	s32 nid;
+	u64 request_id;
+	u64 priority_seq;
+	u64 scan_seq;
+	enum myks_reclaim_source reclaim_source;
+	u32 reason;
+	u32 flags;
+};
+
+struct myks_page_event_batch {
+	u8 count;
+	struct myks_page_event_record events[MYKS_PAGE_EVENT_BATCH_MAX];
+};
+
+struct myks_page_observation {
+	u64 internal_key;
+	u32 order;
+	u32 nr_pages;
+	u64 memcg_id;
+	s32 nid;
+	enum myks_page_type page_type;
+	enum myks_page_lru_class lru_class;
+	enum myks_page_action action;
+	struct myks_page_context context;
+	u32 reason;
+};
+
+struct myks_page_table {
+	/* Protects all table storage, entries, tombstones and counters. */
+	spinlock_t lock;
+	struct myks_shadow_page *entries;
+	struct hlist_head *buckets;
+	struct myks_page_tombstone *tombstones;
+	struct list_head free_entries;
+	u32 bucket_count;
+	u32 tombstone_next;
+	u32 nr_entries;
+	struct myks_page_config config;
+	struct myks_page_status counters;
+	u64 next_page_id;
+	u64 next_transition_seq;
+	bool enabled;
+	bool inject_alloc_failure;
+};
+
+u64 myks_page_head_key(u64 pfn, u32 order);
+void myks_page_table_init(struct myks_page_table *table);
+int myks_page_table_enable(struct myks_page_table *table,
+		const struct myks_page_config *config, bool mglru_enabled);
+void myks_page_table_disable(struct myks_page_table *table);
+bool myks_page_table_observe(struct myks_page_table *table,
+		const struct myks_page_observation *observation,
+		struct myks_page_event_batch *batch);
+void myks_page_table_status(struct myks_page_table *table,
+		struct myks_page_status *status);
+u32 myks_page_table_entries(struct myks_page_table *table);
+void myks_page_table_inject_alloc_failure(struct myks_page_table *table,
+		bool fail);
+void myks_page_config_default(struct myks_page_config *config);
+int myks_page_config_parse(const struct myks_page_config *old_config,
+		char *input, struct myks_page_config *new_config);
+ssize_t myks_page_format_config(const struct myks_page_config *config,
+		char *buffer, size_t length);
+ssize_t myks_page_format_status(const struct myks_page_status *status,
+		char *buffer, size_t length);
+
+#ifdef CONFIG_MYSELF_KSWAPD_PAGE_LIFECYCLE
+int myks_page_lifecycle_enable(const struct myks_page_config *config);
+void myks_page_lifecycle_disable(void);
+bool myks_page_lifecycle_active(void);
+void myks_page_lifecycle_status(struct myks_page_status *status);
+void myks_page_lifecycle_observe(struct folio *folio,
+		enum myks_page_action action,
+		const struct myks_reclaim_observer_ctx *reclaim_ctx, u32 reason);
+#else
+static inline int myks_page_lifecycle_enable(
+		const struct myks_page_config *config)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline void myks_page_lifecycle_disable(void)
+{
+}
+
+static inline bool myks_page_lifecycle_active(void)
+{
+	return false;
+}
+
+static inline void myks_page_lifecycle_status(struct myks_page_status *status)
+{
+	if (status)
+		*status = (struct myks_page_status) { 0 };
+}
+
+static inline void myks_page_lifecycle_observe(struct folio *folio,
+		enum myks_page_action action,
+		const struct myks_reclaim_observer_ctx *reclaim_ctx, u32 reason)
+{
+}
+#endif
+// #lzx--------------------------- Linux L0.3A 页状态契约结束 ---------------------------
+
+#endif /* _MM_MYSELF_KSWAPD_PAGE_LIFECYCLE_H */
