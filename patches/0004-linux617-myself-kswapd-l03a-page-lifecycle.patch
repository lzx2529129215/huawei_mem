diff --git a/Linux6.17/mm/myself_kswapd/adapter/page_lifecycle.c b/Linux6.17/mm/myself_kswapd/adapter/page_lifecycle.c
new file mode 100644
index 000000000..efae40675
--- /dev/null
+++ b/Linux6.17/mm/myself_kswapd/adapter/page_lifecycle.c
@@ -0,0 +1,791 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/errno.h>
+#include <linux/cgroup.h>
+#include <linux/hash.h>
+#include <linux/log2.h>
+#include <linux/memcontrol.h>
+#include <linux/mm.h>
+#include <linux/mm_inline.h>
+#include <linux/mutex.h>
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <trace/events/myself_kswapd.h>
+
+#include "../include/page_lifecycle.h"
+
+// #lzx: Linux L0.3A preallocated bounded page table
+u64 myks_page_head_key(u64 pfn, u32 order)
+{
+	u64 mask;
+
+	if (!order || order >= 63)
+		return pfn;
+	mask = (1ULL << order) - 1;
+	return pfn & ~mask;
+}
+
+void myks_page_table_init(struct myks_page_table *table)
+{
+	if (!table)
+		return;
+	memset(table, 0, sizeof(*table));
+	spin_lock_init(&table->lock);
+	INIT_LIST_HEAD(&table->free_entries);
+	table->counters.last_error = 0;
+}
+
+static bool myks_page_config_valid(const struct myks_page_config *config)
+{
+	if (!config || !config->enabled || config->target_nid < 0 ||
+	    !config->page_type_mask ||
+	    config->page_type_mask & ~(MYKS_PAGE_TYPE_MASK_ANON |
+				       MYKS_PAGE_TYPE_MASK_FILE) ||
+	    !config->max_entries || config->max_entries > MYKS_PAGE_MAX_ENTRIES)
+		return false;
+	if (config->mode == MYKS_LRU_MODE_MEMCG)
+		return config->target_memcg_id != 0 &&
+		       config->target_memcg_id != MYKS_SHADOW_ROOT_MEMCG_ID;
+	if (config->mode != MYKS_LRU_MODE_GLOBAL)
+		return false;
+#ifdef CONFIG_MEMCG
+	return false;
+#else
+	return true;
+#endif
+}
+
+int myks_page_table_enable(struct myks_page_table *table,
+		const struct myks_page_config *config, bool mglru_enabled)
+{
+	struct myks_page_tombstone *tombstones;
+	struct myks_shadow_page *entries;
+	struct hlist_head *buckets;
+	unsigned long flags;
+	u32 bucket_count;
+	u32 i;
+
+	if (!table || !myks_page_config_valid(config)) {
+		if (table) {
+			spin_lock_irqsave(&table->lock, flags);
+			table->counters.last_error = -EINVAL;
+			spin_unlock_irqrestore(&table->lock, flags);
+		}
+		return -EINVAL;
+	}
+	if (mglru_enabled) {
+		spin_lock_irqsave(&table->lock, flags);
+		table->counters.mglru_rejected++;
+		table->counters.last_error = -EOPNOTSUPP;
+		spin_unlock_irqrestore(&table->lock, flags);
+		return -EOPNOTSUPP;
+	}
+	if (READ_ONCE(table->inject_alloc_failure)) {
+		spin_lock_irqsave(&table->lock, flags);
+		table->counters.alloc_fail++;
+		table->counters.last_error = -ENOMEM;
+		spin_unlock_irqrestore(&table->lock, flags);
+		return -ENOMEM;
+	}
+
+	bucket_count = roundup_pow_of_two(config->max_entries);
+	entries = kvcalloc(config->max_entries, sizeof(*entries), GFP_KERNEL);
+	buckets = kvcalloc(bucket_count, sizeof(*buckets), GFP_KERNEL);
+	tombstones = kvcalloc(config->max_entries, sizeof(*tombstones), GFP_KERNEL);
+	if (!entries || !buckets || !tombstones) {
+		kvfree(entries);
+		kvfree(buckets);
+		kvfree(tombstones);
+		spin_lock_irqsave(&table->lock, flags);
+		table->counters.alloc_fail++;
+		table->counters.last_error = -ENOMEM;
+		spin_unlock_irqrestore(&table->lock, flags);
+		return -ENOMEM;
+	}
+	for (i = 0; i < bucket_count; i++)
+		INIT_HLIST_HEAD(&buckets[i]);
+	for (i = 0; i < config->max_entries; i++)
+		INIT_LIST_HEAD(&entries[i].free_node);
+
+	spin_lock_irqsave(&table->lock, flags);
+	if (table->enabled || table->entries) {
+		spin_unlock_irqrestore(&table->lock, flags);
+		kvfree(entries);
+		kvfree(buckets);
+		kvfree(tombstones);
+		return -EBUSY;
+	}
+	table->entries = entries;
+	table->buckets = buckets;
+	table->tombstones = tombstones;
+	table->bucket_count = bucket_count;
+	table->tombstone_next = 0;
+	table->nr_entries = 0;
+	table->config = *config;
+	INIT_LIST_HEAD(&table->free_entries);
+	for (i = 0; i < config->max_entries; i++)
+		list_add_tail(&entries[i].free_node, &table->free_entries);
+	table->enabled = true;
+	table->counters.enabled = true;
+	table->counters.max_entries = config->max_entries;
+	table->counters.last_error = 0;
+	spin_unlock_irqrestore(&table->lock, flags);
+	return 0;
+}
+
+void myks_page_table_disable(struct myks_page_table *table)
+{
+	struct myks_page_tombstone *tombstones;
+	struct myks_shadow_page *entries;
+	struct hlist_head *buckets;
+	unsigned long flags;
+
+	if (!table)
+		return;
+	spin_lock_irqsave(&table->lock, flags);
+	table->enabled = false;
+	table->counters.enabled = false;
+	table->counters.tracked_entries = 0;
+	table->nr_entries = 0;
+	entries = table->entries;
+	buckets = table->buckets;
+	tombstones = table->tombstones;
+	table->entries = NULL;
+	table->buckets = NULL;
+	table->tombstones = NULL;
+	table->bucket_count = 0;
+	table->tombstone_next = 0;
+	memset(&table->config, 0, sizeof(table->config));
+	INIT_LIST_HEAD(&table->free_entries);
+	spin_unlock_irqrestore(&table->lock, flags);
+	kvfree(entries);
+	kvfree(buckets);
+	kvfree(tombstones);
+}
+
+static bool myks_page_type_matches(const struct myks_page_config *config,
+		enum myks_page_type type)
+{
+	if (type == MYKS_PAGE_ANON)
+		return config->page_type_mask & MYKS_PAGE_TYPE_MASK_ANON;
+	if (type == MYKS_PAGE_FILE)
+		return config->page_type_mask & MYKS_PAGE_TYPE_MASK_FILE;
+	return false;
+}
+
+static bool myks_page_target_matches(const struct myks_page_config *config,
+		const struct myks_page_observation *observation)
+{
+	if (observation->nid != config->target_nid ||
+	    !myks_page_type_matches(config, observation->page_type))
+		return false;
+	if (config->mode == MYKS_LRU_MODE_MEMCG)
+		return observation->memcg_id == config->target_memcg_id;
+	return config->mode == MYKS_LRU_MODE_GLOBAL;
+}
+
+static struct myks_shadow_page *myks_page_find(struct myks_page_table *table,
+		u64 key)
+{
+	struct myks_shadow_page *entry;
+	u32 index = table->bucket_count == 1 ? 0 :
+		hash_64(key, ilog2(table->bucket_count));
+
+	hlist_for_each_entry(entry, &table->buckets[index], hash_node) {
+		if (entry->internal_key == key)
+			return entry;
+	}
+	return NULL;
+}
+
+static struct myks_page_tombstone *myks_page_find_tombstone(
+		struct myks_page_table *table, u64 key)
+{
+	u32 i;
+
+	for (i = 0; i < table->config.max_entries; i++) {
+		if (table->tombstones[i].valid &&
+		    table->tombstones[i].internal_key == key)
+			return &table->tombstones[i];
+	}
+	return NULL;
+}
+
+static enum myks_page_state myks_page_target_state(
+		const struct myks_page_observation *observation)
+{
+	switch (observation->action) {
+	case MYKS_PAGE_DISCOVER:
+	case MYKS_PAGE_ADD_LRU:
+	case MYKS_PAGE_PUTBACK:
+		return observation->lru_class == MYKS_LRU_ACTIVE_ANON ||
+		       observation->lru_class == MYKS_LRU_ACTIVE_FILE ?
+		       MYKS_PAGE_ON_LRU_ACTIVE : MYKS_PAGE_ON_LRU_INACTIVE;
+	case MYKS_PAGE_ACTIVATE:
+		return MYKS_PAGE_ON_LRU_ACTIVE;
+	case MYKS_PAGE_DEACTIVATE:
+		return MYKS_PAGE_ON_LRU_INACTIVE;
+	case MYKS_PAGE_ISOLATE:
+		return MYKS_PAGE_ISOLATED;
+	case MYKS_PAGE_RECLAIM:
+		return MYKS_PAGE_RECLAIMED;
+	case MYKS_PAGE_FREE:
+	case MYKS_PAGE_MIGRATE:
+		return MYKS_PAGE_DEAD;
+	case MYKS_PAGE_DOMAIN_CHANGE:
+	default:
+		return MYKS_PAGE_UNKNOWN;
+	}
+}
+
+static bool myks_page_transition_valid(enum myks_page_state from,
+		enum myks_page_state to, enum myks_page_action action)
+{
+	switch (action) {
+	case MYKS_PAGE_DISCOVER:
+	case MYKS_PAGE_ADD_LRU:
+		return from == MYKS_PAGE_UNKNOWN &&
+		       (to == MYKS_PAGE_ON_LRU_INACTIVE ||
+			to == MYKS_PAGE_ON_LRU_ACTIVE);
+	case MYKS_PAGE_ACTIVATE:
+		return (from == MYKS_PAGE_UNKNOWN ||
+			from == MYKS_PAGE_ON_LRU_INACTIVE) &&
+		       to == MYKS_PAGE_ON_LRU_ACTIVE;
+	case MYKS_PAGE_DEACTIVATE:
+		return (from == MYKS_PAGE_UNKNOWN ||
+			from == MYKS_PAGE_ON_LRU_ACTIVE) &&
+		       to == MYKS_PAGE_ON_LRU_INACTIVE;
+	case MYKS_PAGE_ISOLATE:
+		return (from == MYKS_PAGE_ON_LRU_INACTIVE ||
+			from == MYKS_PAGE_ON_LRU_ACTIVE ||
+			from == MYKS_PAGE_UNKNOWN) && to == MYKS_PAGE_ISOLATED;
+	case MYKS_PAGE_PUTBACK:
+		return from == MYKS_PAGE_ISOLATED &&
+		       (to == MYKS_PAGE_ON_LRU_INACTIVE ||
+			to == MYKS_PAGE_ON_LRU_ACTIVE);
+	case MYKS_PAGE_RECLAIM:
+		return from == MYKS_PAGE_ISOLATED && to == MYKS_PAGE_RECLAIMED;
+	case MYKS_PAGE_FREE:
+	case MYKS_PAGE_MIGRATE:
+		return from != MYKS_PAGE_UNKNOWN &&
+		       from != MYKS_PAGE_RECLAIMED && from != MYKS_PAGE_DEAD &&
+		       to == MYKS_PAGE_DEAD;
+	case MYKS_PAGE_DOMAIN_CHANGE:
+		return from != MYKS_PAGE_UNKNOWN && from == to;
+	default:
+		return false;
+	}
+}
+
+static void myks_page_fill_record(struct myks_page_table *table,
+		const struct myks_page_observation *observation,
+		const struct myks_shadow_page *entry, enum myks_page_action action,
+		enum myks_page_state from, enum myks_page_state to, u32 flags,
+		struct myks_page_event_record *record)
+{
+	*record = (struct myks_page_event_record) {
+		.transition_seq = ++table->next_transition_seq,
+		.action = action,
+		.token = entry->token,
+		.nr_pages = observation->nr_pages,
+		.page_type = observation->page_type,
+		.from_state = from,
+		.to_state = to,
+		.lru_class = observation->lru_class,
+		.mode = observation->context.mode,
+		.memcg_id = observation->memcg_id,
+		.nid = observation->nid,
+		.request_id = observation->context.request_id,
+		.priority_seq = observation->context.priority_seq,
+		.scan_seq = observation->context.scan_seq,
+		.reclaim_source = observation->context.reclaim_source,
+		.reason = observation->reason,
+		.flags = flags,
+	};
+	table->counters.events_total++;
+}
+
+static void myks_page_retire(struct myks_page_table *table,
+		struct myks_shadow_page *entry, enum myks_page_state terminal,
+		enum myks_page_action action)
+{
+	struct myks_page_tombstone *tombstone =
+		&table->tombstones[table->tombstone_next++ %
+				   table->config.max_entries];
+
+	*tombstone = (struct myks_page_tombstone) {
+		.internal_key = entry->internal_key,
+		.token = entry->token,
+		.terminal_state = terminal,
+		.terminal_action = action,
+		.valid = true,
+	};
+	hlist_del_init(&entry->hash_node);
+	list_add_tail(&entry->free_node, &table->free_entries);
+	table->nr_entries--;
+	table->counters.tracked_entries = table->nr_entries;
+}
+
+static struct myks_shadow_page *myks_page_create(
+		struct myks_page_table *table,
+		const struct myks_page_observation *observation, u32 *flags)
+{
+	struct myks_page_tombstone *tombstone;
+	struct myks_shadow_page *entry;
+	u32 index;
+
+	if (list_empty(&table->free_entries)) {
+		table->counters.capacity_drop++;
+		return NULL;
+	}
+	entry = list_first_entry(&table->free_entries,
+				 struct myks_shadow_page, free_node);
+	list_del_init(&entry->free_node);
+	memset(entry, 0, sizeof(*entry));
+	INIT_LIST_HEAD(&entry->free_node);
+	INIT_HLIST_NODE(&entry->hash_node);
+	entry->internal_key = observation->internal_key;
+	entry->token.page_id = ++table->next_page_id;
+	entry->token.order = observation->order;
+	entry->token.lifecycle_gen = 1;
+	tombstone = myks_page_find_tombstone(table, observation->internal_key);
+	if (tombstone) {
+		entry->token.lifecycle_gen = tombstone->token.lifecycle_gen + 1;
+		*flags |= MYKS_PAGE_FLAG_REUSE_DETECTED;
+		table->counters.reuse_detected++;
+		tombstone->valid = false;
+	}
+	entry->memcg_id = observation->memcg_id;
+	entry->nid = observation->nid;
+	entry->page_type = observation->page_type;
+	entry->lru_class = observation->lru_class;
+	entry->physical_state = MYKS_PAGE_UNKNOWN;
+	entry->created_seq = table->next_transition_seq + 1;
+	index = table->bucket_count == 1 ? 0 :
+		hash_64(entry->internal_key, ilog2(table->bucket_count));
+	hlist_add_head(&entry->hash_node, &table->buckets[index]);
+	table->nr_entries++;
+	table->counters.tracked_entries = table->nr_entries;
+	return entry;
+}
+
+bool myks_page_table_observe(struct myks_page_table *table,
+		const struct myks_page_observation *observation,
+		struct myks_page_event_batch *batch)
+{
+	struct myks_page_tombstone *tombstone;
+	struct myks_shadow_page duplicate_entry;
+	struct myks_shadow_page *entry;
+	enum myks_page_state from;
+	enum myks_page_state to;
+	enum myks_page_action action;
+	unsigned long irq_flags;
+	u32 event_flags = 0;
+	bool context_matches = true;
+	bool target_match;
+	bool valid;
+
+	if (!table || !observation || !batch || !READ_ONCE(table->enabled))
+		return false;
+	*batch = (struct myks_page_event_batch) { 0 };
+
+	spin_lock_irqsave(&table->lock, irq_flags);
+	if (!table->enabled) {
+		spin_unlock_irqrestore(&table->lock, irq_flags);
+		return false;
+	}
+	target_match = myks_page_target_matches(&table->config, observation);
+	entry = myks_page_find(table, observation->internal_key);
+	action = observation->action;
+	if (!entry && !target_match) {
+		spin_unlock_irqrestore(&table->lock, irq_flags);
+		return false;
+	}
+	if (!entry && (observation->action == MYKS_PAGE_RECLAIM ||
+		       observation->action == MYKS_PAGE_FREE ||
+		       observation->action == MYKS_PAGE_MIGRATE)) {
+		tombstone = myks_page_find_tombstone(table,
+						     observation->internal_key);
+		if (!tombstone) {
+			spin_unlock_irqrestore(&table->lock, irq_flags);
+			return false;
+		}
+		if (observation->action == MYKS_PAGE_FREE &&
+		    tombstone->terminal_action == MYKS_PAGE_MIGRATE) {
+			spin_unlock_irqrestore(&table->lock, irq_flags);
+			return false;
+		}
+		memset(&duplicate_entry, 0, sizeof(duplicate_entry));
+		duplicate_entry.token = tombstone->token;
+		event_flags |= MYKS_PAGE_FLAG_DUPLICATE_TERMINAL;
+		myks_page_fill_record(table, observation, &duplicate_entry,
+				observation->action, tombstone->terminal_state,
+				tombstone->terminal_state, event_flags,
+				&batch->events[0]);
+		batch->count = 1;
+		table->counters.duplicate_terminal++;
+		spin_unlock_irqrestore(&table->lock, irq_flags);
+		return true;
+	}
+	if (!entry) {
+		if (observation->action == MYKS_PAGE_PUTBACK ||
+		    observation->action == MYKS_PAGE_DOMAIN_CHANGE) {
+			table->counters.invalid_transition++;
+			spin_unlock_irqrestore(&table->lock, irq_flags);
+			return false;
+		}
+		entry = myks_page_create(table, observation, &event_flags);
+		if (!entry) {
+			spin_unlock_irqrestore(&table->lock, irq_flags);
+			return false;
+		}
+		if (observation->action != MYKS_PAGE_DISCOVER &&
+		    observation->action != MYKS_PAGE_ADD_LRU) {
+			event_flags |= MYKS_PAGE_FLAG_LATE_DISCOVERY |
+				       MYKS_PAGE_FLAG_UNKNOWN_PREVIOUS;
+			table->counters.late_discovery++;
+		}
+	}
+	if (action == MYKS_PAGE_ADD_LRU &&
+	    entry->physical_state == MYKS_PAGE_ISOLATED)
+		action = MYKS_PAGE_PUTBACK;
+	if (action == MYKS_PAGE_ADD_LRU &&
+	    (entry->physical_state == MYKS_PAGE_ON_LRU_INACTIVE ||
+	     entry->physical_state == MYKS_PAGE_ON_LRU_ACTIVE) &&
+	    myks_page_target_state(observation) == entry->physical_state) {
+		spin_unlock_irqrestore(&table->lock, irq_flags);
+		return false;
+	}
+
+	if (action != MYKS_PAGE_DOMAIN_CHANGE &&
+	    (entry->memcg_id != observation->memcg_id ||
+	     entry->nid != observation->nid) &&
+	    batch->count < MYKS_PAGE_EVENT_BATCH_MAX) {
+		myks_page_fill_record(table, observation, entry,
+				MYKS_PAGE_DOMAIN_CHANGE, entry->physical_state,
+				entry->physical_state, MYKS_PAGE_FLAG_DOMAIN_CHANGED,
+				&batch->events[batch->count++]);
+		entry->memcg_id = observation->memcg_id;
+		entry->nid = observation->nid;
+	}
+
+	from = entry->physical_state;
+	to = action == MYKS_PAGE_DOMAIN_CHANGE ? from :
+		myks_page_target_state(observation);
+	if ((action == MYKS_PAGE_PUTBACK || action == MYKS_PAGE_RECLAIM) &&
+	    from == MYKS_PAGE_ISOLATED)
+		context_matches = entry->last_request_id ==
+				  observation->context.request_id &&
+				  entry->last_priority_seq ==
+				  observation->context.priority_seq &&
+				  entry->last_scan_seq ==
+				  observation->context.scan_seq;
+	valid = myks_page_transition_valid(from, to, action) &&
+		context_matches;
+	if (!valid) {
+		event_flags |= MYKS_PAGE_FLAG_INVALID_TRANSITION;
+		table->counters.invalid_transition++;
+	}
+	myks_page_fill_record(table, observation, entry, action,
+			from, to, event_flags, &batch->events[batch->count++]);
+	if (valid) {
+		entry->physical_state = to;
+		entry->lru_class = observation->lru_class;
+		entry->transition_seq = table->next_transition_seq;
+		entry->last_request_id = observation->context.request_id;
+		entry->last_priority_seq = observation->context.priority_seq;
+		entry->last_scan_seq = observation->context.scan_seq;
+		if (to == MYKS_PAGE_RECLAIMED || to == MYKS_PAGE_DEAD)
+			myks_page_retire(table, entry, to, action);
+	}
+	spin_unlock_irqrestore(&table->lock, irq_flags);
+	return batch->count != 0;
+}
+
+void myks_page_table_status(struct myks_page_table *table,
+		struct myks_page_status *status)
+{
+	unsigned long flags;
+
+	if (!table || !status)
+		return;
+	spin_lock_irqsave(&table->lock, flags);
+	*status = table->counters;
+	status->enabled = table->enabled;
+	status->tracked_entries = table->nr_entries;
+	spin_unlock_irqrestore(&table->lock, flags);
+}
+
+u32 myks_page_table_entries(struct myks_page_table *table)
+{
+	struct myks_page_status status = { 0 };
+
+	myks_page_table_status(table, &status);
+	return status.tracked_entries;
+}
+
+void myks_page_table_inject_alloc_failure(struct myks_page_table *table,
+		bool fail)
+{
+	if (table)
+		WRITE_ONCE(table->inject_alloc_failure, fail);
+}
+
+void myks_page_config_default(struct myks_page_config *config)
+{
+	if (!config)
+		return;
+	*config = (struct myks_page_config) {
+		.enabled = false,
+#ifdef CONFIG_MEMCG
+		.mode = MYKS_LRU_MODE_MEMCG,
+#else
+		.mode = MYKS_LRU_MODE_GLOBAL,
+#endif
+		.target_memcg_id = 0,
+		.target_nid = -1,
+		.page_type_mask = MYKS_PAGE_TYPE_MASK_ANON |
+				      MYKS_PAGE_TYPE_MASK_FILE,
+		.max_entries = MYKS_PAGE_DEFAULT_ENTRIES,
+	};
+}
+
+static int myks_page_parse_bool(const char *value, bool *parsed)
+{
+	if (!strcmp(value, "0")) {
+		*parsed = false;
+		return 0;
+	}
+	if (!strcmp(value, "1")) {
+		*parsed = true;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+int myks_page_config_parse(const struct myks_page_config *old_config,
+		char *input, struct myks_page_config *new_config)
+{
+	struct myks_page_config parsed;
+	char *token;
+	char *cursor;
+
+	if (!old_config || !input || !new_config)
+		return -EINVAL;
+	parsed = *old_config;
+	cursor = strim(input);
+	while ((token = strsep(&cursor, " \t\n")) != NULL) {
+		char *value;
+
+		if (!*token)
+			continue;
+		value = strchr(token, '=');
+		if (!value)
+			return -EINVAL;
+		*value++ = '\0';
+		if (!strcmp(token, "page_tracking_enabled")) {
+			if (myks_page_parse_bool(value, &parsed.enabled))
+				return -EINVAL;
+		} else if (!strcmp(token, "target_mode")) {
+			if (!strcmp(value, "MEMCG"))
+				parsed.mode = MYKS_LRU_MODE_MEMCG;
+			else if (!strcmp(value, "GLOBAL"))
+				parsed.mode = MYKS_LRU_MODE_GLOBAL;
+			else
+				return -EINVAL;
+		} else if (!strcmp(token, "target_memcg_id")) {
+			if (kstrtou64(value, 0, &parsed.target_memcg_id))
+				return -EINVAL;
+		} else if (!strcmp(token, "target_nid")) {
+			if (kstrtoint(value, 0, &parsed.target_nid))
+				return -EINVAL;
+		} else if (!strcmp(token, "page_type_mask")) {
+			if (kstrtou32(value, 0, &parsed.page_type_mask))
+				return -EINVAL;
+		} else if (!strcmp(token, "max_entries")) {
+			if (kstrtou32(value, 0, &parsed.max_entries))
+				return -EINVAL;
+		} else {
+			return -EINVAL;
+		}
+	}
+	if (old_config->enabled && parsed.enabled &&
+	    (old_config->mode != parsed.mode ||
+	     old_config->target_memcg_id != parsed.target_memcg_id ||
+	     old_config->target_nid != parsed.target_nid ||
+	     old_config->page_type_mask != parsed.page_type_mask ||
+	     old_config->max_entries != parsed.max_entries))
+		return -EBUSY;
+	if (parsed.enabled && !myks_page_config_valid(&parsed))
+		return -EINVAL;
+	if (!parsed.max_entries || parsed.max_entries > MYKS_PAGE_MAX_ENTRIES ||
+	    parsed.page_type_mask & ~(MYKS_PAGE_TYPE_MASK_ANON |
+				      MYKS_PAGE_TYPE_MASK_FILE))
+		return -EINVAL;
+	*new_config = parsed;
+	return 0;
+}
+
+ssize_t myks_page_format_config(const struct myks_page_config *config,
+		char *buffer, size_t length)
+{
+	if (!config || !buffer || !length)
+		return -EINVAL;
+	return scnprintf(buffer, length,
+		"page_tracking_enabled=%u target_mode=%s target_memcg_id=%llu "
+		"target_nid=%d page_type_mask=0x%x max_entries=%u\n",
+		config->enabled,
+		config->mode == MYKS_LRU_MODE_MEMCG ? "MEMCG" : "GLOBAL",
+		config->target_memcg_id, config->target_nid,
+		config->page_type_mask, config->max_entries);
+}
+
+ssize_t myks_page_format_status(const struct myks_page_status *status,
+		char *buffer, size_t length)
+{
+	if (!status || !buffer || !length)
+		return -EINVAL;
+	return scnprintf(buffer, length,
+		"page_tracking_enabled=%u tracked_entries=%u max_entries=%u "
+		"events_total=%llu alloc_fail=%llu capacity_drop=%llu "
+		"late_discovery=%llu invalid_transition=%llu "
+		"duplicate_terminal=%llu reuse_detected=%llu "
+		"mglru_rejected=%llu last_error=%d\n",
+		status->enabled, status->tracked_entries, status->max_entries,
+		status->events_total, status->alloc_fail, status->capacity_drop,
+		status->late_discovery, status->invalid_transition,
+		status->duplicate_terminal, status->reuse_detected,
+		status->mglru_rejected, status->last_error);
+}
+
+#ifdef CONFIG_MYSELF_KSWAPD_PAGE_LIFECYCLE
+static DEFINE_MUTEX(myks_page_global_lock);
+static struct myks_page_table myks_page_global_table;
+static bool myks_page_global_initialized;
+
+static void myks_page_lifecycle_runtime_reject(void)
+{
+	struct myks_page_table *table = &myks_page_global_table;
+	unsigned long flags;
+
+	spin_lock_irqsave(&table->lock, flags);
+	if (table->enabled) {
+		table->enabled = false;
+		table->counters.enabled = false;
+		table->counters.mglru_rejected++;
+		table->counters.last_error = -EOPNOTSUPP;
+	}
+	spin_unlock_irqrestore(&table->lock, flags);
+}
+
+int myks_page_lifecycle_enable(const struct myks_page_config *config)
+{
+	int ret;
+
+	mutex_lock(&myks_page_global_lock);
+	if (!myks_page_global_initialized) {
+		myks_page_table_init(&myks_page_global_table);
+		WRITE_ONCE(myks_page_global_initialized, true);
+	}
+	ret = myks_page_table_enable(&myks_page_global_table, config,
+				     lru_gen_enabled());
+	mutex_unlock(&myks_page_global_lock);
+	return ret;
+}
+
+bool myks_page_lifecycle_active(void)
+{
+	return READ_ONCE(myks_page_global_table.enabled);
+}
+
+void myks_page_lifecycle_disable(void)
+{
+	mutex_lock(&myks_page_global_lock);
+	if (myks_page_global_initialized)
+		myks_page_table_disable(&myks_page_global_table);
+	mutex_unlock(&myks_page_global_lock);
+}
+
+void myks_page_lifecycle_status(struct myks_page_status *status)
+{
+	if (!status)
+		return;
+	if (!READ_ONCE(myks_page_global_initialized)) {
+		*status = (struct myks_page_status) { 0 };
+		return;
+	}
+	myks_page_table_status(&myks_page_global_table, status);
+}
+
+static enum myks_page_lru_class myks_page_folio_lru_class(struct folio *folio)
+{
+	if (folio_is_file_lru(folio))
+		return folio_test_active(folio) ? MYKS_LRU_ACTIVE_FILE :
+						  MYKS_LRU_INACTIVE_FILE;
+	return folio_test_active(folio) ? MYKS_LRU_ACTIVE_ANON :
+					MYKS_LRU_INACTIVE_ANON;
+}
+
+static u64 myks_page_folio_memcg_id(struct folio *folio)
+{
+#ifdef CONFIG_MEMCG
+	struct mem_cgroup *memcg = folio_memcg(folio);
+
+	return memcg && memcg->css.cgroup ? cgroup_id(memcg->css.cgroup) : 0;
+#else
+	return MYKS_SHADOW_ROOT_MEMCG_ID;
+#endif
+}
+
+void myks_page_lifecycle_observe(struct folio *folio,
+		enum myks_page_action action,
+		const struct myks_reclaim_observer_ctx *reclaim_ctx, u32 reason)
+{
+	struct myks_page_event_batch batch;
+	struct myks_page_observation observation;
+	u8 i;
+
+	if (!folio || !READ_ONCE(myks_page_global_table.enabled))
+		return;
+	if (unlikely(lru_gen_enabled())) {
+		myks_page_lifecycle_runtime_reject();
+		return;
+	}
+	observation = (struct myks_page_observation) {
+		.internal_key = folio_pfn(folio),
+		.order = folio_order(folio),
+		.nr_pages = folio_nr_pages(folio),
+		.memcg_id = myks_page_folio_memcg_id(folio),
+		.nid = folio_nid(folio),
+		.page_type = folio_is_file_lru(folio) ? MYKS_PAGE_FILE :
+							MYKS_PAGE_ANON,
+		.lru_class = myks_page_folio_lru_class(folio),
+		.action = action,
+		.context = {
+#ifdef CONFIG_MEMCG
+			.mode = MYKS_LRU_MODE_MEMCG,
+#else
+			.mode = MYKS_LRU_MODE_GLOBAL,
+#endif
+			.reclaim_source = MYKS_RECLAIM_UNKNOWN,
+		},
+		.reason = reason,
+	};
+	if (reclaim_ctx && reclaim_ctx->active &&
+	    reclaim_ctx->priority_seq && reclaim_ctx->current_scan_seq) {
+		observation.context.request_id = reclaim_ctx->request_id;
+		observation.context.priority_seq = reclaim_ctx->priority_seq;
+		observation.context.scan_seq = reclaim_ctx->current_scan_seq;
+		observation.context.reclaim_source = reclaim_ctx->source;
+		if (reclaim_ctx->identity_valid)
+			observation.context.mode = reclaim_ctx->identity.key.mode;
+	}
+	if (!myks_page_table_observe(&myks_page_global_table, &observation,
+				     &batch))
+		return;
+	for (i = 0; i < batch.count; i++)
+		trace_myself_kswapd_page_lifecycle(&batch.events[i]);
+}
+#endif
+// #lzx--------------------------- Linux L0.3A 页表实现结束 ---------------------------
