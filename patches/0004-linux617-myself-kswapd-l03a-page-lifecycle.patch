+static void myks_page_enable_guard_clear_test(struct kunit *test)
+{
+	struct myks_page_table table;
+	struct myks_page_config config = myks_test_config(2);
+	struct myks_page_status status;
+
+	myks_page_table_init(&table);
+	KUNIT_EXPECT_EQ(test, myks_page_table_enable(&table, &config, true),
+			-EOPNOTSUPP);
+	myks_page_table_status(&table, &status);
+	KUNIT_EXPECT_EQ(test, status.mglru_rejected, 1ULL);
+
+	config.target_nid = -1;
+	KUNIT_EXPECT_EQ(test, myks_page_table_enable(&table, &config, false),
+			-EINVAL);
+	myks_page_table_status(&table, &status);
+	KUNIT_EXPECT_EQ(test, status.last_error, -EINVAL);
+	config = myks_test_config(2);
+	KUNIT_ASSERT_EQ(test, myks_page_table_enable(&table, &config, false), 0);
+	myks_page_table_disable(&table);
+	myks_page_table_status(&table, &status);
+	KUNIT_EXPECT_FALSE(test, status.enabled);
+	KUNIT_EXPECT_EQ(test, status.tracked_entries, 0U);
+}
