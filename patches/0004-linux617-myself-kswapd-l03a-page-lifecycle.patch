diff --git a/Linux6.17/mm/myself_kswapd/tests/page_lifecycle_test.c b/Linux6.17/mm/myself_kswapd/tests/page_lifecycle_test.c
new file mode 100644
index 000000000..81108d98c
--- /dev/null
+++ b/Linux6.17/mm/myself_kswapd/tests/page_lifecycle_test.c
@@ -0,0 +1,293 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <kunit/test.h>
+
+#include "../include/page_lifecycle.h"
+
+// #lzx: Linux L0.3A bounded page lifecycle state tests
+static struct myks_page_config myks_test_config(u32 max_entries)
+{
+	return (struct myks_page_config) {
+		.enabled = true,
+		.mode = MYKS_LRU_MODE_MEMCG,
+		.target_memcg_id = 42,
+		.target_nid = 1,
+		.page_type_mask = MYKS_PAGE_TYPE_MASK_ANON |
+				      MYKS_PAGE_TYPE_MASK_FILE,
+		.max_entries = max_entries,
+	};
+}
+
+static struct myks_page_observation myks_test_observation(
+		u64 key, enum myks_page_action action)
+{
+	return (struct myks_page_observation) {
+		.internal_key = key,
+		.order = 0,
+		.nr_pages = 1,
+		.memcg_id = 42,
+		.nid = 1,
+		.page_type = MYKS_PAGE_ANON,
+		.lru_class = MYKS_LRU_INACTIVE_ANON,
+		.action = action,
+		.context = {
+			.mode = MYKS_LRU_MODE_MEMCG,
+			.reclaim_source = MYKS_RECLAIM_UNKNOWN,
+		},
+	};
+}
+
+static void myks_page_legal_transition_test(struct kunit *test)
+{
+	struct myks_page_table table;
+	struct myks_page_event_batch batch;
+	struct myks_page_config config = myks_test_config(4);
+	struct myks_page_observation observation =
+		myks_test_observation(100, MYKS_PAGE_ADD_LRU);
+
+	myks_page_table_init(&table);
+	KUNIT_ASSERT_EQ(test, myks_page_table_enable(&table, &config, false), 0);
+	KUNIT_ASSERT_TRUE(test,
+		myks_page_table_observe(&table, &observation, &batch));
+	KUNIT_EXPECT_EQ(test, batch.events[0].from_state, MYKS_PAGE_UNKNOWN);
+	KUNIT_EXPECT_EQ(test, batch.events[0].to_state,
+			MYKS_PAGE_ON_LRU_INACTIVE);
+
+	observation.action = MYKS_PAGE_ACTIVATE;
+	observation.lru_class = MYKS_LRU_ACTIVE_ANON;
+	KUNIT_ASSERT_TRUE(test,
+		myks_page_table_observe(&table, &observation, &batch));
+	KUNIT_EXPECT_EQ(test, batch.events[0].to_state,
+			MYKS_PAGE_ON_LRU_ACTIVE);
+
+	observation.action = MYKS_PAGE_DEACTIVATE;
+	observation.lru_class = MYKS_LRU_INACTIVE_ANON;
+	KUNIT_ASSERT_TRUE(test,
+		myks_page_table_observe(&table, &observation, &batch));
