+static void myks_page_late_discovery_reuse_terminal_test(struct kunit *test)
+{
+	struct myks_page_table table;
+	struct myks_page_event_batch batch;
+	struct myks_page_config config = myks_test_config(2);
+	struct myks_page_observation observation =
+		myks_test_observation(102, MYKS_PAGE_ISOLATE);
+	u64 first_page_id;
+	u32 first_generation;
+
+	myks_page_table_init(&table);
+	KUNIT_ASSERT_EQ(test, myks_page_table_enable(&table, &config, false), 0);
+	KUNIT_ASSERT_TRUE(test,
+		myks_page_table_observe(&table, &observation, &batch));
+	KUNIT_EXPECT_TRUE(test,
+		batch.events[0].flags & MYKS_PAGE_FLAG_LATE_DISCOVERY);
+	first_page_id = batch.events[0].token.page_id;
+	first_generation = batch.events[0].token.lifecycle_gen;
+
+	observation.action = MYKS_PAGE_RECLAIM;
+	KUNIT_ASSERT_TRUE(test,
+		myks_page_table_observe(&table, &observation, &batch));
+	KUNIT_EXPECT_EQ(test, myks_page_table_entries(&table), 0U);
+
+	KUNIT_ASSERT_TRUE(test,
+		myks_page_table_observe(&table, &observation, &batch));
+	KUNIT_EXPECT_TRUE(test,
+		batch.events[0].flags & MYKS_PAGE_FLAG_DUPLICATE_TERMINAL);
+
+	observation.action = MYKS_PAGE_ADD_LRU;
+	KUNIT_ASSERT_TRUE(test,
+		myks_page_table_observe(&table, &observation, &batch));
+	KUNIT_EXPECT_NE(test, batch.events[0].token.page_id, first_page_id);
+	KUNIT_EXPECT_GT(test, batch.events[0].token.lifecycle_gen,
+			first_generation);
+	KUNIT_EXPECT_TRUE(test,
+		batch.events[0].flags & MYKS_PAGE_FLAG_REUSE_DETECTED);
+	myks_page_table_disable(&table);
+}
