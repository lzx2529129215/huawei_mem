+	KUNIT_EXPECT_EQ(test, state.emitted[0].request_id,
+			state.emitted[1].request_id);
+	KUNIT_EXPECT_EQ(test, state.emitted[0].priority_seq,
+			state.emitted[1].priority_seq);
+	KUNIT_EXPECT_EQ(test, state.emitted[0].scan_seq,
+			state.emitted[1].scan_seq);
