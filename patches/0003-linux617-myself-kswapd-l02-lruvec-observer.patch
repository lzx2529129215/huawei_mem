@@ -0,0 +1,346 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _MM_MYSELF_KSWAPD_LRUVEC_OBSERVER_H
+#define _MM_MYSELF_KSWAPD_LRUVEC_OBSERVER_H
+
+#include <linux/bitops.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+#include <linux/workqueue.h>
+
+struct lruvec;
+struct mem_cgroup;
+struct pglist_data;
+struct myks_observer;
+typedef struct pglist_data pg_data_t;
+
+// #lzx: Linux L0.2 classic-LRU lruvec observer contract
+// #lzx--------------------------- lruvec 观测类型 ---------------------------
+enum myks_lru_mode {
+	MYKS_LRU_MODE_MEMCG = 0,
+	MYKS_LRU_MODE_GLOBAL,
+};
+
+enum myks_field_scope {
+	MYKS_SCOPE_INVALID = 0,
+	MYKS_SCOPE_MEMCG_NODE,
+	MYKS_SCOPE_NODE,
+};
+
+enum myks_reclaim_source {
+	MYKS_RECLAIM_KSWAPD = 0,
+	MYKS_RECLAIM_DIRECT,
+	MYKS_RECLAIM_MEMCG,
+	MYKS_RECLAIM_UNKNOWN,
+};
+
+enum myks_snapshot_stage {
+	MYKS_STAGE_SCAN_BEFORE = 0,
+	MYKS_STAGE_SCAN_AFTER,
+	MYKS_STAGE_HEARTBEAT,
+	MYKS_STAGE_DEBUGFS,
+};
+
+enum myks_snapshot_consistency {
+	MYKS_SNAPSHOT_APPROXIMATE = 0,
+	MYKS_SNAPSHOT_LOCKED_SAMPLE,
+};
+
+struct myks_lruvec_key {
+	enum myks_lru_mode mode;
+	u64 memcg_id;
+	int nid;
+};
+
+struct myks_lruvec_identity {
+	struct myks_lruvec_key key;
+	u32 memcg_css_id;
+	enum myks_field_scope lru_scope;
+	enum myks_field_scope isolated_scope;
+};
+
+#define MYKS_SHADOW_ROOT_MEMCG_ID	((u64)-1)
+
+#define MYKS_FIELD_INACTIVE_ANON	BIT_ULL(0)
+#define MYKS_FIELD_ACTIVE_ANON		BIT_ULL(1)
+#define MYKS_FIELD_INACTIVE_FILE	BIT_ULL(2)
+#define MYKS_FIELD_ACTIVE_FILE		BIT_ULL(3)
+#define MYKS_FIELD_ISOLATED_ANON	BIT_ULL(4)
+#define MYKS_FIELD_ISOLATED_FILE	BIT_ULL(5)
+#define MYKS_FIELD_SCANNED_TOTAL	BIT_ULL(6)
+#define MYKS_FIELD_RECLAIMED_TOTAL	BIT_ULL(7)
+
+enum myks_lruvec_validation_flag {
+	MYKS_LRUVEC_VALIDATION_NONE = 0,
+	MYKS_LRUVEC_VALIDATION_INVALID_KEY = BIT_ULL(0),
+	MYKS_LRUVEC_VALIDATION_UNSUPPORTED_CONFIG = BIT_ULL(1),
+	MYKS_LRUVEC_VALIDATION_MGLRU = BIT_ULL(2),
+	MYKS_LRUVEC_VALIDATION_INVALID_SCOPE = BIT_ULL(3),
+	MYKS_LRUVEC_VALIDATION_INCARNATION_CHANGE = BIT_ULL(4),
+};
+
+struct myks_lruvec_snapshot {
+	u64 snapshot_seq;
+	u64 timestamp_ns;
+	u64 request_id;
+	u64 priority_seq;
+	u64 scan_seq;
+
+	struct myks_lruvec_key key;
+	u32 memcg_css_id;
+
+	enum myks_reclaim_source reclaim_source;
+	enum myks_snapshot_stage stage;
+	enum myks_snapshot_consistency consistency;
+	int priority;
+	enum myks_field_scope lru_scope;
+	enum myks_field_scope isolated_scope;
+
+	unsigned long inactive_anon;
+	unsigned long active_anon;
+	unsigned long inactive_file;
+	unsigned long active_file;
+	unsigned long isolated_anon;
+	unsigned long isolated_file;
+
+	unsigned long scanned_total;
+	unsigned long reclaimed_total;
+
+	u64 field_valid_mask;
+	u64 validation_flags;
+};
+
+struct myks_reclaim_observer_ctx {
+	u64 request_id;
+	u64 priority_seq;
+	u64 next_scan_seq;
+	enum myks_reclaim_source source;
+	bool active;
+	bool identity_valid;
+	struct myks_observer *observer;
+	struct myks_lruvec_identity identity;
+};
+
+struct myks_lruvec_resolve_ops {
+	bool memcg_supported;
+	int (*nid)(pg_data_t *pgdat);
+	u64 (*memcg_id)(struct mem_cgroup *memcg);
+	u32 (*memcg_css_id)(struct mem_cgroup *memcg);
+	struct lruvec *(*memcg_lruvec)(struct mem_cgroup *memcg,
+						pg_data_t *pgdat);
+	struct lruvec *(*global_lruvec)(pg_data_t *pgdat);
+};
+
+struct myks_lruvec_collect_ops {
+	unsigned long (*lruvec_state)(struct lruvec *lruvec, int index);
+	unsigned long (*node_state)(pg_data_t *pgdat, int index);
+	u64 snapshot_seq;
+	u64 timestamp_ns;
+};
+
+typedef int (*myks_lruvec_collect_callback)(
+		const struct myks_reclaim_observer_ctx *ctx, u64 scan_seq,
+		struct lruvec *lruvec, pg_data_t *pgdat,
+		enum myks_snapshot_stage stage, int priority,
+		unsigned long scanned_total, unsigned long reclaimed_total,
+		struct myks_lruvec_snapshot *out, void *opaque);
+typedef void (*myks_lruvec_emit_callback)(
+		const struct myks_lruvec_snapshot *snapshot, void *opaque);
+
+struct myks_lruvec_emit_ops {
+	myks_lruvec_collect_callback collect;
+	myks_lruvec_emit_callback emit;
+	void *opaque;
+};
+
+#define MYKS_DEBUGFS_DEFAULT_MAX_ENTRIES	1U
+#define MYKS_DEBUGFS_DEFAULT_MAX_BYTES	4096U
+#define MYKS_DEBUGFS_MAX_ENTRIES		1024U
+#define MYKS_DEBUGFS_MAX_BYTES		(1U << 20)
+#define MYKS_SAMPLE_LRU_COUNT		4U
+#define MYKS_SAMPLE_MAX_PER_LRU		32U
+
+struct myks_debugfs_config {
+	bool enabled;
+	enum myks_lru_mode mode;
+	u64 filter_memcg_id;
+	int filter_nid;
+	u32 heartbeat_ms;
+	bool sample_enabled;
+	u32 sample_limit_per_lru;
+	u32 max_snapshot_entries;
+	u32 max_output_bytes;
