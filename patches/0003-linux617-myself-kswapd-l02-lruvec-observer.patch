diff --git a/Linux6.17/mm/myself_kswapd/tests/lruvec_observer_test.c b/Linux6.17/mm/myself_kswapd/tests/lruvec_observer_test.c
new file mode 100644
index 0000000..cb6fa8e
--- /dev/null
+++ b/Linux6.17/mm/myself_kswapd/tests/lruvec_observer_test.c
@@ -0,0 +1,329 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <kunit/test.h>
+
+#include <linux/errno.h>
+#include <linux/mmzone.h>
+
+#include "../include/lruvec_observer.h"
+
+static bool myks_test_mglru;
+
+static bool myks_test_mglru_query(void *opaque)
+{
+	bool *enabled = opaque;
+
+	return *enabled;
+}
+
+static void myks_lruvec_key_mode_test(struct kunit *test)
+{
+	const struct myks_lruvec_key memcg = {
+		.mode = MYKS_LRU_MODE_MEMCG,
+		.memcg_id = 0,
+		.nid = 0,
+	};
+	const struct myks_lruvec_key global = {
+		.mode = MYKS_LRU_MODE_GLOBAL,
+		.memcg_id = 0,
+		.nid = 0,
+	};
+
+	KUNIT_EXPECT_FALSE(test, myks_lruvec_key_equal(&memcg, &global));
+	KUNIT_EXPECT_TRUE(test, myks_lruvec_key_equal(&memcg, &memcg));
+}
+
+static void myks_lruvec_key_validation_test(struct kunit *test)
+{
+	struct myks_lruvec_key key = {
+		.mode = MYKS_LRU_MODE_MEMCG,
+		.memcg_id = 1,
+		.nid = 0,
+	};
+
+	KUNIT_EXPECT_TRUE(test, myks_lruvec_key_valid(&key));
+	key.nid = -1;
+	KUNIT_EXPECT_FALSE(test, myks_lruvec_key_valid(&key));
+}
+
+static void myks_lruvec_scope_test(struct kunit *test)
+{
+	KUNIT_EXPECT_NE(test, MYKS_SCOPE_NODE, MYKS_SCOPE_MEMCG_NODE);
+	KUNIT_EXPECT_NE(test, MYKS_SCOPE_INVALID, MYKS_SCOPE_NODE);
+}
+
+static void myks_reclaim_context_reset_test(struct kunit *test)
+{
+	struct myks_reclaim_observer_ctx ctx = {
+		.request_id = 42,
+		.priority_seq = 9,
+		.next_scan_seq = 10,
+		.source = MYKS_RECLAIM_DIRECT,
+		.active = true,
+	};
+
+	myks_reclaim_ctx_reset(&ctx);
+	KUNIT_EXPECT_FALSE(test, ctx.active);
+	KUNIT_EXPECT_EQ(test, ctx.request_id, 0ULL);
+	KUNIT_EXPECT_EQ(test, ctx.priority_seq, 0ULL);
+	KUNIT_EXPECT_EQ(test, ctx.next_scan_seq, 0ULL);
+	KUNIT_EXPECT_EQ(test, ctx.source, MYKS_RECLAIM_UNKNOWN);
+	KUNIT_EXPECT_FALSE(test, ctx.identity_valid);
+}
+
+static int myks_test_nid(pg_data_t *pgdat)
+{
+	return pgdat ? 2 : -1;
+}
+
+static u64 myks_test_memcg_id(struct mem_cgroup *memcg)
+{
+	return memcg ? 17 : 0;
+}
+
+static u32 myks_test_css_id(struct mem_cgroup *memcg)
+{
+	return memcg ? 23 : 0;
+}
+
+static struct lruvec *myks_test_memcg_lruvec(struct mem_cgroup *memcg,
+						     pg_data_t *pgdat)
+{
+	return memcg && pgdat ? (struct lruvec *)0x1000 : NULL;
+}
+
+static struct lruvec *myks_test_global_lruvec(pg_data_t *pgdat)
+{
+	return pgdat ? (struct lruvec *)0x2000 : NULL;
+}
+
+static void myks_lruvec_resolver_mode_test(struct kunit *test)
+{
+	const struct myks_lruvec_resolve_ops ops = {
+		.memcg_supported = true,
+		.nid = myks_test_nid,
+		.memcg_id = myks_test_memcg_id,
+		.memcg_css_id = myks_test_css_id,
+		.memcg_lruvec = myks_test_memcg_lruvec,
+		.global_lruvec = myks_test_global_lruvec,
+	};
+	struct myks_lruvec_identity identity;
+	struct lruvec *lruvec;
+
+	KUNIT_EXPECT_EQ(test,
+			myks_lruvec_resolve_with_ops(MYKS_LRU_MODE_MEMCG,
+				(struct mem_cgroup *)0x10, (pg_data_t *)0x20,
+				&identity, &lruvec, &ops), 0);
+	KUNIT_EXPECT_EQ(test, identity.key.mode, MYKS_LRU_MODE_MEMCG);
+	KUNIT_EXPECT_EQ(test, identity.key.memcg_id, 17ULL);
+	KUNIT_EXPECT_EQ(test, identity.key.nid, 2);
+	KUNIT_EXPECT_EQ(test, identity.memcg_css_id, 23U);
+	KUNIT_EXPECT_EQ(test, identity.lru_scope, MYKS_SCOPE_MEMCG_NODE);
+	KUNIT_EXPECT_EQ(test, identity.isolated_scope, MYKS_SCOPE_NODE);
+	KUNIT_EXPECT_PTR_EQ(test, lruvec, (struct lruvec *)0x1000);
+
+	KUNIT_EXPECT_EQ(test,
+			myks_lruvec_resolve_with_ops(MYKS_LRU_MODE_GLOBAL,
+				(struct mem_cgroup *)0x10, (pg_data_t *)0x20,
+				&identity, &lruvec, &ops), -EOPNOTSUPP);
+}
+
+static void myks_lruvec_global_resolver_test(struct kunit *test)
+{
+	const struct myks_lruvec_resolve_ops ops = {
+		.memcg_supported = false,
+		.nid = myks_test_nid,
+		.global_lruvec = myks_test_global_lruvec,
+	};
+	struct myks_lruvec_identity identity;
+	struct lruvec *lruvec;
+
+	KUNIT_EXPECT_EQ(test,
+			myks_lruvec_resolve_with_ops(MYKS_LRU_MODE_MEMCG,
+				(struct mem_cgroup *)0x10, (pg_data_t *)0x20,
+				&identity, &lruvec, &ops), -EOPNOTSUPP);
+	KUNIT_EXPECT_EQ(test,
+			myks_lruvec_resolve_with_ops(MYKS_LRU_MODE_GLOBAL, NULL,
+				(pg_data_t *)0x20, &identity, &lruvec, &ops), 0);
+	KUNIT_EXPECT_EQ(test, identity.key.memcg_id,
+				MYKS_SHADOW_ROOT_MEMCG_ID);
+	KUNIT_EXPECT_EQ(test, identity.key.nid, 2);
+	KUNIT_EXPECT_EQ(test, identity.lru_scope, MYKS_SCOPE_NODE);
+	KUNIT_EXPECT_PTR_EQ(test, lruvec, (struct lruvec *)0x2000);
+}
+
+static unsigned long myks_test_lruvec_state(struct lruvec *lruvec, int index)
+{
+	if (!lruvec)
+		return 0;
+	return (unsigned long)(index + 10);
+}
+
+static unsigned long myks_test_node_state(pg_data_t *pgdat, int index)
+{
+	if (!pgdat)
+		return 0;
+	return (unsigned long)(index + 20);
+}
+
+static void myks_lruvec_collection_scope_test(struct kunit *test)
+{
+	const struct myks_lruvec_collect_ops ops = {
+		.lruvec_state = myks_test_lruvec_state,
+		.node_state = myks_test_node_state,
+		.snapshot_seq = 91,
+		.timestamp_ns = 101,
+	};
+	struct myks_reclaim_observer_ctx ctx = {
+		.request_id = 7,
+		.priority_seq = 3,
+		.source = MYKS_RECLAIM_MEMCG,
+		.active = true,
+		.identity_valid = true,
+		.identity = {
+			.key = {
+				.mode = MYKS_LRU_MODE_MEMCG,
+				.memcg_id = 17,
+				.nid = 2,
+			},
+			.lru_scope = MYKS_SCOPE_MEMCG_NODE,
+			.isolated_scope = MYKS_SCOPE_NODE,
+		},
+	};
+	struct myks_lruvec_snapshot snapshot;
+
+	KUNIT_EXPECT_EQ(test,
+			myks_lruvec_collect_with_ops(&ctx, 4, (struct lruvec *)0x1000,
+				(pg_data_t *)0x2000, MYKS_STAGE_SCAN_BEFORE, 9, 30, 12,
+				&snapshot, &ops), 0);
+	KUNIT_EXPECT_EQ(test, snapshot.inactive_anon, 10UL);
+	KUNIT_EXPECT_EQ(test, snapshot.active_anon, 11UL);
+	KUNIT_EXPECT_EQ(test, snapshot.inactive_file, 12UL);
+	KUNIT_EXPECT_EQ(test, snapshot.active_file, 13UL);
+	KUNIT_EXPECT_EQ(test, snapshot.isolated_anon, 24UL);
+	KUNIT_EXPECT_EQ(test, snapshot.isolated_file, 25UL);
+	KUNIT_EXPECT_EQ(test, snapshot.lru_scope, MYKS_SCOPE_MEMCG_NODE);
+	KUNIT_EXPECT_EQ(test, snapshot.isolated_scope, MYKS_SCOPE_NODE);
+	KUNIT_EXPECT_EQ(test, snapshot.consistency, MYKS_SNAPSHOT_APPROXIMATE);
+	KUNIT_EXPECT_EQ(test, snapshot.scanned_total, 30UL);
+	KUNIT_EXPECT_EQ(test, snapshot.reclaimed_total, 12UL);
+}
+
+static void myks_reclaim_context_hierarchy_test(struct kunit *test)
+{
+	struct myks_reclaim_observer_ctx ctx = { 0 };
+	u64 request_id;
+
+	myks_reclaim_ctx_begin_request(&ctx, MYKS_RECLAIM_KSWAPD);
+	request_id = ctx.request_id;
+	KUNIT_EXPECT_GT(test, request_id, 0ULL);
+	KUNIT_EXPECT_TRUE(test, ctx.active);
+	KUNIT_EXPECT_EQ(test, ctx.source, MYKS_RECLAIM_KSWAPD);
+
+	myks_reclaim_ctx_begin_request(&ctx, MYKS_RECLAIM_DIRECT);
+	KUNIT_EXPECT_EQ(test, ctx.request_id, request_id);
+	KUNIT_EXPECT_EQ(test, ctx.source, MYKS_RECLAIM_KSWAPD);
+	KUNIT_EXPECT_EQ(test, myks_reclaim_ctx_begin_priority(&ctx), 1ULL);
+	KUNIT_EXPECT_EQ(test, myks_reclaim_ctx_begin_priority(&ctx), 2ULL);
+	KUNIT_EXPECT_EQ(test, myks_reclaim_ctx_begin_scan(&ctx), 1ULL);
+	KUNIT_EXPECT_EQ(test, myks_reclaim_ctx_begin_scan(&ctx), 2ULL);
+
+	myks_reclaim_ctx_end_request(&ctx);
+	KUNIT_EXPECT_FALSE(test, ctx.active);
+	myks_reclaim_ctx_begin_request(&ctx, MYKS_RECLAIM_MEMCG);
+	KUNIT_EXPECT_NE(test, ctx.request_id, request_id);
+	KUNIT_EXPECT_EQ(test, ctx.source, MYKS_RECLAIM_MEMCG);
+}
+
+static void myks_reclaim_context_unknown_source_test(struct kunit *test)
+{
+	struct myks_reclaim_observer_ctx ctx = { 0 };
+
+	myks_reclaim_ctx_begin_request(&ctx, MYKS_RECLAIM_UNKNOWN);
+	KUNIT_EXPECT_EQ(test, ctx.source, MYKS_RECLAIM_UNKNOWN);
+	myks_reclaim_ctx_begin_request(&ctx, MYKS_RECLAIM_DIRECT);
+	KUNIT_EXPECT_EQ(test, ctx.source, MYKS_RECLAIM_DIRECT);
+}
+
+static void myks_observer_enable_rejects_mglru_test(struct kunit *test)
+{
+	struct myks_observer observer;
+
+	myks_test_mglru = true;
+	myks_observer_init(&observer);
+	KUNIT_EXPECT_EQ(test, myks_observer_enable_with_query(&observer,
+			myks_test_mglru_query, &myks_test_mglru), -EOPNOTSUPP);
+	KUNIT_EXPECT_EQ(test, observer.state, MYKS_OBSERVER_REJECTED_MGLRU);
+	KUNIT_EXPECT_EQ(test, observer.counters.last_error, -EOPNOTSUPP);
+	KUNIT_EXPECT_FALSE(test, myks_observer_snapshot_allowed(&observer));
+	KUNIT_EXPECT_EQ(test, observer.counters.snapshot_skipped_mglru, 1ULL);
+}
+
+static void myks_observer_enable_without_mglru_test(struct kunit *test)
+{
+	struct myks_observer observer;
+
+	myks_test_mglru = false;
+	myks_observer_init(&observer);
+	KUNIT_EXPECT_EQ(test, myks_observer_enable_with_query(&observer,
+			myks_test_mglru_query, &myks_test_mglru), 0);
+	KUNIT_EXPECT_EQ(test, observer.state, MYKS_OBSERVER_ACTIVE);
+	KUNIT_EXPECT_TRUE(test, myks_observer_snapshot_allowed(&observer));
+}
+
+static void myks_observer_runtime_reject_test(struct kunit *test)
+{
+	struct myks_observer observer;
+
+	myks_test_mglru = false;
+	myks_observer_init(&observer);
+	KUNIT_ASSERT_EQ(test, myks_observer_enable_with_query(&observer,
+			myks_test_mglru_query, &myks_test_mglru), 0);
+	KUNIT_ASSERT_TRUE(test, myks_observer_snapshot_allowed(&observer));
+	myks_test_mglru = true;
+	KUNIT_EXPECT_FALSE(test, myks_observer_snapshot_allowed(&observer));
+	KUNIT_EXPECT_EQ(test, observer.state, MYKS_OBSERVER_REJECTED_MGLRU);
+	KUNIT_EXPECT_EQ(test, observer.counters.runtime_reject_count, 1ULL);
+	KUNIT_EXPECT_FALSE(test, myks_observer_snapshot_allowed(&observer));
+	KUNIT_EXPECT_EQ(test, observer.counters.snapshot_skipped_mglru, 2ULL);
+}
+
+static void myks_observer_disable_preserves_counters_test(struct kunit *test)
+{
+	struct myks_observer observer;
+
+	myks_test_mglru = false;
+	myks_observer_init(&observer);
+	KUNIT_ASSERT_EQ(test, myks_observer_enable_with_query(&observer,
+			myks_test_mglru_query, &myks_test_mglru), 0);
+	myks_observer_disable(&observer);
+	KUNIT_EXPECT_EQ(test, observer.state, MYKS_OBSERVER_DISABLED);
+	KUNIT_EXPECT_FALSE(test, myks_observer_snapshot_allowed(&observer));
+	KUNIT_EXPECT_EQ(test, observer.counters.snapshot_skipped_disabled, 1ULL);
+	myks_observer_disable(&observer);
+	KUNIT_EXPECT_EQ(test, observer.counters.snapshot_skipped_disabled, 2ULL);
+}
+
+static struct kunit_case myks_lruvec_observer_test_cases[] = {
+	KUNIT_CASE(myks_lruvec_key_mode_test),
+	KUNIT_CASE(myks_lruvec_key_validation_test),
+	KUNIT_CASE(myks_lruvec_scope_test),
+	KUNIT_CASE(myks_reclaim_context_reset_test),
+	KUNIT_CASE(myks_lruvec_resolver_mode_test),
+	KUNIT_CASE(myks_lruvec_global_resolver_test),
+	KUNIT_CASE(myks_lruvec_collection_scope_test),
+	KUNIT_CASE(myks_reclaim_context_hierarchy_test),
+	KUNIT_CASE(myks_reclaim_context_unknown_source_test),
+	KUNIT_CASE(myks_observer_enable_rejects_mglru_test),
+	KUNIT_CASE(myks_observer_enable_without_mglru_test),
+	KUNIT_CASE(myks_observer_runtime_reject_test),
+	KUNIT_CASE(myks_observer_disable_preserves_counters_test),
+	{}
+};
+
+static struct kunit_suite myks_lruvec_observer_test_suite = {
+	.name = "myself-kswapd-lruvec-observer",
+	.test_cases = myks_lruvec_observer_test_cases,
+};
+
+kunit_test_suite(myks_lruvec_observer_test_suite);
