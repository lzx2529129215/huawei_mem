+static void myks_lruvec_emit_rejection_and_error_test(struct kunit *test)
+{
+	struct myks_observer observer;
+	struct myks_test_emit_state state = { 0 };
+	const struct myks_lruvec_emit_ops ops = {
+		.collect = myks_test_collect_callback,
+		.emit = myks_test_emit_callback,
+		.opaque = &state,
+	};
+	struct myks_reclaim_observer_ctx ctx = {
+		.request_id = 7,
+		.priority_seq = 3,
+		.source = MYKS_RECLAIM_KSWAPD,
+		.active = true,
+		.identity_valid = true,
+		.observer = &observer,
+		.identity.key = {
+			.mode = MYKS_LRU_MODE_MEMCG,
+			.memcg_id = 17,
+			.nid = 2,
+		},
+	};
+	struct myks_lruvec_snapshot snapshot;
+
+	myks_observer_init(&observer);
+	myks_observer_disable(&observer);
+	KUNIT_EXPECT_EQ(test, myks_lruvec_emit_snapshot_with_ops(&ctx, 4,
+			(struct lruvec *)0x1000, (pg_data_t *)0x2000,
+			MYKS_STAGE_SCAN_BEFORE, 9, 0, 0, &snapshot, &ops), -EACCES);
+	KUNIT_EXPECT_EQ(test, state.emit_count, 0U);
+	myks_test_mglru = true;
+	KUNIT_EXPECT_EQ(test, myks_observer_enable_with_query(&observer,
+			myks_test_mglru_query, &myks_test_mglru), -EOPNOTSUPP);
+	KUNIT_EXPECT_EQ(test, myks_lruvec_emit_snapshot_with_ops(&ctx, 4,
+			(struct lruvec *)0x1000, (pg_data_t *)0x2000,
+			MYKS_STAGE_SCAN_BEFORE, 9, 0, 0, &snapshot, &ops), -EACCES);
+	state.collect_error = -ENOMEM;
+	myks_test_mglru = false;
+	KUNIT_ASSERT_EQ(test, myks_observer_enable_with_query(&observer,
+			myks_test_mglru_query, &myks_test_mglru), 0);
+	KUNIT_EXPECT_EQ(test, myks_lruvec_emit_snapshot_with_ops(&ctx, 4,
+			(struct lruvec *)0x1000, (pg_data_t *)0x2000,
+			MYKS_STAGE_SCAN_BEFORE, 9, 0, 0, &snapshot, &ops), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, state.emit_count, 0U);
+	KUNIT_EXPECT_EQ(test, observer.counters.last_error, -ENOMEM);
+}
