+struct myks_test_emit_state {
+	int collect_error;
+	unsigned int emit_count;
+	struct myks_lruvec_snapshot emitted[2];
+};
+
+static int myks_test_collect_callback(
+		const struct myks_reclaim_observer_ctx *ctx, u64 scan_seq,
+		struct lruvec *lruvec, pg_data_t *pgdat,
+		enum myks_snapshot_stage stage, int priority,
+		unsigned long scanned_total, unsigned long reclaimed_total,
+		struct myks_lruvec_snapshot *out, void *opaque)
+{
+	struct myks_test_emit_state *state = opaque;
+
+	(void)lruvec;
+	(void)pgdat;
+	if (state->collect_error)
+		return state->collect_error;
+	*out = (struct myks_lruvec_snapshot) {
+		.request_id = ctx->request_id,
+		.priority_seq = ctx->priority_seq,
+		.scan_seq = scan_seq,
+		.key = ctx->identity.key,
+		.stage = stage,
+		.priority = priority,
+		.scanned_total = scanned_total,
+		.reclaimed_total = reclaimed_total,
+	};
+	return 0;
+}
+
+static void myks_test_emit_callback(const struct myks_lruvec_snapshot *snapshot,
+					void *opaque)
+{
+	struct myks_test_emit_state *state = opaque;
+
+	if (state->emit_count < ARRAY_SIZE(state->emitted))
+		state->emitted[state->emit_count] = *snapshot;
+	state->emit_count++;
+}
