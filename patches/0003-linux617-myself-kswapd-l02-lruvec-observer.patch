diff --git a/Linux6.17/mm/myself_kswapd/include/lruvec_observer.h b/Linux6.17/mm/myself_kswapd/include/lruvec_observer.h
new file mode 100644
index 0000000..c2d9f8e
--- /dev/null
+++ b/Linux6.17/mm/myself_kswapd/include/lruvec_observer.h
@@ -0,0 +1,197 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _MM_MYSELF_KSWAPD_LRUVEC_OBSERVER_H
+#define _MM_MYSELF_KSWAPD_LRUVEC_OBSERVER_H
+
+#include <linux/bitops.h>
+#include <linux/types.h>
+
+struct lruvec;
+struct mem_cgroup;
+struct pglist_data;
+typedef struct pglist_data pg_data_t;
+
+// #lzx: Linux L0.2 classic-LRU lruvec observer contract
+// #lzx--------------------------- lruvec 观测类型 ---------------------------
+enum myks_lru_mode {
+	MYKS_LRU_MODE_MEMCG = 0,
+	MYKS_LRU_MODE_GLOBAL,
+};
+
+enum myks_field_scope {
+	MYKS_SCOPE_INVALID = 0,
+	MYKS_SCOPE_MEMCG_NODE,
+	MYKS_SCOPE_NODE,
+};
+
+enum myks_reclaim_source {
+	MYKS_RECLAIM_KSWAPD = 0,
+	MYKS_RECLAIM_DIRECT,
+	MYKS_RECLAIM_MEMCG,
+	MYKS_RECLAIM_UNKNOWN,
+};
+
+enum myks_snapshot_stage {
+	MYKS_STAGE_SCAN_BEFORE = 0,
+	MYKS_STAGE_SCAN_AFTER,
+	MYKS_STAGE_HEARTBEAT,
+	MYKS_STAGE_DEBUGFS,
+};
+
+enum myks_snapshot_consistency {
+	MYKS_SNAPSHOT_APPROXIMATE = 0,
+	MYKS_SNAPSHOT_LOCKED_SAMPLE,
+};
+
+struct myks_lruvec_key {
+	enum myks_lru_mode mode;
+	u64 memcg_id;
+	int nid;
+};
+
+struct myks_lruvec_identity {
+	struct myks_lruvec_key key;
+	u32 memcg_css_id;
+	enum myks_field_scope lru_scope;
+	enum myks_field_scope isolated_scope;
+};
+
+#define MYKS_SHADOW_ROOT_MEMCG_ID	((u64)-1)
+
+#define MYKS_FIELD_INACTIVE_ANON	BIT_ULL(0)
+#define MYKS_FIELD_ACTIVE_ANON		BIT_ULL(1)
+#define MYKS_FIELD_INACTIVE_FILE	BIT_ULL(2)
+#define MYKS_FIELD_ACTIVE_FILE		BIT_ULL(3)
+#define MYKS_FIELD_ISOLATED_ANON	BIT_ULL(4)
+#define MYKS_FIELD_ISOLATED_FILE	BIT_ULL(5)
+#define MYKS_FIELD_SCANNED_TOTAL	BIT_ULL(6)
+#define MYKS_FIELD_RECLAIMED_TOTAL	BIT_ULL(7)
+
+enum myks_lruvec_validation_flag {
+	MYKS_LRUVEC_VALIDATION_NONE = 0,
+	MYKS_LRUVEC_VALIDATION_INVALID_KEY = BIT_ULL(0),
+	MYKS_LRUVEC_VALIDATION_UNSUPPORTED_CONFIG = BIT_ULL(1),
+	MYKS_LRUVEC_VALIDATION_MGLRU = BIT_ULL(2),
+	MYKS_LRUVEC_VALIDATION_INVALID_SCOPE = BIT_ULL(3),
+	MYKS_LRUVEC_VALIDATION_INCARNATION_CHANGE = BIT_ULL(4),
+};
+
+struct myks_lruvec_snapshot {
+	u64 snapshot_seq;
+	u64 timestamp_ns;
+	u64 request_id;
+	u64 priority_seq;
+	u64 scan_seq;
+
+	struct myks_lruvec_key key;
+	u32 memcg_css_id;
+
+	enum myks_reclaim_source reclaim_source;
+	enum myks_snapshot_stage stage;
+	enum myks_snapshot_consistency consistency;
+	int priority;
+	enum myks_field_scope lru_scope;
+	enum myks_field_scope isolated_scope;
+
+	unsigned long inactive_anon;
+	unsigned long active_anon;
+	unsigned long inactive_file;
+	unsigned long active_file;
+	unsigned long isolated_anon;
+	unsigned long isolated_file;
+
+	unsigned long scanned_total;
+	unsigned long reclaimed_total;
+
+	u64 field_valid_mask;
+	u64 validation_flags;
+};
+
+struct myks_reclaim_observer_ctx {
+	u64 request_id;
+	u64 priority_seq;
+	u64 next_scan_seq;
+	enum myks_reclaim_source source;
+	bool active;
+	bool identity_valid;
+	struct myks_lruvec_identity identity;
+};
+
+struct myks_lruvec_resolve_ops {
+	bool memcg_supported;
+	int (*nid)(pg_data_t *pgdat);
+	u64 (*memcg_id)(struct mem_cgroup *memcg);
+	u32 (*memcg_css_id)(struct mem_cgroup *memcg);
+	struct lruvec *(*memcg_lruvec)(struct mem_cgroup *memcg,
+						pg_data_t *pgdat);
+	struct lruvec *(*global_lruvec)(pg_data_t *pgdat);
+};
+
+struct myks_lruvec_collect_ops {
+	unsigned long (*lruvec_state)(struct lruvec *lruvec, int index);
+	unsigned long (*node_state)(pg_data_t *pgdat, int index);
+	u64 snapshot_seq;
+	u64 timestamp_ns;
+};
+
+enum myks_observer_state {
+	MYKS_OBSERVER_DISABLED = 0,
+	MYKS_OBSERVER_ACTIVE,
+	MYKS_OBSERVER_REJECTED_MGLRU,
+};
+
+struct myks_observer_counters {
+	u64 snapshot_skipped_disabled;
+	u64 snapshot_skipped_mglru;
+	u64 runtime_reject_count;
+	int last_error;
+};
+
+typedef bool (*myks_mglru_query_fn)(void *opaque);
+
+struct myks_observer {
+	enum myks_observer_state state;
+	myks_mglru_query_fn mglru_query;
+	void *mglru_query_opaque;
+	struct myks_observer_counters counters;
+};
+
+bool myks_lruvec_key_equal(const struct myks_lruvec_key *a,
+				   const struct myks_lruvec_key *b);
+bool myks_lruvec_key_valid(const struct myks_lruvec_key *key);
+void myks_reclaim_ctx_reset(struct myks_reclaim_observer_ctx *ctx);
+void myks_reclaim_ctx_begin_request(struct myks_reclaim_observer_ctx *ctx,
+					enum myks_reclaim_source source);
+u64 myks_reclaim_ctx_begin_priority(struct myks_reclaim_observer_ctx *ctx);
+u64 myks_reclaim_ctx_begin_scan(struct myks_reclaim_observer_ctx *ctx);
+void myks_reclaim_ctx_end_request(struct myks_reclaim_observer_ctx *ctx);
+u64 myks_reclaim_ctx_next_priority(struct myks_reclaim_observer_ctx *ctx);
+u64 myks_reclaim_ctx_next_scan(struct myks_reclaim_observer_ctx *ctx);
+int myks_lruvec_resolve(enum myks_lru_mode mode, struct mem_cgroup *memcg,
+			pg_data_t *pgdat, struct myks_lruvec_identity *identity,
+			struct lruvec **lruvec);
+int myks_lruvec_resolve_with_ops(enum myks_lru_mode mode,
+			struct mem_cgroup *memcg, pg_data_t *pgdat,
+			struct myks_lruvec_identity *identity,
+			struct lruvec **lruvec,
+			const struct myks_lruvec_resolve_ops *ops);
+int myks_lruvec_collect(const struct myks_reclaim_observer_ctx *ctx,
+			u64 scan_seq, struct lruvec *lruvec, pg_data_t *pgdat,
+			enum myks_snapshot_stage stage, int priority,
+			unsigned long scanned_total, unsigned long reclaimed_total,
+			struct myks_lruvec_snapshot *out);
+int myks_lruvec_collect_with_ops(
+			const struct myks_reclaim_observer_ctx *ctx, u64 scan_seq,
+			struct lruvec *lruvec, pg_data_t *pgdat,
+			enum myks_snapshot_stage stage, int priority,
+			unsigned long scanned_total, unsigned long reclaimed_total,
+			struct myks_lruvec_snapshot *out,
+			const struct myks_lruvec_collect_ops *ops);
+void myks_observer_init(struct myks_observer *observer);
+int myks_observer_enable(struct myks_observer *observer);
+int myks_observer_enable_with_query(struct myks_observer *observer,
+					myks_mglru_query_fn query, void *opaque);
+void myks_observer_disable(struct myks_observer *observer);
+bool myks_observer_snapshot_allowed(struct myks_observer *observer);
+// #lzx--------------------------- lruvec 观测类型结束 ---------------------------
+
+#endif /* _MM_MYSELF_KSWAPD_LRUVEC_OBSERVER_H */
