diff --git a/Linux6.17/mm/myself_kswapd/adapter/lruvec_observer.c b/Linux6.17/mm/myself_kswapd/adapter/lruvec_observer.c
new file mode 100644
index 0000000..b56c0ec
--- /dev/null
+++ b/Linux6.17/mm/myself_kswapd/adapter/lruvec_observer.c
@@ -0,0 +1,377 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include "../include/lruvec_observer.h"
+
+#include <linux/atomic.h>
+#include <linux/errno.h>
+#include <linux/memcontrol.h>
+#include <linux/mm_inline.h>
+#include <linux/mmzone.h>
+#include <linux/timekeeping.h>
+#include <linux/vmstat.h>
+
+#include "../trace/lruvec_trace.h"
+
+static atomic64_t myks_snapshot_seq = ATOMIC64_INIT(0);
+static atomic64_t myks_request_seq = ATOMIC64_INIT(0);
+
+// #lzx: Linux L0.2 pure lruvec key and context helpers
+// #lzx--------------------------- 纯 helper ---------------------------
+bool myks_lruvec_key_equal(const struct myks_lruvec_key *a,
+				   const struct myks_lruvec_key *b)
+{
+	if (!a || !b)
+		return false;
+
+	return a->mode == b->mode && a->memcg_id == b->memcg_id &&
+	       a->nid == b->nid;
+}
+
+bool myks_lruvec_key_valid(const struct myks_lruvec_key *key)
+{
+	return key && key->mode >= MYKS_LRU_MODE_MEMCG &&
+	       key->mode <= MYKS_LRU_MODE_GLOBAL && key->nid >= 0;
+}
+
+void myks_reclaim_ctx_reset(struct myks_reclaim_observer_ctx *ctx)
+{
+	if (!ctx)
+		return;
+
+	*ctx = (struct myks_reclaim_observer_ctx) {
+		.source = MYKS_RECLAIM_UNKNOWN,
+	};
+}
+
+void myks_reclaim_ctx_begin_request(struct myks_reclaim_observer_ctx *ctx,
+					enum myks_reclaim_source source)
+{
+	if (!ctx)
+		return;
+	if (ctx->active) {
+		if (ctx->source == MYKS_RECLAIM_UNKNOWN &&
+		    source != MYKS_RECLAIM_UNKNOWN)
+			ctx->source = source;
+		return;
+	}
+
+	myks_reclaim_ctx_reset(ctx);
+	ctx->request_id = atomic64_inc_return(&myks_request_seq);
+	ctx->source = source;
+	ctx->active = true;
+}
+
+u64 myks_reclaim_ctx_begin_priority(struct myks_reclaim_observer_ctx *ctx)
+{
+	if (!ctx || !ctx->active)
+		return 0;
+	return myks_reclaim_ctx_next_priority(ctx);
+}
+
+u64 myks_reclaim_ctx_begin_scan(struct myks_reclaim_observer_ctx *ctx)
+{
+	if (!ctx || !ctx->active)
+		return 0;
+	return myks_reclaim_ctx_next_scan(ctx);
+}
+
+void myks_reclaim_ctx_end_request(struct myks_reclaim_observer_ctx *ctx)
+{
+	if (ctx)
+		ctx->active = false;
+}
+
+u64 myks_reclaim_ctx_next_priority(struct myks_reclaim_observer_ctx *ctx)
+{
+	if (!ctx)
+		return 0;
+	if (ctx->priority_seq != (u64)-1)
+		ctx->priority_seq++;
+	return ctx->priority_seq;
+}
+
+u64 myks_reclaim_ctx_next_scan(struct myks_reclaim_observer_ctx *ctx)
+{
+	if (!ctx)
+		return 0;
+	if (ctx->next_scan_seq != (u64)-1)
+		ctx->next_scan_seq++;
+	return ctx->next_scan_seq;
+}
+// #lzx--------------------------- 纯 helper 结束 ---------------------------
+
+// #lzx--------------------------- lruvec resolver ---------------------------
+#ifdef CONFIG_MEMCG
+static u64 myks_default_memcg_id(struct mem_cgroup *memcg)
+{
+	return memcg && memcg->css.cgroup ? cgroup_id(memcg->css.cgroup) : 0;
+}
+
+static u32 myks_default_memcg_css_id(struct mem_cgroup *memcg)
+{
+	return memcg ? (u32)memcg->css.id : 0;
+}
+
+static struct lruvec *myks_default_memcg_lruvec(struct mem_cgroup *memcg,
+							pg_data_t *pgdat)
+{
+	return mem_cgroup_lruvec(memcg, pgdat);
+}
+#endif
+
+static int myks_default_nid(pg_data_t *pgdat)
+{
+	return pgdat ? pgdat->node_id : -1;
+}
+
+static struct lruvec *myks_default_global_lruvec(pg_data_t *pgdat)
+{
+	return pgdat ? &pgdat->__lruvec : NULL;
+}
+
+int myks_lruvec_resolve_with_ops(enum myks_lru_mode mode,
+				 struct mem_cgroup *memcg, pg_data_t *pgdat,
+				 struct myks_lruvec_identity *identity,
+				 struct lruvec **lruvec,
+				 const struct myks_lruvec_resolve_ops *ops)
+{
+	int nid;
+
+	if (!identity || !lruvec || !pgdat || !ops || !ops->nid)
+		return -EINVAL;
+
+	*identity = (struct myks_lruvec_identity) { 0 };
+	*lruvec = NULL;
+	nid = ops->nid(pgdat);
+	if (nid < 0 || mode < MYKS_LRU_MODE_MEMCG ||
+	    mode > MYKS_LRU_MODE_GLOBAL)
+		return -EINVAL;
+
+	identity->key.mode = mode;
+	identity->key.nid = nid;
+	identity->isolated_scope = MYKS_SCOPE_NODE;
+	if (mode == MYKS_LRU_MODE_MEMCG) {
+		if (!ops->memcg_supported)
+			return -EOPNOTSUPP;
+		if (!memcg || !ops->memcg_id || !ops->memcg_css_id ||
+		    !ops->memcg_lruvec)
+			return -EINVAL;
+		identity->key.memcg_id = ops->memcg_id(memcg);
+		identity->memcg_css_id = ops->memcg_css_id(memcg);
+		identity->lru_scope = MYKS_SCOPE_MEMCG_NODE;
+		*lruvec = ops->memcg_lruvec(memcg, pgdat);
+	} else {
+		if (ops->memcg_supported || !ops->global_lruvec)
+			return -EOPNOTSUPP;
+		identity->key.memcg_id = MYKS_SHADOW_ROOT_MEMCG_ID;
+		identity->lru_scope = MYKS_SCOPE_NODE;
+		*lruvec = ops->global_lruvec(pgdat);
+	}
+
+	if (!*lruvec)
+		return -ENODEV;
+	return myks_lruvec_key_valid(&identity->key) ? 0 : -EINVAL;
+}
+
+int myks_lruvec_resolve(enum myks_lru_mode mode, struct mem_cgroup *memcg,
+			pg_data_t *pgdat, struct myks_lruvec_identity *identity,
+			struct lruvec **lruvec)
+{
+	struct myks_lruvec_resolve_ops ops = {
+		.memcg_supported = IS_ENABLED(CONFIG_MEMCG),
+		.nid = myks_default_nid,
+		.global_lruvec = myks_default_global_lruvec,
+	};
+
+#ifdef CONFIG_MEMCG
+	/* #lzx: keep MEMCG-only dereferences behind CONFIG_MEMCG. */
+	ops.memcg_id = myks_default_memcg_id;
+	ops.memcg_css_id = myks_default_memcg_css_id;
+	ops.memcg_lruvec = myks_default_memcg_lruvec;
+#endif
+	return myks_lruvec_resolve_with_ops(mode, memcg, pgdat, identity,
+						lruvec, &ops);
+}
+// #lzx--------------------------- lruvec resolver 结束 ---------------------------
+
+// #lzx--------------------------- 聚合统计 ---------------------------
+static unsigned long myks_default_lruvec_state(struct lruvec *lruvec, int index)
+{
+	return lruvec_page_state(lruvec, index);
+}
+
+static unsigned long myks_default_node_state(pg_data_t *pgdat, int index)
+{
+	return node_page_state(pgdat, index);
+}
+
+static u64 myks_default_timestamp_ns(void)
+{
+	return ktime_get_mono_fast_ns();
+}
+
+int myks_lruvec_collect_with_ops(
+			const struct myks_reclaim_observer_ctx *ctx, u64 scan_seq,
+			struct lruvec *lruvec, pg_data_t *pgdat,
+			enum myks_snapshot_stage stage, int priority,
+			unsigned long scanned_total, unsigned long reclaimed_total,
+			struct myks_lruvec_snapshot *out,
+			const struct myks_lruvec_collect_ops *ops)
+{
+	u64 field_mask = MYKS_FIELD_INACTIVE_ANON |
+			MYKS_FIELD_ACTIVE_ANON | MYKS_FIELD_INACTIVE_FILE |
+			MYKS_FIELD_ACTIVE_FILE | MYKS_FIELD_ISOLATED_ANON |
+			MYKS_FIELD_ISOLATED_FILE | MYKS_FIELD_SCANNED_TOTAL |
+			MYKS_FIELD_RECLAIMED_TOTAL;
+
+	if (!ctx || !ctx->active || !ctx->identity_valid || !lruvec ||
+	    !pgdat || !out || !ops || !ops->lruvec_state || !ops->node_state ||
+	    !myks_lruvec_key_valid(&ctx->identity.key) ||
+	    ctx->identity.lru_scope == MYKS_SCOPE_INVALID ||
+		ctx->identity.isolated_scope != MYKS_SCOPE_NODE)
+		return -EINVAL;
+	*out = (struct myks_lruvec_snapshot) {
+		.snapshot_seq = ops->snapshot_seq ? ops->snapshot_seq :
+				atomic64_inc_return(&myks_snapshot_seq),
+		.timestamp_ns = ops->timestamp_ns ? ops->timestamp_ns :
+				myks_default_timestamp_ns(),
+		.request_id = ctx->request_id,
+		.priority_seq = ctx->priority_seq,
+		.scan_seq = scan_seq,
+		.key = ctx->identity.key,
+		.memcg_css_id = ctx->identity.memcg_css_id,
+		.reclaim_source = ctx->source,
+		.stage = stage,
+		.consistency = MYKS_SNAPSHOT_APPROXIMATE,
+		.priority = priority,
+		.lru_scope = ctx->identity.lru_scope,
+		.isolated_scope = ctx->identity.isolated_scope,
+		.inactive_anon = ops->lruvec_state(lruvec, NR_INACTIVE_ANON),
+		.active_anon = ops->lruvec_state(lruvec, NR_ACTIVE_ANON),
+		.inactive_file = ops->lruvec_state(lruvec, NR_INACTIVE_FILE),
+		.active_file = ops->lruvec_state(lruvec, NR_ACTIVE_FILE),
+		.isolated_anon = ops->node_state(pgdat, NR_ISOLATED_ANON),
+		.isolated_file = ops->node_state(pgdat, NR_ISOLATED_FILE),
+		.scanned_total = scanned_total,
+		.reclaimed_total = reclaimed_total,
+		.field_valid_mask = field_mask,
+	};
+	return 0;
+}
+
+int myks_lruvec_collect(const struct myks_reclaim_observer_ctx *ctx,
+			u64 scan_seq, struct lruvec *lruvec, pg_data_t *pgdat,
+			enum myks_snapshot_stage stage, int priority,
+			unsigned long scanned_total, unsigned long reclaimed_total,
+			struct myks_lruvec_snapshot *out)
+{
+	const struct myks_lruvec_collect_ops ops = {
+		.lruvec_state = myks_default_lruvec_state,
+		.node_state = myks_default_node_state,
+	};
+
+	return myks_lruvec_collect_with_ops(ctx, scan_seq, lruvec, pgdat,
+							 stage, priority, scanned_total,
+							 reclaimed_total, out, &ops);
+}
+
+static int myks_default_collect_callback(
+		const struct myks_reclaim_observer_ctx *ctx, u64 scan_seq,
+		struct lruvec *lruvec, pg_data_t *pgdat,
+		enum myks_snapshot_stage stage, int priority,
+		unsigned long scanned_total, unsigned long reclaimed_total,
+		struct myks_lruvec_snapshot *out, void *opaque)
+{
+	(void)opaque;
+	return myks_lruvec_collect(ctx, scan_seq, lruvec, pgdat, stage,
+				priority, scanned_total, reclaimed_total, out);
+}
+
+static void myks_default_trace_callback(
+		const struct myks_lruvec_snapshot *snapshot, void *opaque)
+{
+	(void)opaque;
+	trace_lruvec_snapshot(snapshot->snapshot_seq, snapshot->timestamp_ns,
+			snapshot->request_id, snapshot->priority_seq,
+			snapshot->scan_seq, snapshot->key.mode,
+			snapshot->key.memcg_id, snapshot->key.nid,
+			snapshot->memcg_css_id, snapshot->reclaim_source,
+			snapshot->stage, snapshot->consistency, snapshot->priority,
+			snapshot->lru_scope, snapshot->isolated_scope,
+			snapshot->inactive_anon, snapshot->active_anon,
+			snapshot->inactive_file, snapshot->active_file,
+			snapshot->isolated_anon, snapshot->isolated_file,
+		snapshot->scanned_total, snapshot->reclaimed_total,
+		snapshot->field_valid_mask, snapshot->validation_flags);
+}
+
+int myks_lruvec_emit_snapshot_with_ops(
+			const struct myks_reclaim_observer_ctx *ctx,
+			u64 scan_seq, struct lruvec *lruvec, pg_data_t *pgdat,
+			enum myks_snapshot_stage stage, int priority,
+			unsigned long scanned_total, unsigned long reclaimed_total,
+			struct myks_lruvec_snapshot *out,
+			const struct myks_lruvec_emit_ops *ops)
+{
+	int ret;
+
+	if (!ctx || !ctx->active || !ctx->identity_valid || !lruvec ||
+		!pgdat || !out || !ops || !ops->collect || !ops->emit)
+		return -EINVAL;
+	if (ctx->observer &&
+		!myks_observer_snapshot_allowed(ctx->observer))
+		return -EACCES;
+	ret = ops->collect(ctx, scan_seq, lruvec, pgdat, stage, priority,
+				scanned_total, reclaimed_total, out, ops->opaque);
+	if (ret) {
+		if (ctx->observer) {
+			ctx->observer->counters.collection_errors++;
+			ctx->observer->counters.last_error = ret;
+		}
+		return ret;
+	}
+	if (ctx->observer) {
+		ctx->observer->counters.snapshot_generated++;
+		ctx->observer->counters.trace_emit_attempted++;
+	}
+	ops->emit(out, ops->opaque);
+	return 0;
+}
+
+void myks_lruvec_emit_snapshot(struct myks_reclaim_observer_ctx *ctx,
+				struct lruvec *lruvec, pg_data_t *pgdat,
+				u64 scan_seq, enum myks_snapshot_stage stage, int priority,
+				unsigned long scanned_total,
+				unsigned long reclaimed_total)
+{
+	struct myks_lruvec_snapshot snapshot;
+	struct myks_lruvec_identity identity;
+	struct lruvec *resolved_lruvec;
+	struct mem_cgroup *memcg = NULL;
+	enum myks_lru_mode mode;
+
+	if (!ctx || !ctx->active || !lruvec || !pgdat)
+		return;
+
+#ifdef CONFIG_MEMCG
+	mode = MYKS_LRU_MODE_MEMCG;
+	memcg = lruvec_memcg(lruvec);
+#else
+	mode = MYKS_LRU_MODE_GLOBAL;
+#endif
+	if (myks_lruvec_resolve(mode, memcg, pgdat, &identity,
+				&resolved_lruvec))
+		return;
+	if (resolved_lruvec != lruvec)
+		return;
+	ctx->identity = identity;
+	ctx->identity_valid = true;
+	if (myks_lruvec_emit_snapshot_with_ops(ctx, scan_seq, lruvec, pgdat,
+				stage, priority, scanned_total, reclaimed_total, &snapshot,
+				&(struct myks_lruvec_emit_ops) {
+					.collect = myks_default_collect_callback,
+					.emit = myks_default_trace_callback,
+				}))
+		return;
+}
+// #lzx--------------------------- 聚合统计结束 ---------------------------
diff --git a/Linux6.17/mm/myself_kswapd/adapter/lruvec_sample.c b/Linux6.17/mm/myself_kswapd/adapter/lruvec_sample.c
new file mode 100644
index 0000000..6333045
--- /dev/null
+++ b/Linux6.17/mm/myself_kswapd/adapter/lruvec_sample.c
@@ -0,0 +1,267 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include "../include/lruvec_observer.h"
+
+#include <linux/cgroup.h>
+#include <linux/errno.h>
+#include <linux/gfp.h>
+#include <linux/list.h>
+#include <linux/memcontrol.h>
+#include <linux/mm.h>
+#include <linux/mmzone.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#define MYKS_SAMPLE_FLAG_ACTIVE		BIT(0)
+#define MYKS_SAMPLE_FLAG_UNEVICTABLE	BIT(1)
+#define MYKS_SAMPLE_FLAG_REFERENCED	BIT(2)
+#define MYKS_SAMPLE_FLAG_DIRTY		BIT(3)
+#define MYKS_SAMPLE_FLAG_WRITEBACK	BIT(4)
+#define MYKS_SAMPLE_FLAG_LOCKED		BIT(5)
+
+static void myks_sample_cache_clear(struct myks_debugfs_sample_cache *cache)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&cache->lock, flags);
+	cache->nr_total = 0;
+	cache->nr_emitted = 0;
+	cache->limit_per_lru = 0;
+	cache->snapshot_seq = 0;
+	cache->truncated = false;
+	cache->valid = false;
+	spin_unlock_irqrestore(&cache->lock, flags);
+}
+
+void myks_debugfs_sample_cache_init(struct myks_debugfs_sample_cache *cache)
+{
+	if (!cache)
+		return;
+
+	memset(cache, 0, sizeof(*cache));
+	spin_lock_init(&cache->lock);
+}
+
+static int myks_sample_cache_commit(struct myks_debugfs_sample_cache *cache,
+					const struct myks_lru_sample *samples,
+					u32 limit_per_lru, u32 nr_total,
+					u32 nr_emitted, bool truncated,
+					u64 snapshot_seq)
+{
+	unsigned long flags;
+	u64 generation;
+
+	if (!cache || !samples || nr_emitted > ARRAY_SIZE(cache->samples))
+		return -EINVAL;
+
+	spin_lock_irqsave(&cache->lock, flags);
+	if (cache->generation == U64_MAX) {
+		spin_unlock_irqrestore(&cache->lock, flags);
+		return -EOVERFLOW;
+	}
+	generation = cache->generation + 1;
+	memcpy(cache->samples, samples,
+	       nr_emitted * sizeof(cache->samples[0]));
+	cache->generation = generation;
+	cache->snapshot_seq = snapshot_seq;
+	cache->limit_per_lru = limit_per_lru;
+	cache->nr_total = nr_total;
+	cache->nr_emitted = nr_emitted;
+	cache->truncated = truncated;
+	cache->valid = true;
+	spin_unlock_irqrestore(&cache->lock, flags);
+	return 0;
+}
+
+int myks_lruvec_collect_samples_with_ops(
+				const struct myks_debugfs_config *config,
+				struct myks_debugfs_sample_cache *cache,
+				const struct myks_lru_sample_iter_ops *ops,
+				u64 snapshot_seq)
+{
+	struct myks_lru_sample *samples;
+	u64 total = 0;
+	u32 emitted = 0;
+	bool truncated = false;
+	unsigned int lru;
+	int ret = 0;
+
+	if (!config || !cache || !ops || !ops->count || !ops->get)
+		return -EINVAL;
+	if (!config->sample_enabled || !config->sample_limit_per_lru) {
+		myks_sample_cache_clear(cache);
+		return 0;
+	}
+	if (config->sample_limit_per_lru > MYKS_SAMPLE_MAX_PER_LRU)
+		return -EINVAL;
+
+	samples = kcalloc(ARRAY_SIZE(cache->samples), sizeof(*samples),
+				  GFP_KERNEL);
+	if (!samples)
+		return -ENOMEM;
+	for (lru = 0; lru < MYKS_SAMPLE_LRU_COUNT; lru++) {
+		unsigned int count = ops->count(lru, ops->opaque);
+		unsigned int index;
+
+		total += count;
+		if (count > config->sample_limit_per_lru)
+			truncated = true;
+		for (index = 0; index < count &&
+				emitted < ARRAY_SIZE(cache->samples) &&
+				index < config->sample_limit_per_lru; index++) {
+			struct myks_lru_sample sample;
+
+			if (!ops->get(lru, index, &sample, ops->opaque))
+				continue;
+			sample.lru = lru;
+			samples[emitted++] = sample;
+		}
+	}
+	if (total > U32_MAX)
+		total = U32_MAX;
+	ret = myks_sample_cache_commit(cache, samples,
+					config->sample_limit_per_lru, (u32)total,
+						emitted, truncated, snapshot_seq);
+	kfree(samples);
+	return ret;
+}
+
+static unsigned long myks_sample_flags(const struct folio *folio)
+{
+	unsigned long flags = 0;
+
+	if (folio_test_active(folio))
+		flags |= MYKS_SAMPLE_FLAG_ACTIVE;
+	if (folio_test_unevictable(folio))
+		flags |= MYKS_SAMPLE_FLAG_UNEVICTABLE;
+	if (folio_test_referenced(folio))
+		flags |= MYKS_SAMPLE_FLAG_REFERENCED;
+	if (folio_test_dirty(folio))
+		flags |= MYKS_SAMPLE_FLAG_DIRTY;
+	if (folio_test_writeback(folio))
+		flags |= MYKS_SAMPLE_FLAG_WRITEBACK;
+	if (folio_test_locked(folio))
+		flags |= MYKS_SAMPLE_FLAG_LOCKED;
+	return flags;
+}
+
+int myks_lruvec_collect_samples(struct lruvec *lruvec, pg_data_t *pgdat,
+				const struct myks_debugfs_config *config,
+				struct myks_debugfs_sample_cache *cache,
+				u64 snapshot_seq)
+{
+	struct myks_lru_sample *samples;
+	unsigned long irq_flags;
+	u32 total = 0;
+	u32 emitted = 0;
+	bool truncated = false;
+	unsigned int lru;
+	u64 memcg_id = MYKS_SHADOW_ROOT_MEMCG_ID;
+
+	if (!lruvec || !pgdat || !config || !cache)
+		return -EINVAL;
+	if (!config->sample_enabled || !config->sample_limit_per_lru) {
+		myks_sample_cache_clear(cache);
+		return 0;
+	}
+	if (config->sample_limit_per_lru > MYKS_SAMPLE_MAX_PER_LRU)
+		return -EINVAL;
+	samples = kcalloc(ARRAY_SIZE(cache->samples), sizeof(*samples),
+				  GFP_KERNEL);
+	if (!samples)
+		return -ENOMEM;
+
+#ifdef CONFIG_MEMCG
+	if (lruvec_memcg(lruvec) && lruvec_memcg(lruvec)->css.cgroup)
+		memcg_id = cgroup_id(lruvec_memcg(lruvec)->css.cgroup);
+#endif
+	spin_lock_irqsave(&lruvec->lru_lock, irq_flags);
+	for (lru = 0; lru < MYKS_SAMPLE_LRU_COUNT; lru++) {
+		struct folio *folio;
+		unsigned int per_lru = 0;
+
+		list_for_each_entry(folio, &lruvec->lists[lru], lru) {
+			if (total != U32_MAX)
+				total++;
+			if (per_lru == config->sample_limit_per_lru) {
+				truncated = true;
+				continue;
+			}
+			if (emitted == ARRAY_SIZE(cache->samples)) {
+				truncated = true;
+				continue;
+			}
+			samples[emitted++] = (struct myks_lru_sample) {
+				.pfn = folio_pfn(folio),
+				.memcg_id = memcg_id,
+				.nid = pgdat->node_id,
+				.lru = lru,
+				.flags = myks_sample_flags(folio),
+			};
+			per_lru++;
+		}
+	}
+	spin_unlock_irqrestore(&lruvec->lru_lock, irq_flags);
+
+	if (total == U32_MAX)
+		truncated = true;
+	/* #lzx: all folio fields are copied before releasing lru_lock. */
+	{
+		int ret = myks_sample_cache_commit(cache, samples,
+						config->sample_limit_per_lru, total,
+						emitted, truncated, snapshot_seq);
+
+		kfree(samples);
+		return ret;
+	}
+}
+
+ssize_t myks_debugfs_format_samples(
+				struct myks_debugfs_sample_cache *cache,
+				char *buffer, size_t length)
+{
+	struct myks_lru_sample *samples;
+	unsigned long flags;
+	u64 generation;
+	u64 snapshot_seq;
+	u32 limit;
+	u32 nr_total;
+	u32 nr_emitted;
+	bool truncated;
+	bool valid;
+	u32 i;
+	int used;
+
+	if (!cache || !buffer || !length)
+		return -EINVAL;
+	samples = kcalloc(ARRAY_SIZE(cache->samples), sizeof(*samples),
+				  GFP_KERNEL);
+	if (!samples)
+		return -ENOMEM;
+	spin_lock_irqsave(&cache->lock, flags);
+	generation = cache->generation;
+	snapshot_seq = cache->snapshot_seq;
+	limit = cache->limit_per_lru;
+	nr_total = cache->nr_total;
+	nr_emitted = min_t(u32, cache->nr_emitted,
+				ARRAY_SIZE(cache->samples));
+	truncated = cache->truncated;
+	valid = cache->valid;
+	memcpy(samples, cache->samples,
+	       nr_emitted * sizeof(cache->samples[0]));
+	spin_unlock_irqrestore(&cache->lock, flags);
+
+	used = scnprintf(buffer, length,
+			"valid=%d generation=%llu snapshot_seq=%llu "
+			"limit_per_lru=%u nr_total=%u nr_emitted=%u truncated=%d\n",
+			valid, generation, snapshot_seq, limit, nr_total,
+			nr_emitted, truncated);
+	for (i = 0; i < nr_emitted && used < length; i++)
+		used += scnprintf(buffer + used, length - used,
+				  "sample=%u pfn=%lu memcg_id=%llu nid=%d lru=%d "
+				  "flags=0x%lx\n", i, samples[i].pfn,
+				  samples[i].memcg_id, samples[i].nid, samples[i].lru,
+				  samples[i].flags);
+	kfree(samples);
+	return min_t(int, used, length);
+}
diff --git a/Linux6.17/mm/myself_kswapd/adapter/observer_config.c b/Linux6.17/mm/myself_kswapd/adapter/observer_config.c
new file mode 100644
index 0000000..eb96db0
--- /dev/null
+++ b/Linux6.17/mm/myself_kswapd/adapter/observer_config.c
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include "../include/lruvec_observer.h"
+
+#include <linux/errno.h>
+#include <linux/mm_inline.h>
+
+// #lzx: Linux L0.2 observer enable and MGLRU guard
+// #lzx--------------------------- 观察器状态机 ---------------------------
+static bool myks_default_mglru_query(void *opaque)
+{
+	(void)opaque;
+	return lru_gen_enabled();
+}
+
+void myks_observer_init(struct myks_observer *observer)
+{
+	if (!observer)
+		return;
+
+	*observer = (struct myks_observer) {
+		.state = MYKS_OBSERVER_DISABLED,
+	};
+}
+
+int myks_observer_enable_with_query(struct myks_observer *observer,
+					myks_mglru_query_fn query, void *opaque)
+{
+	if (!observer || !query)
+		return -EINVAL;
+
+	observer->mglru_query = query;
+	observer->mglru_query_opaque = opaque;
+	if (query(opaque)) {
+		observer->state = MYKS_OBSERVER_REJECTED_MGLRU;
+		observer->counters.last_error = -EOPNOTSUPP;
+		return -EOPNOTSUPP;
+	}
+
+	observer->state = MYKS_OBSERVER_ACTIVE;
+	observer->counters.last_error = 0;
+	return 0;
+}
+
+int myks_observer_enable(struct myks_observer *observer)
+{
+	return myks_observer_enable_with_query(observer,
+			myks_default_mglru_query, NULL);
+}
+
+void myks_observer_disable(struct myks_observer *observer)
+{
+	if (!observer)
+		return;
+
+	observer->state = MYKS_OBSERVER_DISABLED;
+	observer->counters.last_error = 0;
+}
+
+bool myks_observer_snapshot_allowed(struct myks_observer *observer)
+{
+	if (!observer)
+		return false;
+
+	if (observer->state == MYKS_OBSERVER_DISABLED) {
+		observer->counters.snapshot_skipped_disabled++;
+		observer->counters.last_error = -EACCES;
+		return false;
+	}
+	if (observer->state == MYKS_OBSERVER_REJECTED_MGLRU) {
+		observer->counters.snapshot_skipped_mglru++;
+		observer->counters.last_error = -EOPNOTSUPP;
+		return false;
+	}
+	if (observer->state != MYKS_OBSERVER_ACTIVE ||
+		!observer->mglru_query)
+		return false;
+	if (observer->mglru_query(observer->mglru_query_opaque)) {
+		observer->state = MYKS_OBSERVER_REJECTED_MGLRU;
+		observer->counters.snapshot_skipped_mglru++;
+		observer->counters.runtime_reject_count++;
+		observer->counters.last_error = -EOPNOTSUPP;
+		return false;
+	}
+
+	return true;
+}
+// #lzx--------------------------- 观察器状态机结束 ---------------------------
