+struct myks_test_emit_state {
+	int collect_error;
+	unsigned int emit_count;
+	struct myks_lruvec_snapshot emitted[2];
+};
+
+static int myks_test_collect_callback(
+		const struct myks_reclaim_observer_ctx *ctx, u64 scan_seq,
+		struct lruvec *lruvec, pg_data_t *pgdat,
+		enum myks_snapshot_stage stage, int priority,
+		unsigned long scanned_total, unsigned long reclaimed_total,
+		struct myks_lruvec_snapshot *out, void *opaque)
+{
+	struct myks_test_emit_state *state = opaque;
+
+	(void)lruvec;
+	(void)pgdat;
+	if (state->collect_error)
+		return state->collect_error;
+	*out = (struct myks_lruvec_snapshot) {
+		.request_id = ctx->request_id,
+		.priority_seq = ctx->priority_seq,
+		.scan_seq = scan_seq,
+		.key = ctx->identity.key,
+		.stage = stage,
+		.priority = priority,
+		.scanned_total = scanned_total,
+		.reclaimed_total = reclaimed_total,
+	};
+	return 0;
+}
+
+static void myks_test_emit_callback(const struct myks_lruvec_snapshot *snapshot,
+					void *opaque)
+{
+	struct myks_test_emit_state *state = opaque;
+
+	if (state->emit_count < ARRAY_SIZE(state->emitted))
+		state->emitted[state->emit_count] = *snapshot;
+	state->emit_count++;
+}
+
+static void myks_lruvec_emit_pair_test(struct kunit *test)
+{
+	struct myks_observer observer;
+	struct myks_test_emit_state state = { 0 };
+	const struct myks_lruvec_emit_ops ops = {
+		.collect = myks_test_collect_callback,
+		.emit = myks_test_emit_callback,
+		.opaque = &state,
+	};
+	struct myks_reclaim_observer_ctx ctx = {
+		.request_id = 7,
+		.priority_seq = 3,
+		.source = MYKS_RECLAIM_KSWAPD,
+		.active = true,
+		.identity_valid = true,
+		.observer = &observer,
+		.identity = {
+			.key = {
+				.mode = MYKS_LRU_MODE_MEMCG,
+				.memcg_id = 17,
+				.nid = 2,
+			},
+			.lru_scope = MYKS_SCOPE_MEMCG_NODE,
+			.isolated_scope = MYKS_SCOPE_NODE,
+		},
+	};
+
+	myks_test_mglru = false;
+	myks_observer_init(&observer);
+	KUNIT_ASSERT_EQ(test, myks_observer_enable_with_query(&observer,
+			myks_test_mglru_query, &myks_test_mglru), 0);
+	KUNIT_EXPECT_EQ(test, myks_lruvec_emit_snapshot_with_ops(&ctx, 4,
+			(struct lruvec *)0x1000, (pg_data_t *)0x2000,
+			MYKS_STAGE_SCAN_BEFORE, 9, 30, 12, NULL, &ops), -EINVAL);
+	{
+		struct myks_lruvec_snapshot snapshot;
+
+		KUNIT_ASSERT_EQ(test, myks_lruvec_emit_snapshot_with_ops(&ctx, 4,
+				(struct lruvec *)0x1000, (pg_data_t *)0x2000,
+				MYKS_STAGE_SCAN_BEFORE, 9, 30, 12, &snapshot, &ops), 0);
+		KUNIT_ASSERT_EQ(test, myks_lruvec_emit_snapshot_with_ops(&ctx, 4,
+				(struct lruvec *)0x1000, (pg_data_t *)0x2000,
+				MYKS_STAGE_SCAN_AFTER, 9, 31, 13, &snapshot, &ops), 0);
+	}
+	KUNIT_EXPECT_EQ(test, state.emit_count, 2U);
+	KUNIT_EXPECT_EQ(test, state.emitted[0].stage, MYKS_STAGE_SCAN_BEFORE);
+	KUNIT_EXPECT_EQ(test, state.emitted[1].stage, MYKS_STAGE_SCAN_AFTER);
+	KUNIT_EXPECT_EQ(test, state.emitted[0].request_id,
+			state.emitted[1].request_id);
+	KUNIT_EXPECT_EQ(test, state.emitted[0].priority_seq,
+			state.emitted[1].priority_seq);
+	KUNIT_EXPECT_EQ(test, state.emitted[0].scan_seq,
+			state.emitted[1].scan_seq);
+	KUNIT_EXPECT_TRUE(test, myks_lruvec_key_equal(&state.emitted[0].key,
+			&state.emitted[1].key));
+}
