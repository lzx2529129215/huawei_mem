+		KUNIT_ASSERT_EQ(test, myks_lruvec_emit_snapshot_with_ops(&ctx, 4,
+				(struct lruvec *)0x1000, (pg_data_t *)0x2000,
+				MYKS_STAGE_SCAN_BEFORE, 9, 30, 12, &snapshot, &ops), 0);
