diff --git a/Linux6.17/mm/myself_kswapd/tests/lruvec_observer_test.c b/Linux6.17/mm/myself_kswapd/tests/lruvec_observer_test.c
new file mode 100644
index 0000000..010e22f
--- /dev/null
+++ b/Linux6.17/mm/myself_kswapd/tests/lruvec_observer_test.c
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <kunit/test.h>
+
+#include "../include/lruvec_observer.h"
+
+static void myks_lruvec_key_mode_test(struct kunit *test)
+{
+	const struct myks_lruvec_key memcg = {
+		.mode = MYKS_LRU_MODE_MEMCG,
+		.memcg_id = 0,
+		.nid = 0,
+	};
+	const struct myks_lruvec_key global = {
+		.mode = MYKS_LRU_MODE_GLOBAL,
+		.memcg_id = 0,
+		.nid = 0,
+	};
+
+	KUNIT_EXPECT_FALSE(test, myks_lruvec_key_equal(&memcg, &global));
+	KUNIT_EXPECT_TRUE(test, myks_lruvec_key_equal(&memcg, &memcg));
+}
+
+static void myks_lruvec_key_validation_test(struct kunit *test)
+{
+	struct myks_lruvec_key key = {
+		.mode = MYKS_LRU_MODE_MEMCG,
+		.memcg_id = 1,
+		.nid = 0,
+	};
+
+	KUNIT_EXPECT_TRUE(test, myks_lruvec_key_valid(&key));
+	key.nid = -1;
+	KUNIT_EXPECT_FALSE(test, myks_lruvec_key_valid(&key));
+}
+
+static void myks_lruvec_scope_test(struct kunit *test)
+{
+	KUNIT_EXPECT_NE(test, MYKS_SCOPE_NODE, MYKS_SCOPE_MEMCG_NODE);
+	KUNIT_EXPECT_NE(test, MYKS_SCOPE_INVALID, MYKS_SCOPE_NODE);
+}
+
+static void myks_reclaim_context_reset_test(struct kunit *test)
+{
+	struct myks_reclaim_observer_ctx ctx = {
+		.request_id = 42,
+		.priority_seq = 9,
+		.next_scan_seq = 10,
+		.source = MYKS_RECLAIM_DIRECT,
+		.active = true,
+	};
+
+	myks_reclaim_ctx_reset(&ctx);
+	KUNIT_EXPECT_FALSE(test, ctx.active);
+	KUNIT_EXPECT_EQ(test, ctx.request_id, 0ULL);
+	KUNIT_EXPECT_EQ(test, ctx.priority_seq, 0ULL);
+	KUNIT_EXPECT_EQ(test, ctx.next_scan_seq, 0ULL);
+	KUNIT_EXPECT_EQ(test, ctx.source, MYKS_RECLAIM_UNKNOWN);
+}
+
+static struct kunit_case myks_lruvec_observer_test_cases[] = {
+	KUNIT_CASE(myks_lruvec_key_mode_test),
+	KUNIT_CASE(myks_lruvec_key_validation_test),
+	KUNIT_CASE(myks_lruvec_scope_test),
+	KUNIT_CASE(myks_reclaim_context_reset_test),
+	{}
+};
+
+static struct kunit_suite myks_lruvec_observer_test_suite = {
+	.name = "myself-kswapd-lruvec-observer",
+	.test_cases = myks_lruvec_observer_test_cases,
+};
+
+kunit_test_suite(myks_lruvec_observer_test_suite);
