{
  "description": "Perf_WPS_0070 PDF：打开、上下翻页、跳到末页/首页、最小化、最大化和关闭。",
  "variables": {
    "WPS_PDF_FILE": "${PROJECT_ROOT}/samples/wps/document_200m.pdf",
    "WPS_PDF_LOAD_SECONDS": "20"
  },
  "actions": [
    {"type": "assert_file", "path": "${WPS_PDF_FILE}", "label": "WPS_REQUIRE_PDF_SAMPLE"},
    {"type": "launch", "name": "wpspdf", "command": "wpspdf", "label": "WPS_PDF_LAUNCH"},
    {"type": "wait_window", "name": "wps", "class": "wpspdf|wps|wpsoffice", "timeout": 20},
    {"type": "window_state", "name": "wps", "class": "wpspdf|wps|wpsoffice", "state": "maximize"},
    {"type": "open_file", "name": "wps", "class": "wpspdf|wps|wpsoffice", "path": "${WPS_PDF_FILE}", "wait_after": "${WPS_PDF_LOAD_SECONDS}", "label": "WPS_PDF_OPEN"},
    {"type": "scroll", "name": "wps", "class": "wpspdf|wps|wpsoffice", "direction": "down", "amount": 3, "label": "WPS_PDF_SCROLL_DOWN"},
    {"type": "scroll", "name": "wps", "class": "wpspdf|wps|wpsoffice", "direction": "up", "amount": 3, "label": "WPS_PDF_SCROLL_UP"},
    {"type": "key", "key": "ctrl+End", "name": "wps", "label": "WPS_PDF_LAST_PAGE"},
    {"type": "wait", "seconds": 3},
    {"type": "key", "key": "ctrl+Home", "name": "wps", "label": "WPS_PDF_FIRST_PAGE"},
    {"type": "window_state", "name": "wps", "class": "wpspdf|wps|wpsoffice", "state": "minimize", "label": "WPS_MINIMIZE"},
    {"type": "wait", "seconds": 2},
    {"type": "window_state", "name": "wps", "class": "wpspdf|wps|wpsoffice", "state": "restore", "label": "WPS_RESTORE"},
    {"type": "window_state", "name": "wps", "class": "wpspdf|wps|wpsoffice", "state": "maximize", "label": "WPS_MAXIMIZE"},
    {"type": "wait", "seconds": 10},
    {"type": "key", "key": "ctrl+w", "name": "wps", "label": "WPS_PDF_TAB_CLOSE"},
    {"type": "close", "name": "wpspdf", "class": "wpspdf|wps|wpsoffice", "process_names": ["wpsoffice", "wps", "wpp", "et", "wpspdf"], "path_contains": ["/opt/kingsoft/wps-office"], "force_after_seconds": 3, "label": "WPS_CLOSE"}
  ]
}
