{
  "description": "Perf_WPS_0050 PPT：打开、放映、页面复制、插入图片/视频/矩形、缩放、删除新增页面和保存。",
  "variables": {
    "WPS_PPT_FILE": "${PROJECT_ROOT}/samples/wps/presentation_200m.pptx",
    "WPS_IMAGE_FILE": "${PROJECT_ROOT}/samples/wps/image_1m.png",
    "WPS_VIDEO_FILE": "${PROJECT_ROOT}/samples/wps/video_10m.mp4",
    "PPT_NAV_X": "0.10",
    "PPT_NAV_Y": "0.55",
    "PPT_INSERT_TAB_X": "0.22",
    "PPT_INSERT_TAB_Y": "0.075",
    "PPT_VIDEO_BUTTON_X": "0.73",
    "PPT_VIDEO_BUTTON_Y": "0.135",
    "PPT_SHAPE_BUTTON_X": "0.42",
    "PPT_SHAPE_BUTTON_Y": "0.135",
    "PPT_RECTANGLE_X": "0.38",
    "PPT_RECTANGLE_Y": "0.24",
    "PPT_VIDEO_PLAY_SECONDS": "10",
    "WPS_PPT_LOAD_SECONDS": "20"
  },
  "actions": [
    {"type": "assert_file", "path": "${WPS_PPT_FILE}", "label": "WPS_REQUIRE_PPT_SAMPLE"},
    {"type": "assert_file", "path": "${WPS_IMAGE_FILE}", "label": "WPS_REQUIRE_IMAGE_SAMPLE"},
    {"type": "assert_file", "path": "${WPS_VIDEO_FILE}", "label": "WPS_REQUIRE_VIDEO_SAMPLE"},
    {"type": "launch", "name": "wpp", "command": "wpp", "label": "WPS_PPT_LAUNCH"},
    {"type": "wait_window", "name": "wps", "class": "wpp|wps|wpsoffice", "timeout": 20},
    {"type": "window_state", "name": "wps", "class": "wpp|wps|wpsoffice", "state": "maximize"},
    {"type": "open_file", "name": "wps", "class": "wpp|wps|wpsoffice", "path": "${WPS_PPT_FILE}", "wait_after": "${WPS_PPT_LOAD_SECONDS}", "label": "WPS_PPT_OPEN"},

    {"type": "key", "key": "F5", "name": "wps", "label": "WPS_PPT_SLIDESHOW_START"},
    {"type": "wait", "seconds": 5},
    {"type": "key", "key": "Right", "repeat": 5, "interval": 1, "name": "wps", "label": "WPS_PPT_FORWARD_5"},
    {"type": "key", "key": "Left", "repeat": 5, "interval": 1, "name": "wps", "label": "WPS_PPT_BACKWARD_5"},
    {"type": "key", "key": "Escape", "name": "wps", "label": "WPS_PPT_SLIDESHOW_EXIT"},
    {"type": "wait", "seconds": 3},
    {"type": "scroll", "name": "wps", "class": "wpp|wps|wpsoffice", "x_ratio": 0.60, "y_ratio": 0.55, "direction": "up", "amount": 3, "label": "WPS_PPT_BODY_SCROLL_UP"},
    {"type": "scroll", "name": "wps", "class": "wpp|wps|wpsoffice", "x_ratio": 0.60, "y_ratio": 0.55, "direction": "down", "amount": 3, "label": "WPS_PPT_BODY_SCROLL_DOWN"},

    {"type": "click_window", "name": "wps", "class": "wpp|wps|wpsoffice", "x_ratio": "${PPT_NAV_X}", "y_ratio": "${PPT_NAV_Y}", "label": "WPS_PPT_NAVIGATION_FOCUS"},
    {"type": "key", "key": "ctrl+End", "name": "wps", "label": "WPS_PPT_LAST_SLIDE"},
    {"type": "key", "key": "ctrl+c", "name": "wps", "label": "WPS_PPT_COPY_LAST_SLIDE"},
    {"type": "key", "key": "ctrl+v", "name": "wps", "label": "WPS_PPT_DUPLICATE_LAST_SLIDE"},

    {"type": "key", "key": "ctrl+m", "name": "wps", "label": "WPS_PPT_NEW_IMAGE_SLIDE"},
    {"type": "clipboard_file", "path": "${WPS_IMAGE_FILE}", "label": "WPS_COPY_IMAGE"},
    {"type": "key", "key": "ctrl+v", "name": "wps", "label": "WPS_PPT_PASTE_IMAGE"},
    {"type": "drag_window", "name": "wps", "class": "wpp|wps|wpsoffice", "x1_ratio": 0.66, "y1_ratio": 0.66, "x2_ratio": 0.78, "y2_ratio": 0.78, "duration_ms": 800, "label": "WPS_PPT_IMAGE_RESIZE"},

    {"type": "key", "key": "ctrl+m", "name": "wps", "label": "WPS_PPT_NEW_VIDEO_SLIDE"},
    {"type": "click_window", "name": "wps", "class": "wpp|wps|wpsoffice", "x_ratio": "${PPT_INSERT_TAB_X}", "y_ratio": "${PPT_INSERT_TAB_Y}", "label": "WPS_PPT_INSERT_TAB"},
    {"type": "click_window", "name": "wps", "class": "wpp|wps|wpsoffice", "x_ratio": "${PPT_VIDEO_BUTTON_X}", "y_ratio": "${PPT_VIDEO_BUTTON_Y}", "label": "WPS_PPT_INSERT_VIDEO_BUTTON"},
    {"type": "dialog_path", "path": "${WPS_VIDEO_FILE}", "must_exist": true, "wait_before": 1, "wait_after": 8, "label": "WPS_PPT_CHOOSE_VIDEO"},
    {"type": "click_window", "name": "wps", "class": "wpp|wps|wpsoffice", "x_ratio": "${PPT_INSERT_TAB_X}", "y_ratio": "${PPT_INSERT_TAB_Y}"},
    {"type": "click_window", "name": "wps", "class": "wpp|wps|wpsoffice", "x_ratio": "${PPT_SHAPE_BUTTON_X}", "y_ratio": "${PPT_SHAPE_BUTTON_Y}", "label": "WPS_PPT_SHAPE_MENU"},
    {"type": "click_window", "name": "wps", "class": "wpp|wps|wpsoffice", "x_ratio": "${PPT_RECTANGLE_X}", "y_ratio": "${PPT_RECTANGLE_Y}", "label": "WPS_PPT_RECTANGLE_SELECT"},
    {"type": "drag_window", "name": "wps", "class": "wpp|wps|wpsoffice", "x1_ratio": 0.45, "y1_ratio": 0.45, "x2_ratio": 0.70, "y2_ratio": 0.68, "duration_ms": 800, "label": "WPS_PPT_RECTANGLE_DRAW_RESIZE"},
    {"type": "key", "key": "ctrl+s", "name": "wps", "label": "WPS_PPT_SAVE_1"},

    {"type": "key", "key": "shift+F5", "name": "wps", "label": "WPS_PPT_CURRENT_SLIDE_PLAY"},
    {"type": "wait", "seconds": 5},
    {"type": "click_window", "name": "wps", "class": "wpp|wps|wpsoffice", "x_ratio": 0.50, "y_ratio": 0.55, "label": "WPS_PPT_VIDEO_PLAY"},
    {"type": "wait", "seconds": "${PPT_VIDEO_PLAY_SECONDS}", "label": "WPS_PPT_VIDEO_WAIT"},
    {"type": "key", "key": "Escape", "name": "wps", "label": "WPS_PPT_PLAY_EXIT"},
    {"type": "wait", "seconds": 3},
    {"type": "click_window", "name": "wps", "class": "wpp|wps|wpsoffice", "x_ratio": "${PPT_NAV_X}", "y_ratio": "${PPT_NAV_Y}"},
    {"type": "key", "key": "ctrl+End", "name": "wps"},
    {"type": "key", "key": "Delete", "repeat": 3, "interval": 1, "name": "wps", "label": "WPS_PPT_DELETE_THREE_NEW_SLIDES"},
    {"type": "key", "key": "ctrl+s", "name": "wps", "label": "WPS_PPT_SAVE_2"},
    {"type": "window_state", "name": "wps", "class": "wpp|wps|wpsoffice", "state": "maximize", "label": "WPS_MAXIMIZE"},
    {"type": "wait", "seconds": 10},
    {"type": "key", "key": "ctrl+w", "name": "wps", "label": "WPS_PPT_TAB_CLOSE"},
    {"type": "close", "name": "wpp", "class": "wpp|wps|wpsoffice", "process_names": ["wpsoffice", "wps", "wpp", "et", "wpspdf"], "path_contains": ["/opt/kingsoft/wps-office"], "force_after_seconds": 3, "label": "WPS_CLOSE"}
  ]
}
