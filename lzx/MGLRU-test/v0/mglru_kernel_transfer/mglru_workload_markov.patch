--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -59,6 +59,7 @@
 #include <linux/mmu_notifier.h>
 #include <linux/parser.h>
 #include <linux/memory_hotplug.h>
+#include <linux/cgroup.h>
 
 #include <asm/tlbflush.h>
 #include <asm/div64.h>
@@ -3829,6 +3830,825 @@
 	.release = single_release,
 };
 
+/******************************************************************************
+ *                MGLRU workload Markov observe-only MVP
+ *
+ * Provides /sys/kernel/debug/lru_gen_workload_markov, a debugfs interface
+ * that lets userspace feed app/workload state and Markov transition tables
+ * into the kernel. Before each MGLRU eviction batch, the kernel looks up the
+ * current app (by cgroup id), finds the matching Markov transition, and
+ * refreshes a cycle-level reclaim hint. It is purely observe-only: it never
+ * changes any reclaim decision, generation, or folio placement, and it is
+ * never called from a per-folio path.
+ ******************************************************************************/
+
+#define MGLRU_MARKOV_MAX_APPS		16
+#define MGLRU_MARKOV_MAX_PREDICTED	 4
+#define MGLRU_MARKOV_MAX_HISTORIES	64
+#define MGLRU_MARKOV_MAX_TRANSITIONS	128
+#define MGLRU_MARKOV_MAX_HINTS		64
+
+/* Limit observe-only prepare work for the same reclaim target to once per 50ms. */
+#define MGLRU_MARKOV_PREPARE_THROTTLE_JIFFIES	msecs_to_jiffies(50)
+
+/* --- data structures ------------------------------------------------ */
+
+struct mglru_markov_app {
+	int		app_id;
+	u64		cgroup_id;
+	int		current_workload;
+	int		prev_workload;		/* workload before current */
+	unsigned long	ttl_ms;
+	unsigned long	last_update_jiffies;
+	unsigned long	last_prepare_jiffies;
+	const struct lruvec *last_prepare_lruvec;
+	bool		valid;
+};
+
+struct mglru_markov_history {
+	int		app_id;
+	u64		cgroup_id;
+	int		workload_id;
+	unsigned long	timestamp_jiffies;
+	bool		valid;
+};
+
+struct mglru_markov_transition {
+	int		app_id;
+	int		prev_workload;
+	int		current_workload;
+	int		num_next;
+	struct {
+		int	next_workload;
+		int	confidence;	/* 0 .. 10000 */
+		int	boost;
+	} next[MGLRU_MARKOV_MAX_PREDICTED];
+	bool		valid;
+};
+
+struct mglru_markov_hint {
+	int		app_id;
+	int		workload_id;
+	unsigned long	last_predict_jiffies;
+	unsigned long	hits;
+	int		num_predicted;
+	int		predicted_workload[MGLRU_MARKOV_MAX_PREDICTED];
+	int		predicted_confidence[MGLRU_MARKOV_MAX_PREDICTED];
+	bool		valid;
+};
+
+struct mglru_markov_prediction {
+	unsigned long	ttl_ms;
+	unsigned long	timestamp_jiffies;
+	int		num_apps;
+	struct {
+		int	app_id;
+		int	confidence;	/* 0 .. 10000 */
+	} apps[MGLRU_MARKOV_MAX_PREDICTED];
+	bool		valid;
+};
+
+/* --- global state --------------------------------------------------- */
+
+static struct mglru_markov_app mglru_markov_apps[MGLRU_MARKOV_MAX_APPS];
+static struct mglru_markov_history mglru_markov_histories[MGLRU_MARKOV_MAX_HISTORIES];
+static struct mglru_markov_transition mglru_markov_transitions[MGLRU_MARKOV_MAX_TRANSITIONS];
+static struct mglru_markov_hint mglru_markov_hints[MGLRU_MARKOV_MAX_HINTS];
+static struct mglru_markov_prediction mglru_markov_prediction;
+static unsigned int mglru_markov_app_count;
+
+static DEFINE_SPINLOCK(mglru_workload_markov_lock);
+
+/* Statistics and prepare throttle state, all protected by the lock above. */
+static unsigned long mglru_markov_reclaim_calls;
+static unsigned long mglru_markov_prepare_calls;
+static unsigned long mglru_markov_per_folio_calls;
+static unsigned long mglru_markov_predictions;
+static unsigned long mglru_markov_throttled;
+static unsigned long mglru_markov_throttled_prepare;
+static unsigned long mglru_markov_missing_hint;
+static unsigned long mglru_markov_missing_app;
+static unsigned long mglru_markov_missing_transition;
+
+/* --- helpers -------------------------------------------------------- */
+
+static struct mglru_markov_app *mglru_markov_find_app_locked(int app_id)
+{
+	int i;
+
+	lockdep_assert_held(&mglru_workload_markov_lock);
+
+	for (i = 0; i < MGLRU_MARKOV_MAX_APPS; i++) {
+		if (mglru_markov_apps[i].valid &&
+		    mglru_markov_apps[i].app_id == app_id)
+			return &mglru_markov_apps[i];
+	}
+	return NULL;
+}
+
+static struct mglru_markov_app *mglru_markov_find_app_by_cgroup_locked(u64 cgroup_id)
+{
+	int i;
+
+	lockdep_assert_held(&mglru_workload_markov_lock);
+
+	for (i = 0; i < MGLRU_MARKOV_MAX_APPS; i++) {
+		if (mglru_markov_apps[i].valid &&
+		    mglru_markov_apps[i].cgroup_id == cgroup_id)
+			return &mglru_markov_apps[i];
+	}
+	return NULL;
+}
+
+static struct mglru_markov_app *mglru_markov_get_or_create_app_locked(
+	int app_id, u64 cgroup_id)
+{
+	struct mglru_markov_app *app;
+	int i;
+
+	lockdep_assert_held(&mglru_workload_markov_lock);
+
+	app = mglru_markov_find_app_locked(app_id);
+	if (app)
+		return app;
+
+	/* find a free slot */
+	for (i = 0; i < MGLRU_MARKOV_MAX_APPS; i++) {
+		if (!mglru_markov_apps[i].valid) {
+			app = &mglru_markov_apps[i];
+			memset(app, 0, sizeof(*app));
+			app->app_id = app_id;
+			app->cgroup_id = cgroup_id;
+			app->current_workload = -1;
+			app->prev_workload = -1;
+			app->valid = true;
+			mglru_markov_app_count++;
+			return app;
+		}
+	}
+	return NULL; /* table full */
+}
+
+static struct mglru_markov_hint *mglru_markov_get_or_create_hint_locked(
+	int app_id, int workload_id)
+{
+	struct mglru_markov_hint *hint;
+	int i;
+
+	lockdep_assert_held(&mglru_workload_markov_lock);
+
+	/* find existing */
+	for (i = 0; i < MGLRU_MARKOV_MAX_HINTS; i++) {
+		if (mglru_markov_hints[i].valid &&
+		    mglru_markov_hints[i].app_id == app_id &&
+		    mglru_markov_hints[i].workload_id == workload_id)
+			return &mglru_markov_hints[i];
+	}
+
+	/* allocate new slot */
+	for (i = 0; i < MGLRU_MARKOV_MAX_HINTS; i++) {
+		if (!mglru_markov_hints[i].valid) {
+			hint = &mglru_markov_hints[i];
+			memset(hint, 0, sizeof(*hint));
+			hint->app_id = app_id;
+			hint->workload_id = workload_id;
+			hint->valid = true;
+			return hint;
+		}
+	}
+	return NULL;
+}
+
+/* --- reclaim-cycle entry point -------------------------------------- */
+
+/*
+ * Called once before evict_folios() starts an isolation/scan batch. This
+ * function NEVER allocates memory, changes a reclaim decision, or alters
+ * folio state. It only does:
+ *   1. Lookup to find the app owning this lruvec's cgroup.
+ *   2. Lookup the Markov transition for (app, prev_wl, cur_wl).
+ *   3. Refresh an observe-only cycle hint if the throttle window elapsed.
+ *   4. Bump statistics counters.
+ */
+static void mglru_markov_apply_generation_adjustment(
+	struct lruvec *lruvec, struct scan_control *sc, const char *caller,
+	int app_id, int prev_workload, int current_workload, int num_predicted)
+{
+	/*
+	 * Future workload -> folio hint -> generation adjustment belongs here.
+	 * This version intentionally does not inspect folios, move generations,
+	 * or change any scan, isolation, aging, or reclaim result.
+	 */
+	pr_debug_ratelimited("lru_gen_workload_markov: caller=%s lruvec=%p sc=%p app=%d pwl=%d cwl=%d hint_pred=%d observe_only=1\n",
+			     caller, lruvec, sc, app_id, prev_workload,
+			     current_workload, num_predicted);
+}
+
+static void mglru_markov_prepare_reclaim(struct lruvec *lruvec,
+					 struct scan_control *sc,
+					 const char *caller)
+{
+	struct mem_cgroup *memcg = lruvec_memcg(lruvec);
+	u64 cg_id;
+	struct mglru_markov_app *app;
+	struct mglru_markov_hint *hint;
+	struct mglru_markov_transition *trans;
+	unsigned long now;
+	int app_id;
+	int prev_workload;
+	int current_workload;
+	int num_predicted;
+	int i;
+
+	if (!READ_ONCE(mglru_markov_app_count))
+		return;
+
+	if (!memcg)
+		return;
+
+	cg_id = cgroup_id(memcg->css.cgroup);
+
+	spin_lock(&mglru_workload_markov_lock);
+
+	mglru_markov_reclaim_calls++;
+	mglru_markov_prepare_calls++;
+
+	/* 1. find the app that owns this cgroup */
+	app = mglru_markov_find_app_by_cgroup_locked(cg_id);
+	if (!app) {
+		mglru_markov_missing_app++;
+		spin_unlock(&mglru_workload_markov_lock);
+		return;
+	}
+
+	if (app->current_workload < 0) {
+		mglru_markov_missing_hint++;
+		spin_unlock(&mglru_workload_markov_lock);
+		return;
+	}
+
+	/* Avoid repeating prepare for the same reclaim target in a short window. */
+	now = jiffies;
+	if (app->last_prepare_lruvec == lruvec &&
+	    time_before(now, app->last_prepare_jiffies +
+			      MGLRU_MARKOV_PREPARE_THROTTLE_JIFFIES)) {
+		mglru_markov_throttled++;
+		mglru_markov_throttled_prepare++;
+		spin_unlock(&mglru_workload_markov_lock);
+		return;
+	}
+	app->last_prepare_lruvec = lruvec;
+	app->last_prepare_jiffies = now;
+
+	/* 2. find or pre-create the hint for this app/workload */
+	hint = mglru_markov_get_or_create_hint_locked(app->app_id,
+						      app->current_workload);
+	if (!hint) {
+		mglru_markov_missing_hint++;
+		spin_unlock(&mglru_workload_markov_lock);
+		return;
+	}
+
+	hint->last_predict_jiffies = now;
+	hint->hits++;
+
+	/* 3. look up Markov transition for (app, prev_wl, cur_wl) */
+	trans = NULL;
+	for (i = 0; i < MGLRU_MARKOV_MAX_TRANSITIONS; i++) {
+		if (!mglru_markov_transitions[i].valid)
+			continue;
+		if (mglru_markov_transitions[i].app_id == app->app_id &&
+		    mglru_markov_transitions[i].prev_workload == app->prev_workload &&
+		    mglru_markov_transitions[i].current_workload == app->current_workload) {
+			trans = &mglru_markov_transitions[i];
+			break;
+		}
+	}
+
+	if (trans) {
+		/* refresh hint from transition predictions */
+		mglru_markov_predictions++;
+		hint->num_predicted = min(trans->num_next,
+					  MGLRU_MARKOV_MAX_PREDICTED);
+		for (i = 0; i < hint->num_predicted; i++) {
+			hint->predicted_workload[i] = trans->next[i].next_workload;
+			hint->predicted_confidence[i] = trans->next[i].confidence;
+		}
+	} else {
+		mglru_markov_missing_transition++;
+		hint->num_predicted = 0;
+	}
+
+	app_id = app->app_id;
+	prev_workload = app->prev_workload;
+	current_workload = app->current_workload;
+	num_predicted = hint->num_predicted;
+	spin_unlock(&mglru_workload_markov_lock);
+
+	mglru_markov_apply_generation_adjustment(lruvec, sc, caller, app_id,
+						 prev_workload,
+						 current_workload,
+						 num_predicted);
+}
+
+/* --- debugfs write helpers ------------------------------------------ */
+
+static int mglru_markov_parse_int(const char *str, int *value)
+{
+	return kstrtoint(str, 0, value);
+}
+
+static int mglru_markov_parse_u64(const char *str, u64 *value)
+{
+	return kstrtou64(str, 0, value);
+}
+
+static int mglru_markov_parse_ulong(const char *str, unsigned long *value)
+{
+	return kstrtoul(str, 0, value);
+}
+
+static int mglru_markov_handle_app_current(int argc, char **argv)
+{
+	int app_id, err;
+	u64 cgroup_id;
+	unsigned long ttl_ms;
+	struct mglru_markov_app *app;
+
+	if (argc != 3)
+		return -EINVAL;
+
+	err = mglru_markov_parse_int(argv[0], &app_id);
+	if (err)
+		return err;
+	err = mglru_markov_parse_u64(argv[1], &cgroup_id);
+	if (err)
+		return err;
+	err = mglru_markov_parse_ulong(argv[2], &ttl_ms);
+	if (err)
+		return err;
+
+	spin_lock(&mglru_workload_markov_lock);
+	app = mglru_markov_get_or_create_app_locked(app_id, cgroup_id);
+	if (!app) {
+		spin_unlock(&mglru_workload_markov_lock);
+		return -ENOSPC;
+	}
+	app->ttl_ms = ttl_ms;
+	app->last_update_jiffies = jiffies;
+	spin_unlock(&mglru_workload_markov_lock);
+	return 0;
+}
+
+static int mglru_markov_handle_app_predict(int argc, char **argv)
+{
+	unsigned long ttl_ms;
+	int err, i, num;
+
+	if (argc < 2)
+		return -EINVAL;
+
+	err = mglru_markov_parse_ulong(argv[0], &ttl_ms);
+	if (err)
+		return err;
+
+	/* remaining args come in pairs: <app_id> <confidence> */
+	num = (argc - 1) / 2;
+	if (num < 1 || num > MGLRU_MARKOV_MAX_PREDICTED)
+		return -EINVAL;
+	if ((argc - 1) % 2)
+		return -EINVAL; /* odd number of trailing args */
+
+	spin_lock(&mglru_workload_markov_lock);
+	mglru_markov_prediction.ttl_ms = ttl_ms;
+	mglru_markov_prediction.timestamp_jiffies = jiffies;
+	mglru_markov_prediction.num_apps = num;
+
+	for (i = 0; i < num; i++) {
+		int app_id, conf;
+
+		err = mglru_markov_parse_int(argv[1 + i * 2], &app_id);
+		if (err)
+			goto out_unlock;
+		err = mglru_markov_parse_int(argv[1 + i * 2 + 1], &conf);
+		if (err)
+			goto out_unlock;
+
+		mglru_markov_prediction.apps[i].app_id = app_id;
+		mglru_markov_prediction.apps[i].confidence =
+			max(0, min(10000, conf));
+	}
+	mglru_markov_prediction.valid = true;
+out_unlock:
+	spin_unlock(&mglru_workload_markov_lock);
+	return err;
+}
+
+static int mglru_markov_handle_workload_update(int argc, char **argv)
+{
+	u64 cgroup_id;
+	int app_id, workload_id, err;
+	struct mglru_markov_app *app;
+	struct mglru_markov_history *hist;
+	int i;
+
+	if (argc != 3)
+		return -EINVAL;
+
+	err = mglru_markov_parse_u64(argv[0], &cgroup_id);
+	if (err)
+		return err;
+	err = mglru_markov_parse_int(argv[1], &app_id);
+	if (err)
+		return err;
+	err = mglru_markov_parse_int(argv[2], &workload_id);
+	if (err)
+		return err;
+
+	spin_lock(&mglru_workload_markov_lock);
+
+	app = mglru_markov_get_or_create_app_locked(app_id, cgroup_id);
+	if (!app) {
+		spin_unlock(&mglru_workload_markov_lock);
+		return -ENOSPC;
+	}
+
+	/* record history: previous workload -> current workload transition */
+	app->prev_workload = app->current_workload;
+	app->current_workload = workload_id;
+	app->last_update_jiffies = jiffies;
+
+	/* add a history entry */
+	for (i = 0; i < MGLRU_MARKOV_MAX_HISTORIES; i++) {
+		if (!mglru_markov_histories[i].valid) {
+			hist = &mglru_markov_histories[i];
+			hist->app_id = app_id;
+			hist->cgroup_id = cgroup_id;
+			hist->workload_id = workload_id;
+			hist->timestamp_jiffies = jiffies;
+			hist->valid = true;
+			break;
+		}
+	}
+
+	/* pre-create hint slot */
+	mglru_markov_get_or_create_hint_locked(app_id, workload_id);
+
+	spin_unlock(&mglru_workload_markov_lock);
+	return 0;
+}
+
+static int mglru_markov_handle_markov_set(int argc, char **argv)
+{
+	int app_id, prev_wl, cur_wl;
+	int err, i, num_triples, idx;
+
+	if (argc < 3)
+		return -EINVAL;
+
+	err = mglru_markov_parse_int(argv[0], &app_id);
+	if (err) return err;
+	err = mglru_markov_parse_int(argv[1], &prev_wl);
+	if (err) return err;
+	err = mglru_markov_parse_int(argv[2], &cur_wl);
+	if (err) return err;
+
+	/* remaining args are triples: <next_wl> <conf> <boost> */
+	num_triples = (argc - 3) / 3;
+	if (num_triples < 1 || num_triples > MGLRU_MARKOV_MAX_PREDICTED)
+		return -EINVAL;
+	if ((argc - 3) % 3)
+		return -EINVAL;
+
+	spin_lock(&mglru_workload_markov_lock);
+
+	/* find or allocate a transition slot */
+	idx = -1;
+	for (i = 0; i < MGLRU_MARKOV_MAX_TRANSITIONS; i++) {
+		if (!mglru_markov_transitions[i].valid) {
+			if (idx < 0)
+				idx = i;
+		} else if (mglru_markov_transitions[i].app_id == app_id &&
+			   mglru_markov_transitions[i].prev_workload == prev_wl &&
+			   mglru_markov_transitions[i].current_workload == cur_wl) {
+			idx = i;
+			break;
+		}
+	}
+
+	if (idx < 0) {
+		spin_unlock(&mglru_workload_markov_lock);
+		return -ENOSPC;
+	}
+
+	mglru_markov_transitions[idx].app_id = app_id;
+	mglru_markov_transitions[idx].prev_workload = prev_wl;
+	mglru_markov_transitions[idx].current_workload = cur_wl;
+	mglru_markov_transitions[idx].num_next = num_triples;
+
+	for (i = 0; i < num_triples; i++) {
+		int next_wl, conf, boost;
+
+		err  = mglru_markov_parse_int(argv[3 + i * 3], &next_wl);
+		err |= mglru_markov_parse_int(argv[3 + i * 3 + 1], &conf);
+		err |= mglru_markov_parse_int(argv[3 + i * 3 + 2], &boost);
+		if (err) {
+			spin_unlock(&mglru_workload_markov_lock);
+			return err;
+		}
+
+		mglru_markov_transitions[idx].next[i].next_workload = next_wl;
+		mglru_markov_transitions[idx].next[i].confidence =
+			max(0, min(10000, conf));
+		mglru_markov_transitions[idx].next[i].boost = boost;
+	}
+	mglru_markov_transitions[idx].valid = true;
+
+	spin_unlock(&mglru_workload_markov_lock);
+	return 0;
+}
+
+static void mglru_markov_clear_all_locked(void)
+{
+	lockdep_assert_held(&mglru_workload_markov_lock);
+
+	memset(mglru_markov_apps, 0, sizeof(mglru_markov_apps));
+	memset(mglru_markov_histories, 0, sizeof(mglru_markov_histories));
+	memset(mglru_markov_transitions, 0, sizeof(mglru_markov_transitions));
+	memset(mglru_markov_hints, 0, sizeof(mglru_markov_hints));
+	memset(&mglru_markov_prediction, 0, sizeof(mglru_markov_prediction));
+	mglru_markov_app_count = 0;
+	mglru_markov_reclaim_calls = 0;
+	mglru_markov_prepare_calls = 0;
+	mglru_markov_per_folio_calls = 0;
+	mglru_markov_predictions = 0;
+	mglru_markov_throttled = 0;
+	mglru_markov_throttled_prepare = 0;
+	mglru_markov_missing_hint = 0;
+	mglru_markov_missing_app = 0;
+	mglru_markov_missing_transition = 0;
+}
+
+static void mglru_markov_clear_histories_locked(void)
+{
+	lockdep_assert_held(&mglru_workload_markov_lock);
+	memset(mglru_markov_histories, 0, sizeof(mglru_markov_histories));
+}
+
+static void mglru_markov_clear_markov_locked(void)
+{
+	lockdep_assert_held(&mglru_workload_markov_lock);
+	memset(mglru_markov_transitions, 0, sizeof(mglru_markov_transitions));
+}
+
+static void mglru_markov_clear_hints_locked(void)
+{
+	lockdep_assert_held(&mglru_workload_markov_lock);
+	memset(mglru_markov_hints, 0, sizeof(mglru_markov_hints));
+}
+
+static int mglru_workload_markov_parse_line(char *line)
+{
+	int argc = 0;
+	char *argv[16];
+	char *token;
+
+	while ((token = strsep(&line, " \t"))) {
+		if (!*token)
+			continue;
+		if (argc == ARRAY_SIZE(argv))
+			return -E2BIG;
+		argv[argc++] = token;
+	}
+
+	if (!argc)
+		return 0;
+
+	/* "app current <app_id> <cgroup_id> <ttl_ms>" */
+	if (!strcmp(argv[0], "app")) {
+		if (argc < 2)
+			return -EINVAL;
+		if (!strcmp(argv[1], "current"))
+			return mglru_markov_handle_app_current(argc - 2, argv + 2);
+		if (!strcmp(argv[1], "predict"))
+			return mglru_markov_handle_app_predict(argc - 2, argv + 2);
+		return -EINVAL;
+	}
+
+	/* "workload update <cgroup_id> <app_id> <workload_id>" */
+	if (!strcmp(argv[0], "workload")) {
+		if (argc < 3)
+			return -EINVAL;
+		if (!strcmp(argv[1], "update"))
+			return mglru_markov_handle_workload_update(argc - 2, argv + 2);
+		return -EINVAL;
+	}
+
+	/* "markov set <app_id> <prev_wl> <cur_wl> <next1> <conf1> <boost1> ..." */
+	if (!strcmp(argv[0], "markov")) {
+		if (argc < 2)
+			return -EINVAL;
+		if (!strcmp(argv[1], "set"))
+			return mglru_markov_handle_markov_set(argc - 2, argv + 2);
+		return -EINVAL;
+	}
+
+	/* "clear all|histories|markov|hints" */
+	if (!strcmp(argv[0], "clear")) {
+		if (argc != 2)
+			return -EINVAL;
+		spin_lock(&mglru_workload_markov_lock);
+		if (!strcmp(argv[1], "all"))
+			mglru_markov_clear_all_locked();
+		else if (!strcmp(argv[1], "histories"))
+			mglru_markov_clear_histories_locked();
+		else if (!strcmp(argv[1], "markov"))
+			mglru_markov_clear_markov_locked();
+		else if (!strcmp(argv[1], "hints"))
+			mglru_markov_clear_hints_locked();
+		else {
+			spin_unlock(&mglru_workload_markov_lock);
+			return -EINVAL;
+		}
+		spin_unlock(&mglru_workload_markov_lock);
+		return 0;
+	}
+
+	return -EINVAL;
+}
