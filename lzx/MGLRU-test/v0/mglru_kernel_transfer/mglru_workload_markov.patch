+{
+	return kstrtou64(str, 0, value);
+}
+
+static int mglru_markov_parse_ulong(const char *str, unsigned long *value)
+{
+	return kstrtoul(str, 0, value);
+}
+
+static int mglru_markov_parse_u32(const char *str, u32 *value)
+{
+	return kstrtou32(str, 0, value);
+}
+
+static int mglru_markov_handle_app_current(int argc, char **argv)
+{
+	int app_id, err;
+	u64 cgroup_id;
+	unsigned long ttl_ms;
+	struct mglru_markov_app *app;
+
+	if (argc != 3)
+		return -EINVAL;
+
+	err = mglru_markov_parse_int(argv[0], &app_id);
+	if (err)
+		return err;
+	err = mglru_markov_parse_u64(argv[1], &cgroup_id);
+	if (err)
+		return err;
+	err = mglru_markov_parse_ulong(argv[2], &ttl_ms);
+	if (err)
+		return err;
+
+	spin_lock(&mglru_workload_markov_lock);
+	app = mglru_markov_get_or_create_app_locked(app_id, cgroup_id);
+	if (!app) {
+		spin_unlock(&mglru_workload_markov_lock);
+		return -ENOSPC;
+	}
+	app->ttl_ms = ttl_ms;
+	app->last_update_jiffies = jiffies;
+	app->cgroup_id = cgroup_id;
+	mglru_lstm_foreground.app_id = app_id;
+	mglru_lstm_foreground.cgroup_id = cgroup_id;
+	mglru_lstm_foreground.ttl_ms = ttl_ms;
+	mglru_lstm_foreground.updated_at_jiffies = jiffies;
+	mglru_lstm_foreground.valid = true;
+	spin_unlock(&mglru_workload_markov_lock);
+	return 0;
+}
+
+static int mglru_lstm_handle_app_bind(int argc, char **argv)
+{
+	u32 app_id;
+	u64 cgroup_id;
+	unsigned long ttl_ms;
+	struct mglru_lstm_app_binding *binding = NULL;
+	int err, i, free_slot = -1;
+
+	if (argc != 3)
+		return -EINVAL;
+	err = mglru_markov_parse_u32(argv[0], &app_id);
+	if (err || !app_id)
+		return err ?: -EINVAL;
+	err = mglru_markov_parse_u64(argv[1], &cgroup_id);
+	if (err || !cgroup_id)
+		return err ?: -EINVAL;
+	err = mglru_markov_parse_ulong(argv[2], &ttl_ms);
+	if (err || !ttl_ms)
+		return err ?: -EINVAL;
+
+	spin_lock(&mglru_workload_markov_lock);
+	for (i = 0; i < MGLRU_LSTM_MAX_BINDINGS; i++) {
+		if (!mglru_lstm_bindings[i].valid && free_slot < 0)
+			free_slot = i;
+		if (mglru_lstm_bindings[i].valid &&
+		    mglru_lstm_bindings[i].cgroup_id == cgroup_id) {
+			binding = &mglru_lstm_bindings[i];
+			break;
+		}
+	}
+	if (!binding && free_slot >= 0)
+		binding = &mglru_lstm_bindings[free_slot];
+	if (!binding) {
+		spin_unlock(&mglru_workload_markov_lock);
+		return -ENOSPC;
+	}
+	binding->app_id = app_id;
+	binding->cgroup_id = cgroup_id;
+	binding->ttl_ms = ttl_ms;
+	binding->updated_at_jiffies = jiffies;
+	binding->valid = true;
+	spin_unlock(&mglru_workload_markov_lock);
+	return 0;
+}
+
+static int mglru_lstm_handle_app_probability(int argc, char **argv)
+{
+	u32 app_id, value;
+	unsigned long ttl_ms;
+	struct mglru_lstm_app_probability *probability = NULL;
+	int err, i, free_slot = -1;
+
+	if (argc != 3)
+		return -EINVAL;
+	err = mglru_markov_parse_u32(argv[0], &app_id);
+	if (err || !app_id)
+		return err ?: -EINVAL;
+	err = mglru_markov_parse_u32(argv[1], &value);
+	if (err || value > 10000)
+		return err ?: -EINVAL;
+	err = mglru_markov_parse_ulong(argv[2], &ttl_ms);
+	if (err || !ttl_ms)
+		return err ?: -EINVAL;
+
+	spin_lock(&mglru_workload_markov_lock);
+	probability = mglru_lstm_find_probability_locked(app_id);
+	if (!probability) {
+		for (i = 0; i < MGLRU_LSTM_MAX_PROBABILITIES; i++) {
+			if (!mglru_lstm_probabilities[i].valid) {
+				free_slot = i;
+				break;
+			}
+		}
+		if (free_slot >= 0)
+			probability = &mglru_lstm_probabilities[free_slot];
+	}
+	if (!probability) {
+		spin_unlock(&mglru_workload_markov_lock);
+		return -ENOSPC;
+	}
+	probability->app_id = app_id;
+	probability->probability = value;
+	probability->ttl_ms = ttl_ms;
+	probability->updated_at_jiffies = jiffies;
+	probability->valid = true;
+	spin_unlock(&mglru_workload_markov_lock);
+	return 0;
+}
+
+static int mglru_lstm_commit_policy_config(
+	const struct mglru_lstm_policy_config *candidate)
+{
+	if (!mglru_lstm_validate_config(candidate))
+		return -EINVAL;
+	spin_lock(&mglru_workload_markov_lock);
+	mglru_lstm_config = *candidate;
+	spin_unlock(&mglru_workload_markov_lock);
+	return 0;
+}
+
+static void mglru_lstm_copy_policy_config(struct mglru_lstm_policy_config *config)
+{
+	spin_lock(&mglru_workload_markov_lock);
+	*config = mglru_lstm_config;
+	spin_unlock(&mglru_workload_markov_lock);
+}
+
+static int mglru_lstm_handle_policy_mode(int argc, char **argv)
+{
+	struct mglru_lstm_policy_config candidate;
+
+	if (argc != 1)
+		return -EINVAL;
+	mglru_lstm_copy_policy_config(&candidate);
+	if (!strcmp(argv[0], "disabled"))
+		candidate.mode = MGLRU_LSTM_POLICY_DISABLED;
+	else if (!strcmp(argv[0], "observe"))
+		candidate.mode = MGLRU_LSTM_POLICY_OBSERVE;
+	else if (!strcmp(argv[0], "apply"))
+		candidate.mode = MGLRU_LSTM_POLICY_APPLY;
+	else
+		return -EINVAL;
+	return mglru_lstm_commit_policy_config(&candidate);
+}
+
+static int mglru_lstm_handle_policy_threshold(int argc, char **argv)
+{
+	struct mglru_lstm_policy_config candidate;
+	int err;
+
+	if (argc != 3)
+		return -EINVAL;
+	mglru_lstm_copy_policy_config(&candidate);
+	err = mglru_markov_parse_u32(argv[0], &candidate.high_threshold);
+	err |= mglru_markov_parse_u32(argv[1], &candidate.neutral_threshold);
+	err |= mglru_markov_parse_u32(argv[2], &candidate.low_threshold);
+	if (err)
+		return err;
+	return mglru_lstm_commit_policy_config(&candidate);
+}
+
+static int mglru_lstm_handle_policy_factor(int argc, char **argv)
+{
+	struct mglru_lstm_policy_config candidate;
+	int err;
+
+	if (argc != 5)
+		return -EINVAL;
+	mglru_lstm_copy_policy_config(&candidate);
+	err = mglru_markov_parse_u32(argv[0], &candidate.foreground_factor);
+	err |= mglru_markov_parse_u32(argv[1], &candidate.high_factor);
+	err |= mglru_markov_parse_u32(argv[2], &candidate.neutral_factor);
+	err |= mglru_markov_parse_u32(argv[3], &candidate.low_factor);
+	err |= mglru_markov_parse_u32(argv[4], &candidate.very_low_factor);
+	if (err)
+		return err;
+	return mglru_lstm_commit_policy_config(&candidate);
+}
+
+static int mglru_lstm_handle_policy_bounds(int argc, char **argv)
+{
+	struct mglru_lstm_policy_config candidate;
+	int err;
+
+	if (argc != 4)
+		return -EINVAL;
+	mglru_lstm_copy_policy_config(&candidate);
+	err = mglru_markov_parse_u32(argv[0], &candidate.minimum_factor);
+	err |= mglru_markov_parse_u32(argv[1], &candidate.maximum_factor);
+	err |= mglru_markov_parse_u32(argv[2], &candidate.minimum_scan_pages);
+	err |= mglru_markov_parse_u32(argv[3], &candidate.maximum_extra_pages);
+	if (err)
+		return err;
+	return mglru_lstm_commit_policy_config(&candidate);
+}
+
+static int mglru_lstm_handle_policy_default(int argc, char **argv)
+{
+	struct mglru_lstm_policy_config candidate;
+	int err;
+
+	if (argc != 4)
+		return -EINVAL;
+	mglru_lstm_copy_policy_config(&candidate);
+	err = mglru_markov_parse_u32(argv[0], &candidate.missing_probability);
+	err |= mglru_markov_parse_u32(argv[1], &candidate.unknown_factor);
+	err |= mglru_markov_parse_u32(argv[2], &candidate.expired_factor);
+	err |= mglru_markov_parse_u32(argv[3], &candidate.markov_min_probability);
+	if (err)
+		return err;
+	return mglru_lstm_commit_policy_config(&candidate);
+}
+
+static int mglru_markov_handle_app_predict(int argc, char **argv)
+{
+	unsigned long ttl_ms;
+	int err, i, num;
+
+	if (argc < 2)
+		return -EINVAL;
+
+	err = mglru_markov_parse_ulong(argv[0], &ttl_ms);
+	if (err)
+		return err;
+
+	/* remaining args come in pairs: <app_id> <confidence> */
+	num = (argc - 1) / 2;
+	if (num < 1 || num > MGLRU_MARKOV_MAX_PREDICTED)
+		return -EINVAL;
+	if ((argc - 1) % 2)
+		return -EINVAL; /* odd number of trailing args */
+
+	spin_lock(&mglru_workload_markov_lock);
+	mglru_markov_prediction.ttl_ms = ttl_ms;
+	mglru_markov_prediction.timestamp_jiffies = jiffies;
+	mglru_markov_prediction.num_apps = num;
+
+	for (i = 0; i < num; i++) {
+		int app_id, conf;
+
+		err = mglru_markov_parse_int(argv[1 + i * 2], &app_id);
+		if (err)
+			goto out_unlock;
+		err = mglru_markov_parse_int(argv[1 + i * 2 + 1], &conf);
+		if (err)
+			goto out_unlock;
+
+		mglru_markov_prediction.apps[i].app_id = app_id;
+		mglru_markov_prediction.apps[i].confidence =
+			max(0, min(10000, conf));
+	}
+	mglru_markov_prediction.valid = true;
+out_unlock:
+	spin_unlock(&mglru_workload_markov_lock);
+	return err;
+}
+
+static int mglru_markov_handle_workload_update(int argc, char **argv)
+{
+	u64 cgroup_id;
+	int app_id, workload_id, err;
+	struct mglru_markov_app *app;
+	struct mglru_markov_history *hist;
+	int i;
+
+	if (argc != 3)
+		return -EINVAL;
+
+	err = mglru_markov_parse_u64(argv[0], &cgroup_id);
+	if (err)
+		return err;
+	err = mglru_markov_parse_int(argv[1], &app_id);
+	if (err)
+		return err;
+	err = mglru_markov_parse_int(argv[2], &workload_id);
+	if (err)
+		return err;
+
+	spin_lock(&mglru_workload_markov_lock);
+
+	app = mglru_markov_get_or_create_app_locked(app_id, cgroup_id);
+	if (!app) {
+		spin_unlock(&mglru_workload_markov_lock);
+		return -ENOSPC;
+	}
+
+	/* record history: previous workload -> current workload transition */
+	app->prev_workload = app->current_workload;
+	app->current_workload = workload_id;
+	app->last_update_jiffies = jiffies;
+
+	/* add a history entry */
+	for (i = 0; i < MGLRU_MARKOV_MAX_HISTORIES; i++) {
+		if (!mglru_markov_histories[i].valid) {
+			hist = &mglru_markov_histories[i];
+			hist->app_id = app_id;
+			hist->cgroup_id = cgroup_id;
+			hist->workload_id = workload_id;
+			hist->timestamp_jiffies = jiffies;
+			hist->valid = true;
+			break;
+		}
+	}
+
+	/* pre-create hint slot */
+	mglru_markov_get_or_create_hint_locked(app_id, workload_id);
+
+	spin_unlock(&mglru_workload_markov_lock);
+	return 0;
+}
+
+static int mglru_markov_handle_markov_set(int argc, char **argv)
+{
+	int app_id, prev_wl, cur_wl;
+	int err, i, num_triples, idx;
+
+	if (argc < 3)
+		return -EINVAL;
+
+	err = mglru_markov_parse_int(argv[0], &app_id);
+	if (err) return err;
+	err = mglru_markov_parse_int(argv[1], &prev_wl);
+	if (err) return err;
+	err = mglru_markov_parse_int(argv[2], &cur_wl);
+	if (err) return err;
+
+	/* remaining args are triples: <next_wl> <conf> <boost> */
+	num_triples = (argc - 3) / 3;
+	if (num_triples < 1 || num_triples > MGLRU_MARKOV_MAX_PREDICTED)
+		return -EINVAL;
+	if ((argc - 3) % 3)
+		return -EINVAL;
+
+	spin_lock(&mglru_workload_markov_lock);
+
+	/* find or allocate a transition slot */
+	idx = -1;
+	for (i = 0; i < MGLRU_MARKOV_MAX_TRANSITIONS; i++) {
+		if (!mglru_markov_transitions[i].valid) {
+			if (idx < 0)
+				idx = i;
+		} else if (mglru_markov_transitions[i].app_id == app_id &&
+			   mglru_markov_transitions[i].prev_workload == prev_wl &&
+			   mglru_markov_transitions[i].current_workload == cur_wl) {
+			idx = i;
+			break;
+		}
+	}
+
+	if (idx < 0) {
+		spin_unlock(&mglru_workload_markov_lock);
+		return -ENOSPC;
+	}
+
+	mglru_markov_transitions[idx].app_id = app_id;
+	mglru_markov_transitions[idx].prev_workload = prev_wl;
+	mglru_markov_transitions[idx].current_workload = cur_wl;
+	mglru_markov_transitions[idx].num_next = num_triples;
+
+	for (i = 0; i < num_triples; i++) {
+		int next_wl, conf, boost;
+
+		err  = mglru_markov_parse_int(argv[3 + i * 3], &next_wl);
+		err |= mglru_markov_parse_int(argv[3 + i * 3 + 1], &conf);
+		err |= mglru_markov_parse_int(argv[3 + i * 3 + 2], &boost);
+		if (err) {
+			spin_unlock(&mglru_workload_markov_lock);
+			return err;
+		}
+
+		mglru_markov_transitions[idx].next[i].next_workload = next_wl;
+		mglru_markov_transitions[idx].next[i].confidence =
+			max(0, min(10000, conf));
+		mglru_markov_transitions[idx].next[i].boost = boost;
+	}
+	mglru_markov_transitions[idx].valid = true;
+
+	spin_unlock(&mglru_workload_markov_lock);
+	return 0;
+}
+
+static void mglru_markov_clear_all_locked(void)
+{
+	lockdep_assert_held(&mglru_workload_markov_lock);
+
+	memset(mglru_markov_apps, 0, sizeof(mglru_markov_apps));
+	memset(mglru_markov_histories, 0, sizeof(mglru_markov_histories));
+	memset(mglru_markov_transitions, 0, sizeof(mglru_markov_transitions));
+	memset(mglru_markov_hints, 0, sizeof(mglru_markov_hints));
+	memset(&mglru_markov_prediction, 0, sizeof(mglru_markov_prediction));
+	memset(mglru_lstm_bindings, 0, sizeof(mglru_lstm_bindings));
+	memset(mglru_lstm_probabilities, 0, sizeof(mglru_lstm_probabilities));
+	memset(&mglru_lstm_foreground, 0, sizeof(mglru_lstm_foreground));
+	mglru_markov_app_count = 0;
+	mglru_markov_reclaim_calls = 0;
+	mglru_markov_prepare_calls = 0;
+	mglru_markov_per_folio_calls = 0;
