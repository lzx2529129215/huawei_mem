+/* --- debugfs file_operations ---------------------------------------- */
+
+static ssize_t mglru_workload_markov_write(struct file *file,
+					   const char __user *src,
+					   size_t len, loff_t *pos)
+{
+	void *buf;
+	char *cur, *next;
+	int err = 0;
+
+	if (!len)
+		return 0;
+	if (len > SZ_64K)
+		return -E2BIG;
+
+	buf = kvmalloc(len + 1, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	if (copy_from_user(buf, src, len)) {
+		err = -EFAULT;
+		goto done;
+	}
+
+	next = buf;
+	next[len] = '\0';
+
+	while ((cur = strsep(&next, ",;\n"))) {
+		cur = strim(cur);
+		if (!*cur)
+			continue;
+
+		err = mglru_workload_markov_parse_line(cur);
+		if (err)
+			break;
+	}
+done:
+	kvfree(buf);
+
+	return err ?: len;
+}
+
+static int mglru_workload_markov_show(struct seq_file *m, void *v)
+{
+	int i, j;
+
+	spin_lock(&mglru_workload_markov_lock);
+
+	/* --- header & commands --- */
+	seq_puts(m, "# commands:\n");
+	seq_puts(m, "#   app current <app_id> <cgroup_id> <ttl_ms>\n");
+	seq_puts(m, "#   app predict <ttl_ms> <app_id1> <conf1> [<app_id2> <conf2> ...]\n");
+	seq_puts(m, "#   workload update <cgroup_id> <app_id> <workload_id>\n");
+	seq_puts(m, "#   markov set <app_id> <prev_workload> <current_workload> <next1> <conf1> <boost1> [...]\n");
+	seq_puts(m, "#   clear all|histories|markov|hints\n");
+	seq_puts(m, "\n");
+
+	/* --- current app states --- */
+	seq_puts(m, "# current app state\n");
+	seq_puts(m, "# app_id cgroup_id current_workload prev_workload ttl_ms\n");
+	for (i = 0; i < MGLRU_MARKOV_MAX_APPS; i++) {
+		if (!mglru_markov_apps[i].valid)
+			continue;
+		seq_printf(m, "app %d %llu %d %d %lu\n",
+			   mglru_markov_apps[i].app_id,
+			   mglru_markov_apps[i].cgroup_id,
+			   mglru_markov_apps[i].current_workload,
+			   mglru_markov_apps[i].prev_workload,
+			   mglru_markov_apps[i].ttl_ms);
+	}
+	seq_puts(m, "\n");
+
+	/* --- predicted apps --- */
+	seq_puts(m, "# predicted apps\n");
+	if (mglru_markov_prediction.valid) {
+		seq_printf(m, "# ttl_ms=%lu num=%d\n",
+			   mglru_markov_prediction.ttl_ms,
+			   mglru_markov_prediction.num_apps);
+		seq_puts(m, "# app_id confidence\n");
+		for (i = 0; i < mglru_markov_prediction.num_apps; i++) {
+			seq_printf(m, "pred %d %d\n",
+				   mglru_markov_prediction.apps[i].app_id,
+				   mglru_markov_prediction.apps[i].confidence);
+		}
+	} else {
+		seq_puts(m, "# (none)\n");
+	}
+	seq_puts(m, "\n");
+
+	/* --- workload histories --- */
+	seq_puts(m, "# workload histories\n");
+	seq_puts(m, "# app_id cgroup_id workload_id\n");
+	for (i = 0; i < MGLRU_MARKOV_MAX_HISTORIES; i++) {
+		if (!mglru_markov_histories[i].valid)
+			continue;
+		seq_printf(m, "hist %d %llu %d\n",
+			   mglru_markov_histories[i].app_id,
+			   mglru_markov_histories[i].cgroup_id,
+			   mglru_markov_histories[i].workload_id);
+	}
+	seq_puts(m, "\n");
+
+	/* --- Markov transition entries --- */
+	seq_puts(m, "# Markov transitions\n");
+	seq_puts(m, "# app_id prev_workload current_workload -> next_workload confidence boost ...\n");
+	for (i = 0; i < MGLRU_MARKOV_MAX_TRANSITIONS; i++) {
+		if (!mglru_markov_transitions[i].valid)
+			continue;
+		seq_printf(m, "markov %d %d %d",
+			   mglru_markov_transitions[i].app_id,
+			   mglru_markov_transitions[i].prev_workload,
+			   mglru_markov_transitions[i].current_workload);
+		for (j = 0; j < mglru_markov_transitions[i].num_next; j++) {
+			seq_printf(m, " %d %d %d",
+				   mglru_markov_transitions[i].next[j].next_workload,
+				   mglru_markov_transitions[i].next[j].confidence,
+				   mglru_markov_transitions[i].next[j].boost);
+		}
+		seq_putc(m, '\n');
+	}
+	seq_puts(m, "\n");
+
+	/* --- reclaim hints --- */
+	seq_puts(m, "# reclaim hints\n");
+	seq_puts(m, "# app_id workload_id hits last_predict_jiffies num_predicted [wl:conf ...]\n");
+	for (i = 0; i < MGLRU_MARKOV_MAX_HINTS; i++) {
+		if (!mglru_markov_hints[i].valid)
+			continue;
+		seq_printf(m, "hint %d %d %lu %lu %d",
+			   mglru_markov_hints[i].app_id,
+			   mglru_markov_hints[i].workload_id,
+			   mglru_markov_hints[i].hits,
+			   mglru_markov_hints[i].last_predict_jiffies,
+			   mglru_markov_hints[i].num_predicted);
+		for (j = 0; j < mglru_markov_hints[i].num_predicted; j++) {
+			seq_printf(m, " %d %d",
+				   mglru_markov_hints[i].predicted_workload[j],
+				   mglru_markov_hints[i].predicted_confidence[j]);
+		}
+		seq_putc(m, '\n');
+	}
+	seq_puts(m, "\n");
+
+	/* --- statistics --- */
+	seq_puts(m, "# reclaim path statistics\n");
+	seq_printf(m, "stat reclaim_calls      %lu\n", mglru_markov_reclaim_calls);
+	seq_printf(m, "stat prepare_calls      %lu\n", mglru_markov_prepare_calls);
+	seq_printf(m, "stat per_folio_calls    %lu\n", mglru_markov_per_folio_calls);
+	seq_printf(m, "stat predictions        %lu\n", mglru_markov_predictions);
+	seq_printf(m, "stat throttled          %lu\n", mglru_markov_throttled);
+	seq_printf(m, "stat throttled_prepare  %lu\n", mglru_markov_throttled_prepare);
+	seq_printf(m, "stat missing_hint       %lu\n", mglru_markov_missing_hint);
+	seq_printf(m, "stat missing_app        %lu\n", mglru_markov_missing_app);
+	seq_printf(m, "stat missing_transition %lu\n", mglru_markov_missing_transition);
+
+	spin_unlock(&mglru_workload_markov_lock);
+	return 0;
+}
+
+static int mglru_workload_markov_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, mglru_workload_markov_show, NULL);
+}
+
+static const struct file_operations mglru_workload_markov_fops = {
+	.open		= mglru_workload_markov_open,
+	.read		= seq_read,
+	.write		= mglru_workload_markov_write,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
