--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -61,0 +62,2 @@
+#include <linux/cgroup.h>
+#include <linux/math64.h>
@@ -3845,0 +3848,1566 @@
+/******************************************************************************
+ *                MGLRU workload Markov observe-only MVP
+ *
+ * Provides /sys/kernel/debug/lru_gen_workload_markov, a debugfs interface
+ * that lets userspace feed app/workload state and Markov transition tables
+ * into the kernel. Before each MGLRU eviction batch, the kernel looks up the
+ * current app (by cgroup id), finds the matching Markov transition, and
+ * refreshes a cycle-level reclaim hint. It is purely observe-only: it never
+ * changes any reclaim decision, generation, or folio placement, and it is
+ * never called from a per-folio path.
+ ******************************************************************************/
+
+#define MGLRU_MARKOV_MAX_APPS		16
+#define MGLRU_MARKOV_MAX_PREDICTED	 4
+#define MGLRU_MARKOV_MAX_HISTORIES	64
+#define MGLRU_MARKOV_MAX_TRANSITIONS	128
+#define MGLRU_MARKOV_MAX_HINTS		64
+#define MGLRU_LSTM_MAX_BINDINGS		32
+#define MGLRU_LSTM_MAX_PROBABILITIES	32
+#define MGLRU_LSTM_MIN_SAFE_FACTOR	100
+#define MGLRU_LSTM_MAX_SAFE_FACTOR	2000
+#define MGLRU_LSTM_MAX_SCAN_BOUND	(1U << 20)
+
+/* Limit observe-only prepare work for the same reclaim target to once per 50ms. */
+#define MGLRU_MARKOV_PREPARE_THROTTLE_JIFFIES	msecs_to_jiffies(50)
+
+/* --- data structures ------------------------------------------------ */
+
+struct mglru_markov_app {
+	int		app_id;
+	u64		cgroup_id;
+	int		current_workload;
+	int		prev_workload;		/* workload before current */
+	unsigned long	ttl_ms;
+	unsigned long	last_update_jiffies;
+	unsigned long	last_prepare_jiffies;
+	const struct lruvec *last_prepare_lruvec;
+	bool		valid;
+};
+
+struct mglru_markov_history {
+	int		app_id;
+	u64		cgroup_id;
+	int		workload_id;
+	unsigned long	timestamp_jiffies;
+	bool		valid;
+};
+
+struct mglru_markov_transition {
+	int		app_id;
+	int		prev_workload;
+	int		current_workload;
+	int		num_next;
+	struct {
+		int	next_workload;
+		int	confidence;	/* 0 .. 10000 */
+		int	boost;
+	} next[MGLRU_MARKOV_MAX_PREDICTED];
+	bool		valid;
+};
+
+struct mglru_markov_hint {
+	int		app_id;
+	int		workload_id;
+	unsigned long	last_predict_jiffies;
+	unsigned long	hits;
+	int		num_predicted;
+	int		predicted_workload[MGLRU_MARKOV_MAX_PREDICTED];
+	int		predicted_confidence[MGLRU_MARKOV_MAX_PREDICTED];
+	bool		valid;
+};
+
+struct mglru_markov_prediction {
+	unsigned long	ttl_ms;
+	unsigned long	timestamp_jiffies;
+	int		num_apps;
+	struct {
+		int	app_id;
+		int	confidence;	/* 0 .. 10000 */
+	} apps[MGLRU_MARKOV_MAX_PREDICTED];
+	bool		valid;
+};
+
+enum mglru_lstm_policy_mode {
+	MGLRU_LSTM_POLICY_DISABLED = 0,
+	MGLRU_LSTM_POLICY_OBSERVE,
+	MGLRU_LSTM_POLICY_APPLY,
+};
+
+enum mglru_lstm_probability_bucket {
+	MGLRU_LSTM_BUCKET_FOREGROUND = 0,
+	MGLRU_LSTM_BUCKET_HIGH,
+	MGLRU_LSTM_BUCKET_NEUTRAL,
+	MGLRU_LSTM_BUCKET_LOW,
+	MGLRU_LSTM_BUCKET_VERY_LOW,
+	MGLRU_LSTM_BUCKET_MISSING,
+	MGLRU_LSTM_BUCKET_EXPIRED,
+	MGLRU_LSTM_BUCKET_UNKNOWN,
+};
+
+struct mglru_lstm_app_binding {
+	u64		cgroup_id;
+	u32		app_id;
+	unsigned long	ttl_ms;
+	unsigned long	updated_at_jiffies;
+	bool		valid;
+};
+
+struct mglru_lstm_app_probability {
+	u32		app_id;
+	u32		probability;	/* 0 .. 10000 */
+	unsigned long	ttl_ms;
+	unsigned long	updated_at_jiffies;
+	bool		valid;
+};
+
+struct mglru_lstm_foreground_app {
+	u32		app_id;
+	u64		cgroup_id;
+	unsigned long	ttl_ms;
+	unsigned long	updated_at_jiffies;
+	bool		valid;
+};
+
+struct mglru_lstm_policy_config {
+	enum mglru_lstm_policy_mode mode;
+	u32 foreground_factor;
+	u32 high_threshold;
+	u32 neutral_threshold;
+	u32 low_threshold;
+	u32 high_factor;
+	u32 neutral_factor;
+	u32 low_factor;
+	u32 very_low_factor;
+	u32 minimum_factor;
+	u32 maximum_factor;
+	u32 missing_probability;
+	u32 unknown_factor;
+	u32 expired_factor;
+	u32 minimum_scan_pages;
+	u32 maximum_extra_pages;
+	u32 markov_min_probability;
+};
+
+struct mglru_lstm_reclaim_policy {
+	bool valid;
+	bool is_foreground;
+	bool prediction_found;
+	bool prediction_expired;
+	u32 app_id;
+	u64 cgroup_id;
+	u32 probability;
+	u32 scan_factor;
+	enum mglru_lstm_probability_bucket bucket;
+	enum mglru_lstm_policy_mode mode;
+	u32 minimum_scan_pages;
+	u32 maximum_extra_pages;
+	u64 prepared_at_ns;
+};
+
+/* --- global state --------------------------------------------------- */
+
+static struct mglru_markov_app mglru_markov_apps[MGLRU_MARKOV_MAX_APPS];
+static struct mglru_markov_history mglru_markov_histories[MGLRU_MARKOV_MAX_HISTORIES];
+static struct mglru_markov_transition mglru_markov_transitions[MGLRU_MARKOV_MAX_TRANSITIONS];
+static struct mglru_markov_hint mglru_markov_hints[MGLRU_MARKOV_MAX_HINTS];
+static struct mglru_markov_prediction mglru_markov_prediction;
+static struct mglru_lstm_app_binding mglru_lstm_bindings[MGLRU_LSTM_MAX_BINDINGS];
+static struct mglru_lstm_app_probability mglru_lstm_probabilities[MGLRU_LSTM_MAX_PROBABILITIES];
+static struct mglru_lstm_foreground_app mglru_lstm_foreground;
+static struct mglru_lstm_policy_config mglru_lstm_config = {
+	.mode = MGLRU_LSTM_POLICY_OBSERVE,
+	.foreground_factor = 700,
+	.high_threshold = 9000,
+	.neutral_threshold = 5000,
+	.low_threshold = 2000,
+	.high_factor = 750,
+	.neutral_factor = 1000,
+	.low_factor = 1100,
+	.very_low_factor = 1250,
+	.minimum_factor = 700,
+	.maximum_factor = 1300,
+	.missing_probability = 3000,
+	.unknown_factor = 1000,
+	.expired_factor = 1000,
+	.minimum_scan_pages = 1,
+	.maximum_extra_pages = 4096,
+	.markov_min_probability = 0,
+};
+static unsigned int mglru_markov_app_count;
+
+static DEFINE_SPINLOCK(mglru_workload_markov_lock);
+
+/* Statistics and prepare throttle state, all protected by the lock above. */
+static unsigned long mglru_markov_reclaim_calls;
+static unsigned long mglru_markov_prepare_calls;
+static unsigned long mglru_markov_per_folio_calls;
+static unsigned long mglru_markov_predictions;
+static unsigned long mglru_markov_throttled;
+static unsigned long mglru_markov_throttled_prepare;
+static unsigned long mglru_markov_missing_hint;
+static unsigned long mglru_markov_missing_app;
+static unsigned long mglru_markov_missing_transition;
+static unsigned long mglru_lstm_app_policy_prepare_calls;
+static unsigned long mglru_lstm_app_policy_disabled;
+static unsigned long mglru_lstm_app_policy_observe;
+static unsigned long mglru_lstm_app_policy_apply;
+static unsigned long mglru_lstm_target_cgroup_seen;
+static u64 mglru_lstm_target_cgroup_id_last;
+static unsigned long mglru_lstm_target_root_memcg;
+static unsigned long mglru_lstm_target_app_lookup_hit;
+static unsigned long mglru_lstm_target_app_lookup_miss;
+static unsigned long mglru_lstm_target_unbound_memcg;
+static unsigned long mglru_lstm_target_foreground_match;
+static unsigned long mglru_lstm_target_foreground_cgroup_mismatch;
+static unsigned long mglru_lstm_probability_lookup_hit;
+static unsigned long mglru_lstm_probability_lookup_miss;
+static unsigned long mglru_lstm_probability_expired;
+static unsigned long mglru_lstm_bucket_counts[MGLRU_LSTM_BUCKET_UNKNOWN + 1];
+static unsigned long mglru_lstm_original_scan_pages;
+static unsigned long mglru_lstm_proposed_scan_pages;
+static unsigned long mglru_lstm_applied_scan_pages;
+static unsigned long mglru_lstm_proposed_scan_reduction_pages;
+static unsigned long mglru_lstm_proposed_scan_increase_pages;
+static unsigned long mglru_lstm_scan_factor_clamped;
+static unsigned long mglru_lstm_scan_extra_pages_capped;
+static unsigned long mglru_lstm_markov_allowed_by_probability;
+static unsigned long mglru_lstm_markov_below_probability_threshold;
+static unsigned long mglru_lstm_markov_target_app_mismatch;
+
+/* --- helpers -------------------------------------------------------- */
+
+static struct mglru_markov_app *mglru_markov_find_app_locked(int app_id)
+{
+	int i;
+
+	lockdep_assert_held(&mglru_workload_markov_lock);
+
+	for (i = 0; i < MGLRU_MARKOV_MAX_APPS; i++) {
+		if (mglru_markov_apps[i].valid &&
+		    mglru_markov_apps[i].app_id == app_id)
+			return &mglru_markov_apps[i];
+	}
+	return NULL;
+}
+
+static struct mglru_markov_app *mglru_markov_find_app_by_cgroup_locked(u64 cgroup_id)
+{
+	int i;
+
+	lockdep_assert_held(&mglru_workload_markov_lock);
+
+	for (i = 0; i < MGLRU_MARKOV_MAX_APPS; i++) {
+		if (mglru_markov_apps[i].valid &&
+		    mglru_markov_apps[i].cgroup_id == cgroup_id)
+			return &mglru_markov_apps[i];
+	}
+	return NULL;
+}
+
+static bool mglru_lstm_entry_expired(unsigned long updated_at,
+				     unsigned long ttl_ms,
+				     unsigned long now)
+{
+	return !ttl_ms || time_after(now, updated_at + msecs_to_jiffies(ttl_ms));
+}
+
+static struct mglru_lstm_app_binding *mglru_lstm_find_binding_locked(u64 cgroup_id)
+{
+	int i;
+
+	lockdep_assert_held(&mglru_workload_markov_lock);
+	for (i = 0; i < MGLRU_LSTM_MAX_BINDINGS; i++) {
+		if (mglru_lstm_bindings[i].valid &&
+		    mglru_lstm_bindings[i].cgroup_id == cgroup_id)
+			return &mglru_lstm_bindings[i];
+	}
+	return NULL;
+}
+
+static struct mglru_lstm_app_probability *
+mglru_lstm_find_probability_locked(u32 app_id)
+{
+	int i;
+
+	lockdep_assert_held(&mglru_workload_markov_lock);
+	for (i = 0; i < MGLRU_LSTM_MAX_PROBABILITIES; i++) {
+		if (mglru_lstm_probabilities[i].valid &&
+		    mglru_lstm_probabilities[i].app_id == app_id)
+			return &mglru_lstm_probabilities[i];
+	}
+	return NULL;
+}
+
+static u32 mglru_lstm_factor_for_probability_locked(u32 probability)
+{
+	lockdep_assert_held(&mglru_workload_markov_lock);
+	if (probability >= mglru_lstm_config.high_threshold)
+		return mglru_lstm_config.high_factor;
+	if (probability >= mglru_lstm_config.neutral_threshold)
+		return mglru_lstm_config.neutral_factor;
+	if (probability >= mglru_lstm_config.low_threshold)
+		return mglru_lstm_config.low_factor;
+	return mglru_lstm_config.very_low_factor;
+}
+
+static enum mglru_lstm_probability_bucket
+mglru_lstm_bucket_for_probability_locked(u32 probability)
+{
+	lockdep_assert_held(&mglru_workload_markov_lock);
+	if (probability >= mglru_lstm_config.high_threshold)
+		return MGLRU_LSTM_BUCKET_HIGH;
+	if (probability >= mglru_lstm_config.neutral_threshold)
+		return MGLRU_LSTM_BUCKET_NEUTRAL;
+	if (probability >= mglru_lstm_config.low_threshold)
+		return MGLRU_LSTM_BUCKET_LOW;
+	return MGLRU_LSTM_BUCKET_VERY_LOW;
+}
+
+static bool mglru_lstm_validate_config(const struct mglru_lstm_policy_config *config)
+{
+	u32 factors[] = {
+		config->foreground_factor,
+		config->high_factor,
+		config->neutral_factor,
+		config->low_factor,
+		config->very_low_factor,
+		config->minimum_factor,
+		config->maximum_factor,
+		config->unknown_factor,
+		config->expired_factor,
+	};
+	int i;
+
+	if (config->mode > MGLRU_LSTM_POLICY_APPLY)
+		return false;
+	if (config->high_threshold > 10000 ||
+	    config->high_threshold < config->neutral_threshold ||
+	    config->neutral_threshold < config->low_threshold)
+		return false;
+	for (i = 0; i < ARRAY_SIZE(factors); i++) {
+		if (factors[i] < MGLRU_LSTM_MIN_SAFE_FACTOR ||
+		    factors[i] > MGLRU_LSTM_MAX_SAFE_FACTOR)
+			return false;
+	}
+	if (config->minimum_factor > config->maximum_factor)
+		return false;
+	if (config->missing_probability > 10000 ||
+	    config->markov_min_probability > 10000)
+		return false;
+	if (config->minimum_scan_pages > MGLRU_LSTM_MAX_SCAN_BOUND ||
+	    config->maximum_extra_pages > MGLRU_LSTM_MAX_SCAN_BOUND)
+		return false;
+	return true;
+}
+
+static struct mglru_markov_app *mglru_markov_get_or_create_app_locked(
+	int app_id, u64 cgroup_id)
+{
+	struct mglru_markov_app *app;
+	int i;
+
+	lockdep_assert_held(&mglru_workload_markov_lock);
+
+	app = mglru_markov_find_app_locked(app_id);
+	if (app)
+		return app;
+
+	/* find a free slot */
+	for (i = 0; i < MGLRU_MARKOV_MAX_APPS; i++) {
+		if (!mglru_markov_apps[i].valid) {
+			app = &mglru_markov_apps[i];
+			memset(app, 0, sizeof(*app));
+			app->app_id = app_id;
+			app->cgroup_id = cgroup_id;
+			app->current_workload = -1;
+			app->prev_workload = -1;
+			app->valid = true;
+			mglru_markov_app_count++;
+			return app;
+		}
+	}
+	return NULL; /* table full */
+}
+
+static struct mglru_markov_hint *mglru_markov_get_or_create_hint_locked(
+	int app_id, int workload_id)
+{
+	struct mglru_markov_hint *hint;
+	int i;
+
+	lockdep_assert_held(&mglru_workload_markov_lock);
+
+	/* find existing */
+	for (i = 0; i < MGLRU_MARKOV_MAX_HINTS; i++) {
+		if (mglru_markov_hints[i].valid &&
+		    mglru_markov_hints[i].app_id == app_id &&
+		    mglru_markov_hints[i].workload_id == workload_id)
+			return &mglru_markov_hints[i];
+	}
+
+	/* allocate new slot */
+	for (i = 0; i < MGLRU_MARKOV_MAX_HINTS; i++) {
+		if (!mglru_markov_hints[i].valid) {
+			hint = &mglru_markov_hints[i];
+			memset(hint, 0, sizeof(*hint));
+			hint->app_id = app_id;
+			hint->workload_id = workload_id;
+			hint->valid = true;
+			return hint;
+		}
+	}
+	return NULL;
+}
+
+static void mglru_lstm_prepare_reclaim_policy(
+	struct lruvec *lruvec, struct scan_control *sc,
+	struct mglru_lstm_reclaim_policy *policy)
+{
+	struct mem_cgroup *memcg = lruvec_memcg(lruvec);
+	struct mglru_lstm_app_binding *binding;
+	struct mglru_lstm_app_probability *probability;
+	unsigned long now = jiffies;
+	u32 factor;
+
+	memset(policy, 0, sizeof(*policy));
+	policy->valid = true;
+	policy->prepared_at_ns = ktime_get_ns();
+
+	spin_lock(&mglru_workload_markov_lock);
+	mglru_lstm_app_policy_prepare_calls++;
+	policy->mode = mglru_lstm_config.mode;
+	policy->minimum_scan_pages = mglru_lstm_config.minimum_scan_pages;
+	policy->maximum_extra_pages = mglru_lstm_config.maximum_extra_pages;
+
+	if (policy->mode == MGLRU_LSTM_POLICY_DISABLED)
+		mglru_lstm_app_policy_disabled++;
+	else if (policy->mode == MGLRU_LSTM_POLICY_OBSERVE)
+		mglru_lstm_app_policy_observe++;
+	else
+		mglru_lstm_app_policy_apply++;
+
+	if (!memcg || mem_cgroup_is_root(memcg)) {
+		mglru_lstm_target_root_memcg++;
+		policy->bucket = MGLRU_LSTM_BUCKET_UNKNOWN;
+		policy->scan_factor = mglru_lstm_config.unknown_factor;
+		goto done;
+	}
+
+	policy->cgroup_id = cgroup_id(memcg->css.cgroup);
+	mglru_lstm_target_cgroup_seen++;
+	mglru_lstm_target_cgroup_id_last = policy->cgroup_id;
+	binding = mglru_lstm_find_binding_locked(policy->cgroup_id);
+	if (!binding || mglru_lstm_entry_expired(binding->updated_at_jiffies,
+						  binding->ttl_ms, now)) {
+		mglru_lstm_target_app_lookup_miss++;
+		mglru_lstm_target_unbound_memcg++;
+		policy->bucket = MGLRU_LSTM_BUCKET_UNKNOWN;
+		policy->scan_factor = mglru_lstm_config.unknown_factor;
+		goto done;
+	}
+
+	mglru_lstm_target_app_lookup_hit++;
+	policy->app_id = binding->app_id;
+	if (mglru_lstm_foreground.valid &&
+	    !mglru_lstm_entry_expired(mglru_lstm_foreground.updated_at_jiffies,
+				       mglru_lstm_foreground.ttl_ms, now) &&
+	    mglru_lstm_foreground.app_id == policy->app_id) {
+		if (mglru_lstm_foreground.cgroup_id == policy->cgroup_id) {
+			mglru_lstm_target_foreground_match++;
+			policy->is_foreground = true;
+			policy->bucket = MGLRU_LSTM_BUCKET_FOREGROUND;
+			policy->scan_factor = mglru_lstm_config.foreground_factor;
+			goto done;
+		}
+		mglru_lstm_target_foreground_cgroup_mismatch++;
+	}
+
+	probability = mglru_lstm_find_probability_locked(policy->app_id);
+	if (!probability) {
+		mglru_lstm_probability_lookup_miss++;
+		policy->bucket = MGLRU_LSTM_BUCKET_MISSING;
+		policy->probability = mglru_lstm_config.missing_probability;
+		policy->scan_factor =
+			mglru_lstm_factor_for_probability_locked(policy->probability);
+		goto done;
+	}
+	if (mglru_lstm_entry_expired(probability->updated_at_jiffies,
+				     probability->ttl_ms, now)) {
+		mglru_lstm_probability_expired++;
+		policy->prediction_expired = true;
+		policy->bucket = MGLRU_LSTM_BUCKET_EXPIRED;
+		policy->scan_factor = mglru_lstm_config.expired_factor;
+		goto done;
+	}
+
+	mglru_lstm_probability_lookup_hit++;
+	policy->prediction_found = true;
+	policy->probability = probability->probability;
+	policy->bucket =
+		mglru_lstm_bucket_for_probability_locked(policy->probability);
+	policy->scan_factor =
+		mglru_lstm_factor_for_probability_locked(policy->probability);
+done:
+	factor = clamp(policy->scan_factor, mglru_lstm_config.minimum_factor,
+		       mglru_lstm_config.maximum_factor);
+	if (factor != policy->scan_factor)
+		mglru_lstm_scan_factor_clamped++;
+	policy->scan_factor = factor;
+	mglru_lstm_bucket_counts[policy->bucket]++;
+	spin_unlock(&mglru_workload_markov_lock);
+}
+
+static unsigned long mglru_lstm_propose_nr_to_scan(
+	unsigned long original, const struct mglru_lstm_reclaim_policy *policy)
+{
+	u64 proposed64;
+	unsigned long proposed;
+	unsigned long actual;
+	bool extra_capped = false;
+
+	if (!original) {
+		return 0;
+	}
+
+	proposed64 = mul_u64_u32_div(original, policy->scan_factor, 1000);
+	proposed = min_t(u64, proposed64, ULONG_MAX);
+	if (!proposed)
+		proposed = policy->minimum_scan_pages;
+	if (proposed > original &&
+	    proposed - original > policy->maximum_extra_pages) {
+		proposed = original + policy->maximum_extra_pages;
+		if (proposed < original)
+			proposed = ULONG_MAX;
+		extra_capped = true;
+	}
+	actual = policy->mode == MGLRU_LSTM_POLICY_APPLY ? proposed : original;
+	spin_lock(&mglru_workload_markov_lock);
+	mglru_lstm_original_scan_pages += original;
+	mglru_lstm_proposed_scan_pages += proposed;
+	mglru_lstm_applied_scan_pages += actual;
+	if (proposed < original)
+		mglru_lstm_proposed_scan_reduction_pages += original - proposed;
+	else
+		mglru_lstm_proposed_scan_increase_pages += proposed - original;
+	if (extra_capped)
+		mglru_lstm_scan_extra_pages_capped++;
+	spin_unlock(&mglru_workload_markov_lock);
+
+	return actual;
+}
+
+/* --- reclaim-cycle entry point -------------------------------------- */
+
+/*
+ * Called once before evict_folios() starts an isolation/scan batch. This
+ * function NEVER allocates memory, changes a reclaim decision, or alters
+ * folio state. It only does:
+ *   1. Lookup to find the app owning this lruvec's cgroup.
+ *   2. Lookup the Markov transition for (app, prev_wl, cur_wl).
+ *   3. Refresh an observe-only cycle hint if the throttle window elapsed.
+ *   4. Bump statistics counters.
+ */
+static void mglru_markov_apply_generation_adjustment(
+	struct lruvec *lruvec, struct scan_control *sc, const char *caller,
+	int app_id, int prev_workload, int current_workload, int num_predicted)
+{
+	/*
+	 * Future workload -> folio hint -> generation adjustment belongs here.
+	 * This version intentionally does not inspect folios, move generations,
+	 * or change any scan, isolation, aging, or reclaim result.
+	 */
+	pr_debug_ratelimited("lru_gen_workload_markov: caller=%s lruvec=%p sc=%p app=%d pwl=%d cwl=%d hint_pred=%d observe_only=1\n",
+			     caller, lruvec, sc, app_id, prev_workload,
+			     current_workload, num_predicted);
+}
+
+static void mglru_markov_prepare_reclaim(struct lruvec *lruvec,
+					 struct scan_control *sc,
+					 const char *caller)
+{
+	struct mem_cgroup *memcg = lruvec_memcg(lruvec);
+	u64 cg_id;
+	struct mglru_markov_app *app;
+	struct mglru_markov_hint *hint;
+	struct mglru_markov_transition *trans;
+	unsigned long now;
+	int app_id;
+	int prev_workload;
+	int current_workload;
+	int num_predicted;
+	int i;
+
+	if (!READ_ONCE(mglru_markov_app_count))
+		return;
+
+	if (!memcg)
+		return;
+
+	cg_id = cgroup_id(memcg->css.cgroup);
+
+	spin_lock(&mglru_workload_markov_lock);
+
+	mglru_markov_reclaim_calls++;
+	mglru_markov_prepare_calls++;
+
+	/* 1. find the app that owns this cgroup */
+	app = mglru_markov_find_app_by_cgroup_locked(cg_id);
+	if (!app) {
+		mglru_markov_missing_app++;
+		spin_unlock(&mglru_workload_markov_lock);
+		return;
+	}
+
+	{
+		struct mglru_lstm_app_binding *binding;
+		struct mglru_lstm_app_probability *probability;
+
+		binding = mglru_lstm_find_binding_locked(cg_id);
+		if (!binding || binding->app_id != app->app_id) {
+			mglru_lstm_markov_target_app_mismatch++;
+		} else {
+			probability = mglru_lstm_find_probability_locked(app->app_id);
+			if (probability &&
+			    !mglru_lstm_entry_expired(probability->updated_at_jiffies,
+						      probability->ttl_ms, jiffies) &&
+			    probability->probability <
+				mglru_lstm_config.markov_min_probability)
+				mglru_lstm_markov_below_probability_threshold++;
+			else
+				mglru_lstm_markov_allowed_by_probability++;
+		}
+	}
+
+	if (app->current_workload < 0) {
+		mglru_markov_missing_hint++;
+		spin_unlock(&mglru_workload_markov_lock);
+		return;
+	}
+
+	/* Avoid repeating prepare for the same reclaim target in a short window. */
+	now = jiffies;
+	if (app->last_prepare_lruvec == lruvec &&
+	    time_before(now, app->last_prepare_jiffies +
+			      MGLRU_MARKOV_PREPARE_THROTTLE_JIFFIES)) {
+		mglru_markov_throttled++;
+		mglru_markov_throttled_prepare++;
+		spin_unlock(&mglru_workload_markov_lock);
+		return;
+	}
+	app->last_prepare_lruvec = lruvec;
+	app->last_prepare_jiffies = now;
+
+	/* 2. find or pre-create the hint for this app/workload */
+	hint = mglru_markov_get_or_create_hint_locked(app->app_id,
+						      app->current_workload);
+	if (!hint) {
+		mglru_markov_missing_hint++;
+		spin_unlock(&mglru_workload_markov_lock);
+		return;
+	}
+
+	hint->last_predict_jiffies = now;
+	hint->hits++;
+
+	/* 3. look up Markov transition for (app, prev_wl, cur_wl) */
+	trans = NULL;
+	for (i = 0; i < MGLRU_MARKOV_MAX_TRANSITIONS; i++) {
+		if (!mglru_markov_transitions[i].valid)
+			continue;
+		if (mglru_markov_transitions[i].app_id == app->app_id &&
+		    mglru_markov_transitions[i].prev_workload == app->prev_workload &&
+		    mglru_markov_transitions[i].current_workload == app->current_workload) {
+			trans = &mglru_markov_transitions[i];
+			break;
+		}
+	}
+
+	if (trans) {
+		/* refresh hint from transition predictions */
+		mglru_markov_predictions++;
+		hint->num_predicted = min(trans->num_next,
+					  MGLRU_MARKOV_MAX_PREDICTED);
+		for (i = 0; i < hint->num_predicted; i++) {
+			hint->predicted_workload[i] = trans->next[i].next_workload;
+			hint->predicted_confidence[i] = trans->next[i].confidence;
+		}
+	} else {
+		mglru_markov_missing_transition++;
+		hint->num_predicted = 0;
+	}
+
+	app_id = app->app_id;
+	prev_workload = app->prev_workload;
+	current_workload = app->current_workload;
+	num_predicted = hint->num_predicted;
+	spin_unlock(&mglru_workload_markov_lock);
+
+	mglru_markov_apply_generation_adjustment(lruvec, sc, caller, app_id,
+						 prev_workload,
+						 current_workload,
+						 num_predicted);
+}
+
