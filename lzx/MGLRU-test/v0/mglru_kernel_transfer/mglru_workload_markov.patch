+static ssize_t mglru_workload_markov_write(struct file *file,
+					   const char __user *src,
+					   size_t len, loff_t *pos)
+{
+	void *buf;
+	char *cur, *next;
+	int err = 0;
+
+	if (!len)
+		return 0;
+	if (len > SZ_64K)
+		return -E2BIG;
+
+	buf = kvmalloc(len + 1, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	if (copy_from_user(buf, src, len)) {
+		err = -EFAULT;
+		goto done;
+	}
+
+	next = buf;
+	next[len] = '\0';
+
+	while ((cur = strsep(&next, ",;\n"))) {
+		cur = strim(cur);
+		if (!*cur)
+			continue;
+
+		err = mglru_workload_markov_parse_line(cur);
+		if (err)
+			break;
+	}
+done:
+	kvfree(buf);
+
+	return err ?: len;
+}
+
+static const char *mglru_lstm_policy_mode_name(enum mglru_lstm_policy_mode mode)
+{
+	if (mode == MGLRU_LSTM_POLICY_DISABLED)
+		return "disabled";
+	if (mode == MGLRU_LSTM_POLICY_APPLY)
+		return "apply";
+	return "observe";
+}
+
+static unsigned long mglru_lstm_ttl_remaining_ms(unsigned long updated_at,
+						 unsigned long ttl_ms)
+{
+	unsigned long expires = updated_at + msecs_to_jiffies(ttl_ms);
+
+	return time_after(expires, jiffies) ?
+		jiffies_to_msecs(expires - jiffies) : 0;
+}
