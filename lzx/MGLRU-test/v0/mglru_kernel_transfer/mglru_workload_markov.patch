+static int mglru_workload_markov_parse_line(char *line)
+{
+	int argc = 0;
+	char *argv[2 + 3 + MGLRU_MARKOV_MAX_PREDICTED * 3];
+	char *token;
+
+	while ((token = strsep(&line, " \t"))) {
+		if (!*token)
+			continue;
+		if (argc == ARRAY_SIZE(argv))
+			return -E2BIG;
+		argv[argc++] = token;
+	}
+
+	if (!argc)
+		return 0;
+
+	/* "app current <app_id> <cgroup_id> <ttl_ms>" */
+	if (!strcmp(argv[0], "app")) {
+		if (argc < 2)
+			return -EINVAL;
+		if (!strcmp(argv[1], "current"))
+			return mglru_markov_handle_app_current(argc - 2, argv + 2);
+		if (!strcmp(argv[1], "predict"))
+			return mglru_markov_handle_app_predict(argc - 2, argv + 2);
+		if (!strcmp(argv[1], "bind"))
+			return mglru_lstm_handle_app_bind(argc - 2, argv + 2);
+		if (!strcmp(argv[1], "probability"))
+			return mglru_lstm_handle_app_probability(argc - 2, argv + 2);
+		return -EINVAL;
+	}
+
+	if (!strcmp(argv[0], "policy")) {
+		if (argc < 2)
+			return -EINVAL;
+		if (!strcmp(argv[1], "mode"))
+			return mglru_lstm_handle_policy_mode(argc - 2, argv + 2);
+		if (!strcmp(argv[1], "threshold"))
+			return mglru_lstm_handle_policy_threshold(argc - 2, argv + 2);
+		if (!strcmp(argv[1], "factor"))
+			return mglru_lstm_handle_policy_factor(argc - 2, argv + 2);
+		if (!strcmp(argv[1], "bounds"))
+			return mglru_lstm_handle_policy_bounds(argc - 2, argv + 2);
+		if (!strcmp(argv[1], "default"))
+			return mglru_lstm_handle_policy_default(argc - 2, argv + 2);
+		return -EINVAL;
+	}
+
+	/* "workload update <cgroup_id> <app_id> <workload_id>" */
+	if (!strcmp(argv[0], "workload")) {
+		if (argc < 3)
+			return -EINVAL;
+		if (!strcmp(argv[1], "update"))
+			return mglru_markov_handle_workload_update(argc - 2, argv + 2);
+		return -EINVAL;
+	}
+
+	/* "markov set <app_id> <prev_wl> <cur_wl> <next1> <conf1> <boost1> ..." */
+	if (!strcmp(argv[0], "markov")) {
+		if (argc < 2)
+			return -EINVAL;
+		if (!strcmp(argv[1], "set"))
+			return mglru_markov_handle_markov_set(argc - 2, argv + 2);
+		return -EINVAL;
+	}
+
+	/* "clear all|histories|markov|hints" */
+	if (!strcmp(argv[0], "clear")) {
+		if (argc != 2)
+			return -EINVAL;
+		spin_lock(&mglru_workload_markov_lock);
+		if (!strcmp(argv[1], "all"))
+			mglru_markov_clear_all_locked();
+		else if (!strcmp(argv[1], "histories"))
+			mglru_markov_clear_histories_locked();
+		else if (!strcmp(argv[1], "markov"))
+			mglru_markov_clear_markov_locked();
+		else if (!strcmp(argv[1], "hints"))
+			mglru_markov_clear_hints_locked();
+		else {
+			spin_unlock(&mglru_workload_markov_lock);
+			return -EINVAL;
+		}
+		spin_unlock(&mglru_workload_markov_lock);
+		return 0;
+	}
+
+	return -EINVAL;
+}
