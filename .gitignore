# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Independent test module: generated environments, build metadata, and run data
/test/tmp/
/test/*.egg-info/
/test/results/
/test/data/

# Legacy zhj module is intentionally retained; ignore new local run artifacts.
/zhj/tmp/
/zhj/*.egg-info/
/zhj/results/
/zhj/data/

# Generated experiment data can be many gigabytes and may contain host metadata.
/lzx/tool/outputs/

# Locally built helper
lzx/tool/runtime_monitor/tools/parp_memory_ballast
