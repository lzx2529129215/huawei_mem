+static inline bool cache_ext_should_keep(struct folio *folio)
+{
+	return false;
+}
+
+static inline bool cache_ext_can_isolate(struct folio *folio)
+{
+	return true;
+}
+#endif
+
+#endif /* _LINUX_CACHE_EXT_H */
--- /dev/null
+++ b/mm/cache_ext.c
@@ -0,0 +1,540 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Application-directed cache extension prototype.
+ *
+ * Userspace loads Markov transition maps into an eBPF policy and synchronizes
+ * page-cache profile ranges into this kernel hint table. MGLRU calls the BPF
+ * Markov hook once at reclaim-cycle boundaries; folio hot paths only do
+ * file-backed range matching against the current predicted operation.
+ */
+
+#include <linux/atomic.h>
+#include <linux/cache_ext.h>
+#include <linux/compiler.h>
+#include <linux/device.h>
+#include <linux/error-injection.h>
+#include <linux/fs.h>
+#include <linux/kdev_t.h>
+#include <linux/limits.h>
+#include <linux/mm.h>
+#include <linux/pagemap.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#define CACHE_EXT_MAX_PROFILES 8192
+#define CACHE_EXT_WRITE_BUFSZ 160
+
+enum cache_ext_policy_mode {
+	CACHE_EXT_POLICY_BUILTIN = 0,
+	CACHE_EXT_POLICY_BPF = 1,
+};
+
+struct cache_ext_page_profile {
+	u16 app_id;
+	u16 op_id;
+	u32 dev_major;
+	u32 dev_minor;
+	unsigned long ino;
+	unsigned long index_start;
+	unsigned long index_end;
+	u16 priority;
+	bool valid;
+};
+
+struct cache_ext_state {
+	bool enabled;
+	u8 policy_mode;
+	bool bpf_enabled;
+	u16 app_id;
+	u16 predicted_next_op;
+	u64 cycle_seq;
+
+	atomic64_t predicted_updates;
+	atomic64_t cycle_refreshes;
+	atomic64_t active_hint_updates;
+	atomic64_t profile_hits;
+	atomic64_t protected_folios;
+	atomic64_t skipped_reclaim;
+	atomic64_t aging_calls;
+	atomic64_t aging_hits;
+	atomic64_t aging_promoted;
+	atomic64_t bpf_predict_calls;
+	atomic64_t bpf_predict_hits;
+	atomic64_t bpf_predict_miss;
+	atomic64_t bpf_predict_errors;
+};
+
+static struct cache_ext_state cache_ext_state;
+static struct cache_ext_page_profile cache_ext_profiles[CACHE_EXT_MAX_PROFILES];
+static DEFINE_SPINLOCK(cache_ext_lock);
+
+static void cache_ext_clear_stats(void)
+{
+	atomic64_set(&cache_ext_state.predicted_updates, 0);
+	atomic64_set(&cache_ext_state.cycle_refreshes, 0);
+	atomic64_set(&cache_ext_state.active_hint_updates, 0);
+	atomic64_set(&cache_ext_state.profile_hits, 0);
+	atomic64_set(&cache_ext_state.protected_folios, 0);
+	atomic64_set(&cache_ext_state.skipped_reclaim, 0);
+	atomic64_set(&cache_ext_state.aging_calls, 0);
+	atomic64_set(&cache_ext_state.aging_hits, 0);
+	atomic64_set(&cache_ext_state.aging_promoted, 0);
+	atomic64_set(&cache_ext_state.bpf_predict_calls, 0);
+	atomic64_set(&cache_ext_state.bpf_predict_hits, 0);
+	atomic64_set(&cache_ext_state.bpf_predict_miss, 0);
+	atomic64_set(&cache_ext_state.bpf_predict_errors, 0);
+}
+
+static void cache_ext_clear_profiles_locked(void)
+{
+	memset(cache_ext_profiles, 0, sizeof(cache_ext_profiles));
+}
+
+static bool cache_ext_profile_overlaps(const struct cache_ext_page_profile *profile,
+				       unsigned long index_start,
+				       unsigned long index_end)
+{
+	return index_start <= profile->index_end &&
+	       index_end >= profile->index_start;
+}
+
+#ifdef CONFIG_CACHE_EXT_BPF
+__visible noinline int cache_ext_bpf_decide(struct cache_ext_bpf_ctx *ctx)
+{
+	(void)ctx;
+
+	return 0;
+}
+ALLOW_ERROR_INJECTION(cache_ext_bpf_decide, ERRNO);
+
+__visible noinline int cache_ext_bpf_predict(struct cache_ext_bpf_cycle_ctx *ctx)
+{
+	(void)ctx;
+
+	return 0;
+}
+ALLOW_ERROR_INJECTION(cache_ext_bpf_predict, ERRNO);
+#endif
+
+void cache_ext_begin_reclaim_cycle(struct scan_control *sc)
+{
+#ifdef CONFIG_CACHE_EXT_BPF
+	struct cache_ext_bpf_cycle_ctx ctx = {};
+	unsigned long flags;
+	u16 app_id;
+	u64 cycle_seq;
+	int ret;
+
+	if (!READ_ONCE(cache_ext_state.enabled))
+		return;
+	if (READ_ONCE(cache_ext_state.policy_mode) != CACHE_EXT_POLICY_BPF)
+		return;
+	if (!READ_ONCE(cache_ext_state.bpf_enabled))
+		return;
+
+	app_id = READ_ONCE(cache_ext_state.app_id);
+	if (!app_id)
+		return;
+
+	spin_lock_irqsave(&cache_ext_lock, flags);
+	cycle_seq = ++cache_ext_state.cycle_seq;
+	spin_unlock_irqrestore(&cache_ext_lock, flags);
+
+	ctx.app_id = app_id;
+	ctx.cycle_seq = cycle_seq;
+
+	atomic64_inc(&cache_ext_state.cycle_refreshes);
+	atomic64_inc(&cache_ext_state.bpf_predict_calls);
+	ret = cache_ext_bpf_predict(&ctx);
+
+	spin_lock_irqsave(&cache_ext_lock, flags);
+	if (ret > 0 && ret <= USHRT_MAX) {
+		cache_ext_state.predicted_next_op = (u16)ret;
+		atomic64_inc(&cache_ext_state.predicted_updates);
+		atomic64_inc(&cache_ext_state.active_hint_updates);
+		atomic64_inc(&cache_ext_state.bpf_predict_hits);
+	} else {
+		cache_ext_state.predicted_next_op = 0;
+		if (ret < 0)
+			atomic64_inc(&cache_ext_state.bpf_predict_errors);
+		else
+			atomic64_inc(&cache_ext_state.bpf_predict_miss);
+	}
+	spin_unlock_irqrestore(&cache_ext_lock, flags);
+#endif
+}
+
+static bool cache_ext_match_folio(struct folio *folio, bool count_protect)
+{
+	struct address_space *mapping;
+	struct inode *inode;
+	dev_t dev;
+	unsigned long index_start;
+	unsigned long index_end;
+	unsigned long nr_pages;
+	unsigned long flags;
+	u16 app_id;
+	u16 op_id;
+	u32 dev_major;
+	u32 dev_minor;
+	unsigned long ino;
+	int i;
+	bool matched = false;
+
+	if (!READ_ONCE(cache_ext_state.enabled))
+		return false;
+	if (!READ_ONCE(cache_ext_state.predicted_next_op))
+		return false;
+	if (folio_test_swapbacked(folio))
+		return false;
+
+	mapping = folio_mapping(folio);
+	if (!mapping || !mapping->host)
+		return false;
+
+	inode = mapping->host;
+	if (!inode->i_sb)
+		return false;
+	dev = inode->i_sb->s_dev;
+	dev_major = MAJOR(dev);
+	dev_minor = MINOR(dev);
+	ino = inode->i_ino;
+	index_start = folio->index;
+	nr_pages = folio_nr_pages(folio);
+	if (!nr_pages)
+		return false;
+	index_end = index_start + nr_pages - 1;
+	if (index_end < index_start)
+		index_end = ULONG_MAX;
+
+	spin_lock_irqsave(&cache_ext_lock, flags);
+
+	if (!cache_ext_state.enabled || !cache_ext_state.predicted_next_op)
+		goto unlock;
+
+	app_id = cache_ext_state.app_id;
+	op_id = cache_ext_state.predicted_next_op;
+
+	for (i = 0; i < CACHE_EXT_MAX_PROFILES; i++) {
+		struct cache_ext_page_profile *profile = &cache_ext_profiles[i];
+
+		if (!profile->valid)
+			continue;
+		if (profile->app_id != app_id || profile->op_id != op_id)
+			continue;
+		if (profile->dev_major != dev_major ||
+		    profile->dev_minor != dev_minor)
+			continue;
+		if (profile->ino != ino)
+			continue;
+		if (!cache_ext_profile_overlaps(profile, index_start, index_end))
+			continue;
+
+		matched = true;
+		break;
+	}
+
+unlock:
+	spin_unlock_irqrestore(&cache_ext_lock, flags);
+
+	if (matched && count_protect) {
+		atomic64_inc(&cache_ext_state.profile_hits);
+		atomic64_inc(&cache_ext_state.protected_folios);
+	}
+
+	return matched;
+}
+
+bool cache_ext_should_keep(struct folio *folio)
+{
+	return cache_ext_match_folio(folio, true);
+}
+
+bool cache_ext_aging_should_promote(struct folio *folio)
+{
+	bool matched;
+
+	atomic64_inc(&cache_ext_state.aging_calls);
+
+	matched = cache_ext_match_folio(folio, true);
+	if (matched)
+		atomic64_inc(&cache_ext_state.aging_hits);
+
+	return matched;
+}
+
+void cache_ext_note_aging_promoted(void)
+{
+	atomic64_inc(&cache_ext_state.aging_promoted);
+}
+
+bool cache_ext_can_isolate(struct folio *folio)
+{
+	if (cache_ext_match_folio(folio, true)) {
+		atomic64_inc(&cache_ext_state.skipped_reclaim);
+		return false;
+	}
+
+	return true;
+}
+
+static int cache_ext_add_profile(u16 app_id, u16 op_id, u32 dev_major,
+				 u32 dev_minor, unsigned long ino,
+				 unsigned long index_start,
+				 unsigned long index_end, u16 priority)
+{
+	unsigned long flags;
+	int i;
+	int ret = -ENOSPC;
+
+	if (index_start > index_end)
+		return -EINVAL;
+
+	spin_lock_irqsave(&cache_ext_lock, flags);
+
+	for (i = 0; i < CACHE_EXT_MAX_PROFILES; i++) {
+		struct cache_ext_page_profile *profile = &cache_ext_profiles[i];
+
+		if (profile->valid)
+			continue;
+
+		profile->app_id = app_id;
+		profile->op_id = op_id;
+		profile->dev_major = dev_major;
+		profile->dev_minor = dev_minor;
+		profile->ino = ino;
+		profile->index_start = index_start;
+		profile->index_end = index_end;
+		profile->priority = priority;
+		profile->valid = true;
+		ret = 0;
+		break;
+	}
+
+	spin_unlock_irqrestore(&cache_ext_lock, flags);
+
+	return ret;
+}
+
+static ssize_t cache_ext_write(struct file *file, const char __user *ubuf,
+			       size_t len, loff_t *ppos)
+{
+	char buf[CACHE_EXT_WRITE_BUFSZ];
+	char *cmd;
+	unsigned long flags;
+	int enable;
+	int bpf_enable;
+	u16 app;
+	u16 op;
+	u32 dev_major;
+	u32 dev_minor;
+	unsigned long ino;
+	unsigned long index_start;
+	unsigned long index_end;
+	u16 priority;
+	int ret;
+
+	if (!len)
+		return 0;
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+	cmd = strim(buf);
+
+	if (sscanf(cmd, "enable %d", &enable) == 1) {
+		if (enable != 0 && enable != 1)
+			return -EINVAL;
+
+		spin_lock_irqsave(&cache_ext_lock, flags);
+		cache_ext_state.enabled = !!enable;
+		spin_unlock_irqrestore(&cache_ext_lock, flags);
+		return len;
+	}
+
+	if (sscanf(cmd, "app %hu", &app) == 1) {
+		spin_lock_irqsave(&cache_ext_lock, flags);
+		cache_ext_state.app_id = app;
+		spin_unlock_irqrestore(&cache_ext_lock, flags);
+		return len;
+	}
+
+	if (!strcmp(cmd, "policy builtin")) {
+		spin_lock_irqsave(&cache_ext_lock, flags);
+		cache_ext_state.policy_mode = CACHE_EXT_POLICY_BUILTIN;
+		spin_unlock_irqrestore(&cache_ext_lock, flags);
+		return len;
+	}
+
+	if (!strcmp(cmd, "policy bpf")) {
+#ifdef CONFIG_CACHE_EXT_BPF
+		spin_lock_irqsave(&cache_ext_lock, flags);
+		cache_ext_state.policy_mode = CACHE_EXT_POLICY_BPF;
+		spin_unlock_irqrestore(&cache_ext_lock, flags);
+		return len;
+#else
+		return -EOPNOTSUPP;
+#endif
+	}
+
+	if (sscanf(cmd, "bpf enable %d", &bpf_enable) == 1) {
+		if (bpf_enable != 0 && bpf_enable != 1)
+			return -EINVAL;
+#ifdef CONFIG_CACHE_EXT_BPF
+		spin_lock_irqsave(&cache_ext_lock, flags);
+		cache_ext_state.bpf_enabled = !!bpf_enable;
+		spin_unlock_irqrestore(&cache_ext_lock, flags);
+		return len;
+#else
+		return -EOPNOTSUPP;
+#endif
+	}
+
+	if (sscanf(cmd, "predicted_op %hu %hu", &app, &op) == 2) {
+		spin_lock_irqsave(&cache_ext_lock, flags);
+		cache_ext_state.app_id = app;
+		cache_ext_state.predicted_next_op = op;
+		spin_unlock_irqrestore(&cache_ext_lock, flags);
+		atomic64_inc(&cache_ext_state.predicted_updates);
+		atomic64_inc(&cache_ext_state.active_hint_updates);
+		return len;
+	}
+
+	if (sscanf(cmd, "profile add %hu %hu %u %u %lu %lu %lu %hu",
+		   &app, &op, &dev_major, &dev_minor, &ino, &index_start,
+		   &index_end, &priority) == 8) {
+		ret = cache_ext_add_profile(app, op, dev_major, dev_minor, ino,
+					    index_start, index_end, priority);
+		if (ret)
+			return ret;
+		return len;
+	}
+
+	if (!strcmp(cmd, "profile clear")) {
+		spin_lock_irqsave(&cache_ext_lock, flags);
+		cache_ext_clear_profiles_locked();
+		spin_unlock_irqrestore(&cache_ext_lock, flags);
+		return len;
+	}
+
+	if (!strcmp(cmd, "clear")) {
+		spin_lock_irqsave(&cache_ext_lock, flags);
+		cache_ext_state.app_id = 0;
+		cache_ext_state.predicted_next_op = 0;
+		cache_ext_state.cycle_seq = 0;
+		cache_ext_state.policy_mode = CACHE_EXT_POLICY_BUILTIN;
+		cache_ext_state.bpf_enabled = false;
+		spin_unlock_irqrestore(&cache_ext_lock, flags);
+		cache_ext_clear_stats();
+		return len;
+	}
+
+	return -EINVAL;
+}
+
+static int cache_ext_show(struct seq_file *m, void *v)
+{
+	struct cache_ext_page_profile *profiles;
+	unsigned long flags;
+	bool enabled;
+	u8 policy_mode;
+	bool bpf_enabled;
+	u16 app_id;
+	u16 predicted_next_op;
+	u64 cycle_seq;
+	int i;
+
+	profiles = kcalloc(CACHE_EXT_MAX_PROFILES, sizeof(*profiles),
+			   GFP_KERNEL);
+	if (!profiles)
+		return -ENOMEM;
+
+	spin_lock_irqsave(&cache_ext_lock, flags);
+	enabled = cache_ext_state.enabled;
+	policy_mode = cache_ext_state.policy_mode;
+	bpf_enabled = cache_ext_state.bpf_enabled;
+	app_id = cache_ext_state.app_id;
+	predicted_next_op = cache_ext_state.predicted_next_op;
+	cycle_seq = cache_ext_state.cycle_seq;
+	memcpy(profiles, cache_ext_profiles, sizeof(cache_ext_profiles));
+	spin_unlock_irqrestore(&cache_ext_lock, flags);
+
+	seq_printf(m, "cache_ext enabled: %u\n", enabled ? 1 : 0);
+	seq_printf(m, "app_id: %u\n", app_id);
+	seq_printf(m, "policy_mode: %s\n",
+		   policy_mode == CACHE_EXT_POLICY_BPF ? "bpf" : "builtin");
+#ifdef CONFIG_CACHE_EXT_BPF
+	seq_puts(m, "bpf_supported: 1\n");
+	seq_printf(m, "bpf_enabled: %u\n", bpf_enabled ? 1 : 0);
+#else
+	seq_puts(m, "bpf_supported: 0\n");
+	seq_puts(m, "bpf_enabled: 0\n");
+#endif
+	seq_printf(m, "cycle_seq: %llu\n", (unsigned long long)cycle_seq);
+	seq_printf(m, "current_predicted_next_op: %u\n\n", predicted_next_op);
+
+	seq_puts(m, "profiles:\n");
+	for (i = 0; i < CACHE_EXT_MAX_PROFILES; i++) {
+		struct cache_ext_page_profile *profile = &profiles[i];
+
+		if (!profile->valid)
+			continue;
+
+		seq_printf(m,
+			   "[%d] app=%u op=%u dev=%u:%u ino=%lu index=%lu-%lu priority=%u\n",
+			   i, profile->app_id, profile->op_id,
+			   profile->dev_major, profile->dev_minor, profile->ino,
+			   profile->index_start, profile->index_end,
+			   profile->priority);
+	}
+
+	seq_puts(m, "\nstats:\n");
+	seq_printf(m, "predicted_updates: %lld\n",
+		   atomic64_read(&cache_ext_state.predicted_updates));
+	seq_printf(m, "cycle_refreshes: %lld\n",
+		   atomic64_read(&cache_ext_state.cycle_refreshes));
+	seq_printf(m, "active_hint_updates: %lld\n",
+		   atomic64_read(&cache_ext_state.active_hint_updates));
+	seq_printf(m, "profile_hits: %lld\n",
+		   atomic64_read(&cache_ext_state.profile_hits));
+	seq_printf(m, "protected_folios: %lld\n",
+		   atomic64_read(&cache_ext_state.protected_folios));
+	seq_printf(m, "skipped_reclaim: %lld\n",
+		   atomic64_read(&cache_ext_state.skipped_reclaim));
+	seq_printf(m, "aging_calls: %lld\n",
+		   atomic64_read(&cache_ext_state.aging_calls));
+	seq_printf(m, "aging_hits: %lld\n",
+		   atomic64_read(&cache_ext_state.aging_hits));
+	seq_printf(m, "aging_promoted: %lld\n",
+		   atomic64_read(&cache_ext_state.aging_promoted));
+#ifdef CONFIG_CACHE_EXT_BPF
+	seq_puts(m, "\nbpf:\n");
+	seq_printf(m, "bpf_predict_calls: %lld\n",
+		   atomic64_read(&cache_ext_state.bpf_predict_calls));
+	seq_printf(m, "bpf_predict_hits: %lld\n",
+		   atomic64_read(&cache_ext_state.bpf_predict_hits));
+	seq_printf(m, "bpf_predict_miss: %lld\n",
+		   atomic64_read(&cache_ext_state.bpf_predict_miss));
+	seq_printf(m, "bpf_predict_errors: %lld\n",
+		   atomic64_read(&cache_ext_state.bpf_predict_errors));
+#endif
+
+	kfree(profiles);
+	return 0;
+}
+
+static int cache_ext_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, cache_ext_show, NULL);
+}
+
+const struct file_operations cache_ext_fops = {
+	.open = cache_ext_open,
+	.read = seq_read,
+	.write = cache_ext_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -1,7 +1,28 @@
 # SPDX-License-Identifier: GPL-2.0-only
 
 menu "Memory Management options"
 
+config CACHE_EXT
+	bool "Application-directed cache extension prototype"
+	depends on DEBUG_FS
+	default y
+	help
+	  A prototype cache extension layer that protects selected file-backed
+	  page cache folios from reclaim according to application-level
+	  prediction.
+
+config CACHE_EXT_BPF
+	bool "BPF policy support for cache_ext"
+	depends on CACHE_EXT
+	depends on BPF
+	depends on BPF_SYSCALL
+	depends on DEBUG_INFO_BTF
+	default n
+	help
+	  Enable experimental BPF policy support for cache_ext. This allows an
+	  eBPF policy to participate in cache_ext reclaim decisions through a
+	  small folio context.
+
 #
 # For some reason microblaze and nios2 hard code SWAP=n.  Hopefully we can
 # add proper SWAP support to them, in which case this can be remove.
--- a/mm/Makefile
+++ b/mm/Makefile
@@ -52,8 +52,10 @@ obj-y			:= filemap.o mempool.o oom_kill.o fadvise.o \
 			   mm_init.o percpu.o slab_common.o \
 			   compaction.o show_mem.o \
 			   interval_tree.o list_lru.o workingset.o \
 			   debug.o gup.o mmap_lock.o vma_init.o $(mmu-y)
 
+obj-$(CONFIG_CACHE_EXT) += cache_ext.o
+
 # Give 'page_alloc' its own module-parameter namespace
 page-alloc-y := page_alloc.o
 page-alloc-$(CONFIG_SHUFFLE_PAGE_ALLOCATOR) += shuffle.o
